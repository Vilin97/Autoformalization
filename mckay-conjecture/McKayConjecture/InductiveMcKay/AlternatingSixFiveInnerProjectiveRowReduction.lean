import McKayConjecture.GroupTheory.AlternatingSixUniversalCoverFiveNormalizerCenterGeneration
import McKayConjecture.InductiveMcKay.AlternatingSixFiveActualCentralValueMatching
import McKayConjecture.InductiveMcKay.ExactNormalizerInnerProjectiveRow

/-!
# Inner-inertia projective rows for the five-local `A₆` table

For the existing central-block five-local matching, the ambient and local
characters already have equal normalized values at the distinguished
central generator.  The exact normalizer's center is generated by that
element.  Consequently every row whose character inertia is induced by the
exact normalizer has complete projective compatibility.

This reduction is conditional on the existing ordinary equivariance
predicate and on normalizer-to-inertia surjectivity for the selected row.
It does not assert that the engineered central-block ordering is CTblLib's
actual display order.
-/

noncomputable section

namespace McKayConjecture
namespace InductiveMcKay

open GroupTheory

local instance alternatingSixFiveInnerProjectiveRowReductionFactPrime :
    Fact (Nat.Prime 5) :=
  ⟨Nat.prime_five⟩

/-- At five, ordinary equivariance plus inner character inertia is enough
for the complete projective comparison row: the previously proved
central-generator cross identity supplies all central scalars. -/
def alternatingSixFiveInnerProjectiveRowData
    (T : AlternatingSixAmbientOrdinaryCharacterTableCertificate)
    (h : AlternatingSixFiveCentralBlockRowMatchingEquivariant T)
    (r : AlternatingSixAmbientPPrimeRowIndex 5)
    (hSurjective :
      Function.Surjective
        (normalizerInnerCharacterStabilizerHom
          (alternatingSixUniversalCoverSylow 5)
          (alternatingSixAmbientPPrimeCharacterEquiv T 5 r))) :
    ExactNormalizerProjectiveRowData
      (alternatingSixFiveCentralBlockConcreteCharacterTableCertificate
        T h).toEquivariantMcKayEquiv
      (alternatingSixAmbientPPrimeCharacterEquiv T 5 r) := by
  let d :=
    alternatingSixFiveCentralBlockConcreteCharacterTableCertificate T h
  let e := d.toEquivariantMcKayEquiv
  let χ := alternatingSixAmbientPPrimeCharacterEquiv T 5 r
  have hcentral :
      alternatingSixUniversalCoverCentralGenerator =
        alternatingSixAmbientCanonicalCentralGenerator := by
    rw [alternatingSixAmbientCanonicalCentralGenerator,
      alternatingSixAmbientCanonicalGeneratorA, ← map_pow,
      alternatingSixSchurPresentedA_sq]
    rfl
  have hlocal :
      e χ =
        alternatingSixFiveActualNormalizerPPrimeCharacterEquiv
          (alternatingSixAmbientFivePPrimeCentralBlockRowEquiv r) := by
    change
      d.toEquivariantMcKayEquiv (d.ambientEnumeration r) =
        alternatingSixFiveActualNormalizerPPrimeCharacterEquiv
          (d.indexEquiv r)
    exact d.toEquivariantMcKayEquiv_apply_enumerated r
  apply
    ExactNormalizerProjectiveRowData.ofInnerNormalizerSurjectiveGeneratorCross
      e χ hSurjective
      alternatingSixFiveActualNormalizerCentralGenerator
      alternatingSixFiveActualNormalizerCentralGenerator_mem_center
      alternatingSixUniversalCoverCentralGenerator_mem_center
      alternatingSixFiveActualNormalizer_center_le_ambientCenter
      alternatingSixFiveActualNormalizer_center_generated
  rw [hlocal]
  change
    (alternatingSixAmbientPPrimeCharacterEquiv T 5 r).1.values
          alternatingSixUniversalCoverCentralGenerator *
        ((alternatingSixFiveActualNormalizerPPrimeCharacterEquiv
              (alternatingSixAmbientFivePPrimeCentralBlockRowEquiv r)).1.degree :
          ℂ) =
      (alternatingSixFiveActualNormalizerPPrimeCharacterEquiv
            (alternatingSixAmbientFivePPrimeCentralBlockRowEquiv r)).1.values
          alternatingSixFiveActualNormalizerCentralGenerator *
        ((alternatingSixAmbientPPrimeCharacterEquiv T 5 r).1.degree : ℂ)
  rw [hcentral]
  exact
    alternatingSixFiveCentralBlockRowMatching_actualCentralCross T r

end InductiveMcKay
end McKayConjecture
