import McKayConjecture.GroupTheory.LayerIntermediateStructure
import McKayConjecture.GroupTheory.LayerCentralizer
import McKayConjecture.GroupTheory.LayerLocalNormalizerContainment
import McKayConjecture.InductiveMcKay.ComponentOrbitLocalData
import McKayConjecture.InductiveMcKay.MinimalCounterexampleStructure

/-!
# The layer intermediate in the minimal-counterexample reduction

Coherent component-orbit data supplies the exact family of component-local
subgroups needed in the Frattini layer step.  This file assembles the
group-theoretic consequences:

* the coordinate normalizers contain the internal normalizer of the chosen
  Sylow subgroup of the layer;
* the component-local subgroup is normal in the intermediate obtained by
  adjoining the ambient layer-Sylow normalizer;
* the intermediate has smaller central index whenever the layer Sylow is
  noncentral; and
* for the canonical intersection `Q = P ∩ E(G)`, the original Sylow
  normalizer lies in that intermediate.

No character correspondence or reduction theorem is assumed here.
-/

noncomputable section

namespace McKayConjecture
namespace InductiveMcKay

open GroupTheory

variable {G : Type} [Group G] [Finite G]
variable {p : ℕ} [Fact p.Prime]
variable {Q : Sylow p (layer G)}
variable {D : LayerSylowCoordinateData G p Q}

namespace ComponentOrbitLocalData

/-- Forget only the cross-component coherence and retain the componentwise
local data used by the layer character correspondence. -/
def toLayerComponentLocalData
    (d : ComponentOrbitLocalData D) :
    LayerComponentLocalData D where
  data := d.data

@[simp]
theorem toLayerComponentLocalData_data
    (d : ComponentOrbitLocalData D)
    (K : ComponentIndex G) :
    (d.toLayerComponentLocalData.data K) =
      d.data K :=
  rfl

@[simp]
theorem toLayerComponentLocalData_intermediate
    (d : ComponentOrbitLocalData D)
    (K : ComponentIndex G) :
    d.toLayerComponentLocalData.intermediate K =
      d.intermediate K :=
  rfl

@[simp]
theorem toLayerComponentLocalData_correspondence
    (d : ComponentOrbitLocalData D)
    (K : ComponentIndex G) :
    d.toLayerComponentLocalData.correspondence K =
      d.correspondence K :=
  rfl

/-- The ambient component-local subgroup generated by the coherent
coordinate intermediates. -/
abbrev ambientComponentLocal
    (d : ComponentOrbitLocalData D) :
    Subgroup G :=
  componentLocalSubgroup G d.intermediate

/-- The layer intermediate attached to coherent component-orbit data. -/
abbrev ambientIntermediate
    (d : ComponentOrbitLocalData D) :
    Subgroup G :=
  layerIntermediate G Q d.intermediate

/-- The component-local subgroup, viewed internally as a subgroup of the
layer intermediate. -/
abbrev intermediateComponentLocal
    (d : ComponentOrbitLocalData D) :
    Subgroup d.ambientIntermediate :=
  d.ambientComponentLocal.subgroupOf d.ambientIntermediate

/-- The internal layer Sylow normalizer lies in the assembled
component-local subgroup. -/
theorem layer_normalizer_le_componentLocalInLayer
    (d : ComponentOrbitLocalData D) :
    Subgroup.normalizer (Q : Set (layer G)) ≤
      componentLocalSubgroupInLayer G d.intermediate :=
  D.normalizer_le_componentLocalSubgroupInLayer
    d.intermediate d.normalizer_le_intermediate

/-- The internal component-local subgroup is normal in the layer
intermediate. -/
theorem intermediateComponentLocal_normal
    (d : ComponentOrbitLocalData D) :
    d.intermediateComponentLocal.Normal :=
  componentLocalSubgroup_normal_in_layerIntermediate
    G Q d.intermediate d.isConjugationEquivariantUnder

/-- Install the proved normality when using Clifford theory inside the layer
intermediate. -/
instance intermediateComponentLocalNormal
    (d : ComponentOrbitLocalData D) :
    d.intermediateComponentLocal.Normal :=
  d.intermediateComponentLocal_normal

/-- The internal normal subgroup is canonically isomorphic to the ambient
component-local subgroup. -/
def intermediateComponentLocalEquivAmbient
    (d : ComponentOrbitLocalData D) :
    d.intermediateComponentLocal ≃*
      d.ambientComponentLocal :=
  layerIntermediateComponentLocalEquiv
    G Q d.intermediate

/-- The internal normal subgroup is canonically isomorphic to the copy of
the component-local subgroup inside the layer. -/
def intermediateComponentLocalEquivInLayer
    (d : ComponentOrbitLocalData D) :
    d.intermediateComponentLocal ≃*
      componentLocalSubgroupInLayer
        G d.intermediate :=
  layerIntermediateComponentLocalEquivInLayer
    G Q d.intermediate

/-- The layer and the layer intermediate generate the ambient group. -/
theorem layer_sup_ambientIntermediate_eq_top
    (d : ComponentOrbitLocalData D) :
    layer G ⊔ d.ambientIntermediate = ⊤ :=
  layer_sup_layerIntermediate_eq_top
    G Q d.intermediate

/-- The layer meets its intermediate in exactly the assembled
component-local subgroup. -/
theorem layer_inf_ambientIntermediate_eq_ambientComponentLocal
    (d : ComponentOrbitLocalData D) :
    layer G ⊓ d.ambientIntermediate =
      d.ambientComponentLocal := by
  change
    layer G ⊓
        (componentLocalSubgroup G d.intermediate ⊔
          LayerSylowAmbientNormalizer G Q) =
      componentLocalSubgroup G d.intermediate
  apply
    inf_sup_eq_of_le_normalizer_of_inf_le
      (layer G)
      (componentLocalSubgroup G d.intermediate)
      (LayerSylowAmbientNormalizer G Q)
      (componentLocalSubgroup_le_layer G d.intermediate)
      (layerSylowAmbientNormalizer_le_normalizer_componentLocal
        G d.intermediate Q
        d.isConjugationEquivariantUnder)
  simpa only [LayerSylowAmbientNormalizer,
    map_componentLocalSubgroupInLayer] using
      (Sylow.inf_ambientNormalizer_le_map_of_internalNormalizer_le
        (layer G) Q
        (componentLocalSubgroupInLayer G d.intermediate)
        d.layer_normalizer_le_componentLocalInLayer)

/-- One proper coordinate makes the layer intermediate proper. -/
theorem ambientIntermediate_lt_top
    (d : ComponentOrbitLocalData D)
    (hproper :
      ∃ K : ComponentIndex G,
        d.intermediate K < ⊤) :
    d.ambientIntermediate < ⊤ :=
  componentLocal_sup_ambientNormalizer_lt_top_of_normalizerInvariant
    G d.intermediate Q
      d.isConjugationEquivariantUnder
      d.center_le_intermediate
      hproper
      d.layer_normalizer_le_componentLocalInLayer

/-- One proper coordinate gives strict central-index descent. -/
theorem centralIndex_ambientIntermediate_lt
    (d : ComponentOrbitLocalData D)
    (hproper :
      ∃ K : ComponentIndex G,
        d.intermediate K < ⊤) :
    centralIndex d.ambientIntermediate <
      centralIndex G :=
  centralIndex_componentLocal_sup_ambientNormalizer_lt_of_normalizerInvariant'
    G d.intermediate Q
      d.isConjugationEquivariantUnder
      d.center_le_intermediate
      hproper
      d.layer_normalizer_le_componentLocalInLayer

/-- Ambient noncentrality of the layer Sylow supplies central-index descent
under the standard center-image hypothesis. -/
theorem centralIndex_ambientIntermediate_lt_of_map_not_le_center
    (d : ComponentOrbitLocalData D)
    (hcenterImage :
      (Subgroup.center (layer G)).map
          (layer G).subtype ≤
        Subgroup.center G)
    (hQambient :
      ¬(Q : Subgroup (layer G)).map
          (layer G).subtype ≤
        Subgroup.center G) :
    centralIndex d.ambientIntermediate <
      centralIndex G :=
  d.centralIndex_ambientIntermediate_lt
    (d.exists_intermediate_lt_top_of_map_not_le_center
      hcenterImage hQambient)

end ComponentOrbitLocalData

section CanonicalIntersection

variable {P : Sylow p G}
variable
  {D :
    LayerSylowCoordinateData G p
      (layerSylowIntersection P)}

namespace ComponentOrbitLocalData

/-- The original Sylow normalizer lies in the layer intermediate built from
the canonical intersection with the layer. -/
theorem sylowNormalizer_le_ambientIntermediate
    (d : ComponentOrbitLocalData D) :
    Subgroup.normalizer (P : Set G) ≤
      d.ambientIntermediate := by
  simpa only [layerSylowIntersection] using
    (normalizer_le_layerIntermediate_intersectionNormal
      G P d.intermediate)

/-- In a minimal counterexample, the centralizer of the layer lies in the
layer intermediate.  This is the centralizer containment required for the
matched inertia-triple restriction witness. -/
theorem centralizer_layer_le_ambientIntermediate
    (d : ComponentOrbitLocalData D)
    (h : MinimalCounterexampleStructure P) :
    Subgroup.centralizer (layer G : Set G) ≤
      d.ambientIntermediate :=
  centralizer_layer_le_layerIntermediate_of_fittingSubgroup_eq_center
    (layerSylowIntersection P) d.intermediate
    h.fittingSubgroup_eq_center

/-- The structural conclusions of a Rossi minimal counterexample make the
layer intermediate strictly smaller in central index. -/
theorem centralIndex_ambientIntermediate_lt_of_minimalCounterexample
    (d : ComponentOrbitLocalData D)
    (h : MinimalCounterexampleStructure P) :
    centralIndex d.ambientIntermediate <
      centralIndex G :=
  d.centralIndex_ambientIntermediate_lt_of_map_not_le_center
    h.map_center_layer_le_center
    h.not_layerSylowIntersection_le_center

/-- In particular, the layer intermediate is proper in a Rossi minimal
counterexample. -/
theorem ambientIntermediate_lt_top_of_minimalCounterexample
    (d : ComponentOrbitLocalData D)
    (h : MinimalCounterexampleStructure P) :
    d.ambientIntermediate < ⊤ :=
  d.ambientIntermediate_lt_top
    (d.exists_intermediate_lt_top_of_map_not_le_center
      h.map_center_layer_le_center
      h.not_layerSylowIntersection_le_center)

end ComponentOrbitLocalData

end CanonicalIntersection

end InductiveMcKay
end McKayConjecture
