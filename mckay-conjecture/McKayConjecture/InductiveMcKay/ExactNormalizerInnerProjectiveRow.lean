import McKayConjecture.InductiveMcKay.ExactNormalizerInnerProjectiveCompatibility
import McKayConjecture.InductiveMcKay.HonestExtensionProjectiveCompatibility
import McKayConjecture.InductiveMcKay.InnerCharacterStabilizer
import McKayConjecture.Character.CentralUnit

/-!
# Exact-normalizer projective rows with inner character inertia

If the exact Sylow normalizer surjects onto a character inertia group by
conjugation, a normalized set-theoretic section supplies the implementers
needed by the common-inner-lift construction.  This file packages that
choice once and turns matching central scalar actions directly into an
`ExactNormalizerProjectiveRowData`.

The resulting constructor leaves two concrete obligations for a row:

* prove that every stabilizing automorphism is induced by the exact
  normalizer; and
* identify the common scalar by which ambient and local central elements
  act.
-/

noncomputable section

universe u

namespace McKayConjecture
namespace InductiveMcKay

open CharacterTriple

variable {G : Type u} [Group G] [Finite G]
variable {p : ℕ} {P : Sylow p G}

/-- A normalized set-theoretic section of the normalizer map onto an inner
character stabilizer. -/
def normalizedNormalizerInnerLiftOfSurjective
    (P : Sylow p G)
    (χ : PPrimeIrreducibleCharacter G p)
    (hSurjective :
      Function.Surjective
        (normalizerInnerCharacterStabilizerHom P χ))
    (a : PPrimeCharacterStabilizer P χ) :
    SylowNormalizer P := by
  classical
  exact
    if ha : a = 1 then
      1
    else
      Classical.choose (hSurjective a)

@[simp]
theorem normalizedNormalizerInnerLiftOfSurjective_one
    (P : Sylow p G)
    (χ : PPrimeIrreducibleCharacter G p)
    (hSurjective :
      Function.Surjective
        (normalizerInnerCharacterStabilizerHom P χ)) :
    normalizedNormalizerInnerLiftOfSurjective
        P χ hSurjective 1 = 1 := by
  simp [normalizedNormalizerInnerLiftOfSurjective]

/-- The normalized section implements each stabilizing automorphism by
ambient conjugation. -/
theorem normalizedNormalizerInnerLiftOfSurjective_spec
    (P : Sylow p G)
    (χ : PPrimeIrreducibleCharacter G p)
    (hSurjective :
      Function.Surjective
        (normalizerInnerCharacterStabilizerHom P χ))
    (a : PPrimeCharacterStabilizer P χ) :
    PPrimeCharacterStabilizer.ambientAction a =
      MulAut.conj
        (normalizedNormalizerInnerLiftOfSurjective
          P χ hSurjective a).1 := by
  by_cases ha : a = 1
  · subst a
    simp
  · change
      a.1.1 =
        MulAut.conj
          (normalizedNormalizerInnerLiftOfSurjective
            P χ hSurjective a).1
    rw [normalizedNormalizerInnerLiftOfSurjective, dif_neg ha]
    exact
      (congrArg
        (fun b : PPrimeCharacterStabilizer P χ ↦ b.1.1)
        (Classical.choose_spec (hSurjective a))).symm

namespace ExactNormalizerProjectiveRowData

variable {X : Type} [Group X] [Finite X]
variable {q : ℕ} {Q : Sylow q X}

/-- Surjectivity of the exact-normalizer inner map and matching central
scalar actions produce the complete projective datum for one row. -/
def ofInnerNormalizerSurjective
    (e : EquivariantMcKayEquiv Q)
    (χ : PPrimeIrreducibleCharacter X q)
    (hSurjective :
      Function.Surjective
        (normalizerInnerCharacterStabilizerHom Q χ))
    (centralUnit : X → ℂˣ)
    (ambient_central_action :
      ∀ z : X, z ∈ Subgroup.center X →
        AssociatedExistence.realizationAction χ.1 z =
          scalarLinearEquiv ℂ χ.1.realization
            (centralUnit z))
    (local_central_action :
      ∀ z : SylowNormalizer Q,
        z ∈ Subgroup.center (SylowNormalizer Q) →
          AssociatedExistence.realizationAction (e χ).1 z =
            scalarLinearEquiv ℂ (e χ).1.realization
              (centralUnit z.1)) :
    ExactNormalizerProjectiveRowData e χ :=
  ofTripleCompatible e χ (by
    apply e.tripleCompatible_of_innerNormalizerLift χ
      (normalizedNormalizerInnerLiftOfSurjective
        Q χ hSurjective)
      (normalizedNormalizerInnerLiftOfSurjective_one
        Q χ hSurjective)
      (normalizedNormalizerInnerLiftOfSurjective_spec
        Q χ hSurjective)
      centralUnit
    · exact ambient_central_action
    · exact local_central_action)

/-- If the local center is generated by one element which is also ambient
central, then a single cross-multiplied character-value identity supplies
all central scalar comparisons required by
`ofInnerNormalizerSurjective`.

Natural powers suffice here because the intended exact normalizers are
finite; callers may package their cyclic-center calculation in the
`localCenter_generated` premise. -/
def ofInnerNormalizerSurjectiveGeneratorCross
    (e : EquivariantMcKayEquiv Q)
    (χ : PPrimeIrreducibleCharacter X q)
    (hSurjective :
      Function.Surjective
        (normalizerInnerCharacterStabilizerHom Q χ))
    (generator : SylowNormalizer Q)
    (generator_mem_localCenter :
      generator ∈ Subgroup.center (SylowNormalizer Q))
    (generator_mem_ambientCenter :
      generator.1 ∈ Subgroup.center X)
    (localCenter_le_ambientCenter :
      ∀ z : SylowNormalizer Q,
        z ∈ Subgroup.center (SylowNormalizer Q) →
          z.1 ∈ Subgroup.center X)
    (localCenter_generated :
      ∀ z : SylowNormalizer Q,
        z ∈ Subgroup.center (SylowNormalizer Q) →
          ∃ n : ℕ, z = generator ^ n)
    (generatorCross :
      χ.1.values generator.1 * ((e χ).1.degree : ℂ) =
        (e χ).1.values generator * (χ.1.degree : ℂ)) :
    ExactNormalizerProjectiveRowData e χ := by
  classical
  let centralUnit : X → ℂˣ :=
    fun z =>
      if hz : z ∈ Subgroup.center X then
        χ.1.centralUnit z hz
      else
        1
  have generatorUnit :
      χ.1.centralUnit generator.1 generator_mem_ambientCenter =
        (e χ).1.centralUnit generator generator_mem_localCenter :=
    χ.1.centralUnit_eq_of_cross (e χ).1
      generator.1 generator
      generator_mem_ambientCenter generator_mem_localCenter
      generatorCross
  apply ofInnerNormalizerSurjective e χ hSurjective centralUnit
  · intro z hz
    have hcentralUnit :
        centralUnit z = χ.1.centralUnit z hz := by
      simp [centralUnit, hz]
    rw [hcentralUnit]
    exact χ.1.realizationAction_eq_centralUnit z hz
  · intro z hz
    obtain ⟨n, hn⟩ := localCenter_generated z hz
    subst z
    have hLocalPow :
        generator ^ n ∈
          Subgroup.center (SylowNormalizer Q) :=
      pow_mem generator_mem_localCenter n
    have hAmbientPow :
        (generator ^ n).1 ∈ Subgroup.center X :=
      localCenter_le_ambientCenter
        (generator ^ n) hLocalPow
    have hUnitPow :
        χ.1.centralUnit (generator ^ n).1 hAmbientPow =
          (e χ).1.centralUnit (generator ^ n) hLocalPow := by
      calc
        χ.1.centralUnit (generator ^ n).1 hAmbientPow =
            χ.1.centralUnit (generator.1 ^ n)
              (pow_mem generator_mem_ambientCenter n) :=
          χ.1.centralUnit_congr hAmbientPow
            (pow_mem generator_mem_ambientCenter n) rfl
        _ =
            (χ.1.centralUnit generator.1
              generator_mem_ambientCenter) ^ n :=
          χ.1.centralUnit_pow generator.1
            generator_mem_ambientCenter n
        _ =
            ((e χ).1.centralUnit generator
              generator_mem_localCenter) ^ n := by
          rw [generatorUnit]
        _ =
            (e χ).1.centralUnit (generator ^ n)
              hLocalPow :=
          ((e χ).1.centralUnit_pow generator
            generator_mem_localCenter n).symm
    have hcentralUnit :
        centralUnit (generator ^ n).1 =
          χ.1.centralUnit (generator ^ n).1 hAmbientPow := by
      have hAmbientPow' :
          generator.1 ^ n ∈ Subgroup.center X :=
        pow_mem generator_mem_ambientCenter n
      calc
        centralUnit (generator ^ n).1 =
            χ.1.centralUnit (generator.1 ^ n) hAmbientPow' := by
          simp [centralUnit, hAmbientPow']
        _ =
            χ.1.centralUnit (generator ^ n).1 hAmbientPow :=
          χ.1.centralUnit_congr hAmbientPow' hAmbientPow rfl
    rw [(e χ).1.realizationAction_eq_centralUnit
      (generator ^ n) hLocalPow, hcentralUnit, hUnitPow]

end ExactNormalizerProjectiveRowData

end InductiveMcKay
end McKayConjecture
