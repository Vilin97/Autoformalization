import McKayConjecture.GroupTheory.AlternatingSixSylowStructure

/-!
# The Sylow-three normalizer in `A₆`

This file gives a concrete model for a Sylow `3`-subgroup of `A₆`: the
product of the cyclic groups generated by the disjoint three-cycles
`(0 1 2)` and `(3 4 5)`.  An explicit even permutation of order four
normalizes this subgroup and induces an automorphism of order four.

Together with Sylow congruence, these concrete facts determine the complete
three-local cardinality data:

* there are ten Sylow `3`-subgroups;
* every Sylow `3`-normalizer has order thirty-six;
* its conjugation-action image has order four; and
* the Sylow centralizer has order nine.
-/

noncomputable section

namespace McKayConjecture
namespace GroupTheory

open Equiv
open MulAction
open scoped Pointwise

local instance alternatingSixNormalizerFactPrimeThree :
    Fact (Nat.Prime 3) :=
  ⟨Nat.prime_three⟩

/-! ### A concrete elementary-abelian Sylow subgroup -/

/-- The three-cycle `(0 1 2)`, fixing the last three points. -/
def alternatingSixLeftThreeCyclePerm :
    Equiv.Perm (Fin 6) :=
  ⟨![1, 2, 0, 3, 4, 5], ![2, 0, 1, 3, 4, 5],
    by decide, by decide⟩

/-- The three-cycle `(3 4 5)`, fixing the first three points. -/
def alternatingSixRightThreeCyclePerm :
    Equiv.Perm (Fin 6) :=
  ⟨![0, 1, 2, 4, 5, 3], ![0, 1, 2, 5, 3, 4],
    by decide, by decide⟩

/-- The left three-cycle, regarded as an element of `A₆`. -/
def alternatingSixLeftThreeCycle :
    AlternatingSix :=
  ⟨alternatingSixLeftThreeCyclePerm, by
    rw [Equiv.Perm.mem_alternatingGroup]
    have h :
        alternatingSixLeftThreeCyclePerm =
          Equiv.swap (0 : Fin 6) 1 *
            Equiv.swap 1 2 := by
      decide
    rw [h, map_mul]
    simp⟩

/-- The right three-cycle, regarded as an element of `A₆`. -/
def alternatingSixRightThreeCycle :
    AlternatingSix :=
  ⟨alternatingSixRightThreeCyclePerm, by
    rw [Equiv.Perm.mem_alternatingGroup]
    have h :
        alternatingSixRightThreeCyclePerm =
          Equiv.swap (3 : Fin 6) 4 *
            Equiv.swap 4 5 := by
      decide
    rw [h, map_mul]
    simp⟩

/-- Coordinates for the concrete elementary-abelian subgroup. -/
abbrev AlternatingSixSylowThreeCoordinates :=
  Fin 3 × Fin 3

/-- The element with coordinates `(i,j)` is the product of the `i`-th
power of `(0 1 2)` and the `j`-th power of `(3 4 5)`. -/
def alternatingSixSylowThreeParameterizedElement
    (c : AlternatingSixSylowThreeCoordinates) :
    AlternatingSix :=
  alternatingSixLeftThreeCycle ^ c.1.val *
    alternatingSixRightThreeCycle ^ c.2.val

/-- The concrete subgroup generated independently on the two three-point
blocks. -/
def alternatingSixConcreteSylowThreeSubgroup :
    Subgroup AlternatingSix where
  carrier :=
    Set.range alternatingSixSylowThreeParameterizedElement
  one_mem' := by
    exact ⟨(0, 0), by decide⟩
  mul_mem' := fun {a b} ha hb => by
    obtain ⟨⟨i, j⟩, rfl⟩ := ha
    obtain ⟨⟨k, l⟩, rfl⟩ := hb
    fin_cases i <;> fin_cases j <;>
      fin_cases k <;> fin_cases l <;> decide
  inv_mem' := fun {a} ha => by
    obtain ⟨⟨i, j⟩, rfl⟩ := ha
    fin_cases i <;> fin_cases j <;> decide

/-- The two-coordinate parametrization is injective. -/
theorem alternatingSixSylowThreeParameterizedElement_injective :
    Function.Injective
      alternatingSixSylowThreeParameterizedElement := by
  rintro ⟨i, j⟩ ⟨k, l⟩ h
  fin_cases i <;> fin_cases j <;>
    fin_cases k <;> fin_cases l <;>
      try rfl
  all_goals
    exfalso
    revert h
    decide

/-- Coordinates identify `(Fin 3)²` with the concrete subgroup. -/
def alternatingSixSylowThreeCoordinatesEquiv :
    AlternatingSixSylowThreeCoordinates ≃
      alternatingSixConcreteSylowThreeSubgroup where
  toFun c :=
    ⟨alternatingSixSylowThreeParameterizedElement c, ⟨c, rfl⟩⟩
  invFun x :=
    Classical.choose x.property
  left_inv c := by
    apply alternatingSixSylowThreeParameterizedElement_injective
    exact Classical.choose_spec
      (show
        ∃ d,
          alternatingSixSylowThreeParameterizedElement d =
            alternatingSixSylowThreeParameterizedElement c from
        ⟨c, rfl⟩)
  right_inv x := by
    apply Subtype.ext
    exact Classical.choose_spec x.property

/-- The concrete subgroup has order nine. -/
@[simp]
theorem natCard_alternatingSixConcreteSylowThreeSubgroup :
    Nat.card alternatingSixConcreteSylowThreeSubgroup = 9 := by
  calc
    Nat.card alternatingSixConcreteSylowThreeSubgroup =
        Nat.card AlternatingSixSylowThreeCoordinates :=
      Nat.card_congr alternatingSixSylowThreeCoordinatesEquiv.symm
    _ = 9 := by norm_num

/-- The concrete subgroup, promoted to a Sylow `3`-subgroup. -/
def alternatingSixConcreteSylowThree :
    Sylow 3 AlternatingSix :=
  Sylow.ofCard alternatingSixConcreteSylowThreeSubgroup (by
    rw [natCard_alternatingSixConcreteSylowThreeSubgroup,
      natCard_alternatingSix]
    have h :=
      DFunLike.congr_fun
        factorization_natCard_alternatingSix 3
    rw [natCard_alternatingSix] at h
    norm_num [Finsupp.add_apply, Finsupp.single_apply] at h
    rw [h]
    norm_num)

@[simp]
theorem alternatingSixConcreteSylowThree_coe :
    (alternatingSixConcreteSylowThree :
      Subgroup AlternatingSix) =
        alternatingSixConcreteSylowThreeSubgroup :=
  rfl

/-! ### An order-four normalizer element -/

/-- The even permutation `(0 3 1 4)(2 5)`. -/
def alternatingSixSylowThreeNormalizerGeneratorPerm :
    Equiv.Perm (Fin 6) :=
  ⟨![3, 4, 5, 1, 0, 2], ![4, 3, 5, 0, 1, 2],
    by decide, by decide⟩

/-- The explicit order-four normalizer element, regarded in `A₆`. -/
def alternatingSixSylowThreeNormalizerGenerator :
    AlternatingSix :=
  ⟨alternatingSixSylowThreeNormalizerGeneratorPerm, by
    rw [Equiv.Perm.mem_alternatingGroup]
    have h :
        alternatingSixSylowThreeNormalizerGeneratorPerm =
          Equiv.swap (0 : Fin 6) 3 *
            Equiv.swap 3 1 *
              Equiv.swap 1 4 *
                Equiv.swap 2 5 := by
      decide
    rw [h, map_mul, map_mul, map_mul]
    simp⟩

/-- The explicit order-four element normalizes the concrete Sylow subgroup. -/
theorem alternatingSixSylowThreeNormalizerGenerator_mem_normalizer :
    alternatingSixSylowThreeNormalizerGenerator ∈
      Subgroup.normalizer
        (alternatingSixConcreteSylowThreeSubgroup :
          Set AlternatingSix) := by
  rw [Subgroup.mem_set_normalizer_iff]
  intro g
  constructor
  · rintro ⟨⟨i, j⟩, rfl⟩
    change
      ∃ c,
        alternatingSixSylowThreeParameterizedElement c =
          alternatingSixSylowThreeNormalizerGenerator *
            alternatingSixSylowThreeParameterizedElement (i, j) *
              alternatingSixSylowThreeNormalizerGenerator⁻¹
    fin_cases i <;> fin_cases j <;> decide
  · intro hconj
    have hinv :
        alternatingSixSylowThreeNormalizerGenerator⁻¹ *
              (alternatingSixSylowThreeNormalizerGenerator * g *
                alternatingSixSylowThreeNormalizerGenerator⁻¹) *
            alternatingSixSylowThreeNormalizerGenerator ∈
          alternatingSixConcreteSylowThreeSubgroup := by
      obtain ⟨⟨i, j⟩, hij⟩ := hconj
      rw [← hij]
      change
        ∃ c,
          alternatingSixSylowThreeParameterizedElement c =
            alternatingSixSylowThreeNormalizerGenerator⁻¹ *
                alternatingSixSylowThreeParameterizedElement (i, j) *
              alternatingSixSylowThreeNormalizerGenerator
      fin_cases i <;> fin_cases j <;> decide
    simpa [mul_assoc] using hinv

/-- The explicit element as an element of the concrete normalizer. -/
def alternatingSixSylowThreeNormalizerGeneratorInNormalizer :
    Subgroup.normalizer
      (alternatingSixConcreteSylowThreeSubgroup :
        Set AlternatingSix) :=
  ⟨alternatingSixSylowThreeNormalizerGenerator,
    alternatingSixSylowThreeNormalizerGenerator_mem_normalizer⟩

/-- The automorphism induced by the explicit normalizer element. -/
def alternatingSixSylowThreeOrderFourAutomorphism :
    MulAut alternatingSixConcreteSylowThreeSubgroup :=
  alternatingSixConcreteSylowThreeSubgroup.normalizerMonoidHom
    alternatingSixSylowThreeNormalizerGeneratorInNormalizer

/-- The induced automorphism has order four. -/
theorem orderOf_alternatingSixSylowThreeOrderFourAutomorphism :
    orderOf alternatingSixSylowThreeOrderFourAutomorphism = 4 := by
  rw [orderOf_eq_iff (by norm_num : 0 < 4)]
  constructor
  · apply DFunLike.ext
    intro y
    rcases y with ⟨y, ⟨⟨i, j⟩, hy⟩⟩
    subst y
    fin_cases i <;> fin_cases j <;> decide
  · intro m hm hzero
    interval_cases m
    all_goals
      intro heq
      have happ :=
        DFunLike.congr_fun heq
          (⟨alternatingSixLeftThreeCycle,
            ⟨(1, 0), by decide⟩⟩ :
            alternatingSixConcreteSylowThreeSubgroup)
      revert happ
      decide

/-! ### Exact normalizer order -/

/-- The order-four automorphism gives a factor four in the concrete
normalizer-action image. -/
theorem four_dvd_natCard_alternatingSixConcreteSylowThree_actionRange :
    4 ∣
      Nat.card
        alternatingSixConcreteSylowThreeSubgroup.normalizerMonoidHom.range := by
  let f :=
    alternatingSixConcreteSylowThreeSubgroup.normalizerMonoidHom
  let a : f.range :=
    ⟨alternatingSixSylowThreeOrderFourAutomorphism,
      ⟨alternatingSixSylowThreeNormalizerGeneratorInNormalizer, rfl⟩⟩
  have ha : orderOf a = 4 := by
    rw [← Subgroup.orderOf_coe a]
    exact
      orderOf_alternatingSixSylowThreeOrderFourAutomorphism
  rw [← ha]
  exact orderOf_dvd_natCard a

/-- The concrete Sylow `3`-normalizer has order divisible by thirty-six. -/
theorem thirtySix_dvd_natCard_normalizer_alternatingSixConcreteSylowThree :
    36 ∣
      Nat.card
        (Subgroup.normalizer
          (alternatingSixConcreteSylowThreeSubgroup :
            Set AlternatingSix)) := by
  let P :=
    alternatingSixConcreteSylowThreeSubgroup
  let N :=
    Subgroup.normalizer (P : Set AlternatingSix)
  let f := P.normalizerMonoidHom
  have hnine :
      9 ∣ Nat.card N := by
    rw [← natCard_alternatingSixConcreteSylowThreeSubgroup]
    exact Subgroup.card_dvd_of_le P.le_normalizer
  have hfourRange :
      4 ∣ Nat.card f.range :=
    four_dvd_natCard_alternatingSixConcreteSylowThree_actionRange
  have hproduct :
      Nat.card f.ker * Nat.card f.range =
        Nat.card N := by
    calc
      Nat.card f.ker * Nat.card f.range =
          Nat.card f.ker * f.ker.index := by
        rw [Subgroup.index_ker]
      _ = Nat.card N :=
        f.ker.card_mul_index
  have hfour :
      4 ∣ Nat.card N := by
    obtain ⟨k, hk⟩ := hfourRange
    refine ⟨Nat.card f.ker * k, ?_⟩
    calc
      Nat.card N =
          Nat.card f.ker * Nat.card f.range :=
        hproduct.symm
      _ = Nat.card f.ker * (4 * k) := by
        rw [hk]
      _ = 4 * (Nat.card f.ker * k) := by
        ac_rfl
  exact
    (by norm_num : Nat.Coprime 4 9).mul_dvd_of_dvd_of_dvd
      hfour hnine

/-- The concrete Sylow normalizer is proper in `A₆`. -/
theorem normalizer_alternatingSixConcreteSylowThree_ne_top :
    Subgroup.normalizer
        (alternatingSixConcreteSylowThreeSubgroup :
          Set AlternatingSix) ≠
      ⊤ := by
  intro htop
  have hnormal :
      alternatingSixConcreteSylowThreeSubgroup.Normal :=
    Subgroup.normalizer_eq_top_iff.mp htop
  rcases hnormal.eq_bot_or_eq_top with hbot | hall
  · have hcard :=
      natCard_alternatingSixConcreteSylowThreeSubgroup
    rw [hbot, Subgroup.card_bot] at hcard
    norm_num at hcard
  · have hcard :=
      natCard_alternatingSixConcreteSylowThreeSubgroup
    rw [hall, Subgroup.card_top,
      natCard_alternatingSix] at hcard
    norm_num at hcard

/-- The concrete Sylow `3`-normalizer in `A₆` has order thirty-six. -/
@[simp]
theorem natCard_normalizer_alternatingSixConcreteSylowThree :
    Nat.card
        (Subgroup.normalizer
          (alternatingSixConcreteSylowThreeSubgroup :
            Set AlternatingSix)) =
      36 := by
  let N :=
    Subgroup.normalizer
      (alternatingSixConcreteSylowThreeSubgroup :
        Set AlternatingSix)
  change Nat.card N = 36
  have hdvd :
      36 ∣ Nat.card N :=
    thirtySix_dvd_natCard_normalizer_alternatingSixConcreteSylowThree
  have hproduct :
      Nat.card N * Nat.card (Sylow 3 AlternatingSix) =
        360 := by
    have hindex :
        N.index = Nat.card (Sylow 3 AlternatingSix) := by
      have h :=
        alternatingSixConcreteSylowThree.card_eq_index_normalizer
      change
        Nat.card (Sylow 3 AlternatingSix) = N.index at h
      exact h.symm
    rw [← hindex, Subgroup.card_mul_index,
      natCard_alternatingSix]
  have hmod :
      Nat.card (Sylow 3 AlternatingSix) % 3 = 1 :=
    card_sylow_modEq_one 3 AlternatingSix
  have hnormalizerNe :
      Nat.card N ≠ 360 := by
    intro hcard
    have htop : N = ⊤ := by
      apply Subgroup.eq_top_of_card_eq
      rw [hcard, natCard_alternatingSix]
    exact
      normalizer_alternatingSixConcreteSylowThree_ne_top htop
  have hnormalizerLower :
      36 ≤ Nat.card N :=
    Nat.le_of_dvd (Nat.card_pos (α := N)) hdvd
  have hsylowBound :
      Nat.card (Sylow 3 AlternatingSix) ≤ 10 := by
    have :
        36 * Nat.card (Sylow 3 AlternatingSix) ≤ 360 := by
      calc
        36 * Nat.card (Sylow 3 AlternatingSix) ≤
            Nat.card N * Nat.card (Sylow 3 AlternatingSix) :=
          Nat.mul_le_mul_right _ hnormalizerLower
        _ = 360 := hproduct
    omega
  obtain ⟨k, hk⟩ := hdvd
  interval_cases hsylow :
    Nat.card (Sylow 3 AlternatingSix)
  all_goals norm_num [hsylow] at hmod
  all_goals norm_num [hsylow] at hproduct
  all_goals omega

/-- There are exactly ten Sylow `3`-subgroups in `A₆`. -/
@[simp]
theorem natCard_sylowThree_subgroups_alternatingSix :
    Nat.card (Sylow 3 AlternatingSix) = 10 := by
  let N :=
    Subgroup.normalizer
      (alternatingSixConcreteSylowThreeSubgroup :
        Set AlternatingSix)
  have hproduct :
      Nat.card N * Nat.card (Sylow 3 AlternatingSix) =
        360 := by
    have hindex :
        N.index = Nat.card (Sylow 3 AlternatingSix) := by
      have h :=
        alternatingSixConcreteSylowThree.card_eq_index_normalizer
      change
        Nat.card (Sylow 3 AlternatingSix) = N.index at h
      exact h.symm
    rw [← hindex, Subgroup.card_mul_index,
      natCard_alternatingSix]
  rw [natCard_normalizer_alternatingSixConcreteSylowThree] at hproduct
  omega

/-- Every Sylow `3`-normalizer in `A₆` has order thirty-six. -/
@[simp]
theorem natCard_normalizer_sylowThree_alternatingSix
    (P : Sylow 3 AlternatingSix) :
    Nat.card
        (Subgroup.normalizer
          ((P : Subgroup AlternatingSix) : Set AlternatingSix)) =
      36 := by
  have hproduct :
      Nat.card
          (Subgroup.normalizer
            ((P : Subgroup AlternatingSix) : Set AlternatingSix)) *
          Nat.card (Sylow 3 AlternatingSix) =
        360 := by
    have hindex :
        (Subgroup.normalizer
          ((P : Subgroup AlternatingSix) :
            Set AlternatingSix)).index =
          Nat.card (Sylow 3 AlternatingSix) := by
      have h :=
        P.card_eq_index_normalizer
      change
        Nat.card (Sylow 3 AlternatingSix) =
          (Subgroup.normalizer
            ((P : Subgroup AlternatingSix) :
              Set AlternatingSix)).index at h
      exact h.symm
    rw [← hindex,
      Subgroup.card_mul_index,
      natCard_alternatingSix]
  rw [natCard_sylowThree_subgroups_alternatingSix] at hproduct
  omega

/-! ### Centralizer and conjugation action -/

/-- An abelian Sylow `3`-subgroup centralizes itself. -/
theorem sylowThree_alternatingSix_le_centralizer
    (P : Sylow 3 AlternatingSix) :
    (P : Subgroup AlternatingSix) ≤
      Subgroup.centralizer
        ((P : Subgroup AlternatingSix) : Set AlternatingSix) := by
  have hcomm :
      IsMulCommutative P :=
    sylowThree_alternatingSix_isMulCommutative P
  intro x hx
  rw [Subgroup.mem_centralizer_iff]
  intro y hy
  have hxy :
      (⟨x, hx⟩ : P) * ⟨y, hy⟩ =
        ⟨y, hy⟩ * ⟨x, hx⟩ :=
    hcomm.is_comm.comm _ _
  exact congrArg Subtype.val hxy |>.symm

/-- The centralizer of the concrete Sylow `3`-subgroup has order nine. -/
@[simp]
theorem natCard_centralizer_alternatingSixConcreteSylowThree :
    Nat.card
        (Subgroup.centralizer
          (alternatingSixConcreteSylowThreeSubgroup :
            Set AlternatingSix)) =
      9 := by
  let P :=
    alternatingSixConcreteSylowThreeSubgroup
  let N :=
    Subgroup.normalizer (P : Set AlternatingSix)
  let C :=
    Subgroup.centralizer (P : Set AlternatingSix)
  let f := P.normalizerMonoidHom
  change Nat.card C = 9
  have hker :
      Nat.card f.ker = Nat.card C := by
    rw [Subgroup.normalizerMonoidHom_ker]
    exact
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe
          (Subgroup.centralizer_le_normalizer
            (P : Set AlternatingSix))).toEquiv
  have hproduct :
      Nat.card C * Nat.card f.range = 36 := by
    calc
      Nat.card C * Nat.card f.range =
          Nat.card f.ker * Nat.card f.range := by
        rw [hker]
      _ = Nat.card N := by
        calc
          Nat.card f.ker * Nat.card f.range =
              Nat.card f.ker * f.ker.index := by
            rw [Subgroup.index_ker]
          _ = Nat.card N :=
            f.ker.card_mul_index
      _ = 36 :=
        natCard_normalizer_alternatingSixConcreteSylowThree
  have hfour :
      4 ∣ Nat.card f.range :=
    four_dvd_natCard_alternatingSixConcreteSylowThree_actionRange
  have hrangeLower :
      4 ≤ Nat.card f.range :=
    Nat.le_of_dvd
      (Nat.card_pos (α := f.range)) hfour
  have hcentralizerUpper :
      Nat.card C ≤ 9 := by
    have :
        Nat.card C * 4 ≤ 36 := by
      calc
        Nat.card C * 4 ≤
            Nat.card C * Nat.card f.range :=
          Nat.mul_le_mul_left _ hrangeLower
        _ = 36 := hproduct
    omega
  have hcentralizerLower :
      9 ≤ Nat.card C := by
    have hdvd :
        Nat.card P ∣ Nat.card C :=
      Subgroup.card_dvd_of_le
        (sylowThree_alternatingSix_le_centralizer
          alternatingSixConcreteSylowThree)
    rw [natCard_alternatingSixConcreteSylowThreeSubgroup]
      at hdvd
    exact Nat.le_of_dvd (Nat.card_pos (α := C)) hdvd
  omega

/-- The concrete normalizer acts through a group of order four. -/
@[simp]
theorem natCard_alternatingSixConcreteSylowThree_actionRange :
    Nat.card
        alternatingSixConcreteSylowThreeSubgroup.normalizerMonoidHom.range =
      4 := by
  let P :=
    alternatingSixConcreteSylowThreeSubgroup
  let N :=
    Subgroup.normalizer (P : Set AlternatingSix)
  let f := P.normalizerMonoidHom
  have hker :
      Nat.card f.ker = 9 := by
    rw [Subgroup.normalizerMonoidHom_ker,
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe
          (Subgroup.centralizer_le_normalizer
            (P : Set AlternatingSix))).toEquiv,
      natCard_centralizer_alternatingSixConcreteSylowThree]
  have hproduct :
      Nat.card f.ker * Nat.card f.range =
        Nat.card N := by
    calc
      Nat.card f.ker * Nat.card f.range =
          Nat.card f.ker * f.ker.index := by
        rw [Subgroup.index_ker]
      _ = Nat.card N :=
        f.ker.card_mul_index
  change Nat.card f.range = 4
  rw [hker,
    natCard_normalizer_alternatingSixConcreteSylowThree]
    at hproduct
  omega

/-- The concrete action image is cyclic, generated by the displayed
order-four automorphism. -/
theorem alternatingSixConcreteSylowThree_actionRange_isCyclic :
    IsCyclic
      alternatingSixConcreteSylowThreeSubgroup.normalizerMonoidHom.range := by
  rw [isCyclic_iff_exists_orderOf_eq_natCard]
  let f :=
    alternatingSixConcreteSylowThreeSubgroup.normalizerMonoidHom
  let a : f.range :=
    ⟨alternatingSixSylowThreeOrderFourAutomorphism,
      ⟨alternatingSixSylowThreeNormalizerGeneratorInNormalizer, rfl⟩⟩
  refine ⟨a, ?_⟩
  rw [natCard_alternatingSixConcreteSylowThree_actionRange]
  rw [← Subgroup.orderOf_coe a]
  exact
    orderOf_alternatingSixSylowThreeOrderFourAutomorphism

/-- Conjugation transports the centralizer of a subgroup to the centralizer
of the conjugate subgroup. -/
theorem conj_smul_centralizer
    (g : AlternatingSix)
    (H : Subgroup AlternatingSix) :
    MulAut.conj g •
        Subgroup.centralizer (H : Set AlternatingSix) =
      Subgroup.centralizer
        ((MulAut.conj g • H : Subgroup AlternatingSix) :
          Set AlternatingSix) := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩ y ⟨z, hz, rfl⟩
    simpa only [MulDistribMulAction.toMonoidEnd_apply,
      MulDistribMulAction.toMonoidHom_apply,
      MulAut.smul_def, map_mul] using
      congrArg (MulAut.conj g) (hx z hz)
  · intro x hx
    rw [Subgroup.mem_pointwise_smul_iff_inv_smul_mem,
      Subgroup.mem_centralizer_iff]
    intro y hy
    apply (MulAut.conj g).injective
    have hyConj :
        MulAut.conj g y ∈
          (MulAut.conj g • H :
            Subgroup AlternatingSix) :=
      ⟨y, hy, rfl⟩
    simpa only [MulDistribMulAction.toMonoidEnd_apply,
      MulDistribMulAction.toMonoidHom_apply,
      MulAut.smul_def, map_mul,
      MulAut.apply_inv_self]
      using hx (MulAut.conj g y) hyConj

/-- Every Sylow `3`-centralizer in `A₆` has order nine. -/
@[simp]
theorem natCard_centralizer_sylowThree_alternatingSix
    (P : Sylow 3 AlternatingSix) :
    Nat.card
        (Subgroup.centralizer
          ((P : Subgroup AlternatingSix) : Set AlternatingSix)) =
      9 := by
  obtain ⟨g, hg⟩ :=
    exists_smul_eq
      AlternatingSix
      alternatingSixConcreteSylowThree P
  let C :=
    Subgroup.centralizer
      (alternatingSixConcreteSylowThreeSubgroup :
        Set AlternatingSix)
  have hsubgroup :
      MulAut.conj g •
          alternatingSixConcreteSylowThreeSubgroup =
        (P : Subgroup AlternatingSix) := by
    have h :=
      congrArg
        (fun Q : Sylow 3 AlternatingSix ↦
          (Q : Subgroup AlternatingSix)) hg
    change
      MulAut.conj g •
          alternatingSixConcreteSylowThreeSubgroup =
        (P : Subgroup AlternatingSix) at h
    exact h
  calc
    Nat.card
        (Subgroup.centralizer
          ((P : Subgroup AlternatingSix) :
            Set AlternatingSix)) =
        Nat.card
          (MulAut.conj g • C :
            Subgroup AlternatingSix) := by
      rw [conj_smul_centralizer, hsubgroup]
    _ = Nat.card C :=
      Nat.card_congr
        (Subgroup.equivSMul (MulAut.conj g) C).symm.toEquiv
    _ = 9 :=
      natCard_centralizer_alternatingSixConcreteSylowThree

/-- A Sylow `3`-subgroup is self-centralizing in `A₆`. -/
theorem centralizer_sylowThree_alternatingSix_eq
    (P : Sylow 3 AlternatingSix) :
    Subgroup.centralizer
        ((P : Subgroup AlternatingSix) : Set AlternatingSix) =
      (P : Subgroup AlternatingSix) := by
  symm
  apply Subgroup.eq_of_le_of_card_ge
    (sylowThree_alternatingSix_le_centralizer P)
  rw [natCard_centralizer_sylowThree_alternatingSix,
    natCard_sylowThree_alternatingSix]

/-- Every Sylow `3`-normalizer acts through a group of order four. -/
@[simp]
theorem natCard_sylowThree_normalizerMonoidHom_range
    (P : Sylow 3 AlternatingSix) :
    Nat.card
        (P : Subgroup AlternatingSix).normalizerMonoidHom.range =
      4 := by
  let N :=
    Subgroup.normalizer
      ((P : Subgroup AlternatingSix) : Set AlternatingSix)
  let f :=
    (P : Subgroup AlternatingSix).normalizerMonoidHom
  have hker :
      Nat.card f.ker = 9 := by
    rw [Subgroup.normalizerMonoidHom_ker,
      Nat.card_congr
        (Subgroup.subgroupOfEquivOfLe
          (Subgroup.centralizer_le_normalizer
            ((P : Subgroup AlternatingSix) :
              Set AlternatingSix))).toEquiv,
      natCard_centralizer_sylowThree_alternatingSix]
  have hproduct :
      Nat.card f.ker * Nat.card f.range =
        Nat.card N := by
    calc
      Nat.card f.ker * Nat.card f.range =
          Nat.card f.ker * f.ker.index := by
        rw [Subgroup.index_ker]
      _ = Nat.card N :=
        f.ker.card_mul_index
  change Nat.card f.range = 4
  rw [hker,
    natCard_normalizer_sylowThree_alternatingSix]
    at hproduct
  omega

/-- The kernel of the normalizer action is the self-centralizing Sylow
subgroup and has order nine. -/
@[simp]
theorem natCard_sylowThree_normalizerMonoidHom_ker
    (P : Sylow 3 AlternatingSix) :
    Nat.card
        (P : Subgroup AlternatingSix).normalizerMonoidHom.ker =
      9 := by
  rw [Subgroup.normalizerMonoidHom_ker,
    Nat.card_congr
      (Subgroup.subgroupOfEquivOfLe
        (Subgroup.centralizer_le_normalizer
          ((P : Subgroup AlternatingSix) :
            Set AlternatingSix))).toEquiv,
    natCard_centralizer_sylowThree_alternatingSix]

/-- A Sylow `3`-subgroup has relative index four in its normalizer. -/
theorem relIndex_sylowThree_normalizer_alternatingSix
    (P : Sylow 3 AlternatingSix) :
    (P : Subgroup AlternatingSix).relIndex
        (Subgroup.normalizer
          ((P : Subgroup AlternatingSix) :
            Set AlternatingSix)) =
      4 := by
  let N :=
    Subgroup.normalizer
      ((P : Subgroup AlternatingSix) :
        Set AlternatingSix)
  change (P : Subgroup AlternatingSix).relIndex N = 4
  have hcardSubgroup :
      Nat.card
          ((P : Subgroup AlternatingSix).subgroupOf N) =
        9 := by
    calc
      Nat.card
          ((P : Subgroup AlternatingSix).subgroupOf N) =
          Nat.card P :=
        Nat.card_congr
          (Subgroup.subgroupOfEquivOfLe
            (P : Subgroup AlternatingSix).le_normalizer).toEquiv
      _ = 9 :=
        natCard_sylowThree_alternatingSix P
  have hcard :=
    ((P : Subgroup AlternatingSix).subgroupOf N).card_mul_index
  change
    Nat.card
        ((P : Subgroup AlternatingSix).subgroupOf N) *
        (P : Subgroup AlternatingSix).relIndex N =
      Nat.card N at hcard
  have hnormalizer :
      Nat.card N = 36 :=
    natCard_normalizer_sylowThree_alternatingSix P
  rw [hcardSubgroup, hnormalizer] at hcard
  omega

end GroupTheory
end McKayConjecture
