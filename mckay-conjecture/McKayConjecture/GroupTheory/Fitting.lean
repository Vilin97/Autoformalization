import McKayConjecture.GroupTheory.PCore

/-!
# The Fitting subgroup: prime-core foundation

For a finite group the Fitting subgroup is the product of its normal Sylow
cores.  We use that equivalent prime-core description as the definition:

`F(G) = ⨆ p prime, O_p(G)`.

This file proves the functorial and characteristic properties and the
pairwise commutation of the prime cores.  The internal direct-product and
self-centralizing theorems are kept in later files so that the elementary
prime-core API remains small.
-/

noncomputable section

universe u v

namespace McKayConjecture.GroupTheory

variable (G : Type u) [Group G]

/-- The Fitting subgroup of a finite group, expressed as the subgroup
generated by all normal prime-power cores. -/
def fittingSubgroup : Subgroup G :=
  ⨆ (p : ℕ) (_hp : p.Prime), pCore p G

variable {G}

/-- Every prime core lies in the Fitting subgroup. -/
theorem pCore_le_fittingSubgroup {p : ℕ} (hp : p.Prime) :
    pCore p G ≤ fittingSubgroup G :=
  le_iSup_of_le p (le_iSup_of_le hp le_rfl)

/-- The Fitting subgroup is the least subgroup containing every prime
core. -/
theorem fittingSubgroup_le {K : Subgroup G}
    (hK : ∀ (p : ℕ), p.Prime → pCore p G ≤ K) :
    fittingSubgroup G ≤ K := by
  apply iSup_le
  intro p
  apply iSup_le
  intro hp
  exact hK p hp

/-- Distinct prime cores are disjoint. -/
theorem disjoint_pCore {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    Disjoint (pCore p G) (pCore q G) := by
  letI : Fact p.Prime := ⟨hp⟩
  letI : Fact q.Prime := ⟨hq⟩
  exact IsPGroup.disjoint_of_ne p q hpq
    (pCore p G) (pCore q G)
    pCore_isPGroup pCore_isPGroup

/-- Distinct prime cores have trivial intersection. -/
theorem pCore_inf_pCore_eq_bot {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    pCore p G ⊓ pCore q G = ⊥ :=
  (disjoint_pCore hp hq hpq).eq_bot

/-- Elements of distinct prime cores commute. -/
theorem pCore_commute {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    {x y : G} (hx : x ∈ pCore p G) (hy : y ∈ pCore q G) :
    Commute x y :=
  Subgroup.commute_of_normal_of_disjoint
    (pCore p G) (pCore q G) inferInstance inferInstance
    (disjoint_pCore hp hq hpq) x y hx hy

/-- An isomorphism maps the Fitting subgroup into the target Fitting
subgroup. -/
theorem map_fittingSubgroup_le
    {H : Type v} [Group H] (e : G ≃* H) :
    (fittingSubgroup G).map e.toMonoidHom ≤ fittingSubgroup H := by
  rw [Subgroup.map_le_iff_le_comap]
  apply fittingSubgroup_le
  intro p hp
  rw [← Subgroup.map_le_iff_le_comap]
  exact (map_pCore_equiv e).le.trans
    (pCore_le_fittingSubgroup hp)

/-- Isomorphisms map the Fitting subgroup exactly onto the target Fitting
subgroup. -/
theorem map_fittingSubgroup_mulEquiv
    {H : Type v} [Group H] (e : G ≃* H) :
    (fittingSubgroup G).map e.toMonoidHom =
      fittingSubgroup H := by
  apply le_antisymm
  · exact map_fittingSubgroup_le e
  · intro y hy
    have hreverse :
        (fittingSubgroup H).map e.symm.toMonoidHom ≤
          fittingSubgroup G :=
      map_fittingSubgroup_le e.symm
    have hx : e.symm y ∈ fittingSubgroup G :=
      hreverse ⟨y, hy, rfl⟩
    exact ⟨e.symm y, hx, e.apply_symm_apply y⟩

/-- The Fitting subgroup is characteristic. -/
instance fittingSubgroup_characteristic :
    (fittingSubgroup G).Characteristic := by
  rw [Subgroup.characteristic_iff_map_le]
  intro e
  exact map_fittingSubgroup_le e

/-- The Fitting subgroup is normal. -/
instance fittingSubgroup_normal :
    (fittingSubgroup G).Normal :=
  inferInstance

end McKayConjecture.GroupTheory
