import Mathlib.GroupTheory.PGroup
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Subgroup indices above a `p`-group quotient

If `K` is normal in a finite group `G` and `G/K` is a `p`-group, then
every subgroup containing `K` has `p`-power index.  Consequently such a
subgroup whose index is prime to `p` must be all of `G`.

The file also records the elementary fact that `G/K` is a `p`-group when
`G` is generated by `K` and a `p`-subgroup.  These two lemmas are the
group-theoretic arithmetic used in the Clifford-theoretic part of the
central-intersection reduction.
-/

noncomputable section

universe u

namespace McKayConjecture
namespace GroupTheory

variable {G : Type u} [Group G] [Finite G]
variable {p : ℕ} [Fact p.Prime]

omit [Finite G] [Fact p.Prime] in
/-- A quotient is a `p`-group when the ambient group is generated by the
kernel and a `p`-subgroup. -/
theorem quotient_isPGroup_of_sup_eq_top
    (K P : Subgroup G) [K.Normal]
    (hP : IsPGroup p P)
    (hgenerate : K ⊔ P = ⊤) :
    IsPGroup p (G ⧸ K) := by
  let π : G →* G ⧸ K := QuotientGroup.mk' K
  have hmap : P.map π = ⊤ := by
    have h :=
      congrArg (fun H : Subgroup G ↦ H.map π) hgenerate
    have hkernel : K.map π = ⊥ := by
      dsimp only [π]
      exact QuotientGroup.map_mk'_self K
    have htop : (⊤ : Subgroup G).map π = ⊤ :=
      Subgroup.map_top_of_surjective π
        (QuotientGroup.mk'_surjective K)
    rw [Subgroup.map_sup, hkernel, bot_sup_eq, htop] at h
    exact h
  have hpImage : IsPGroup p (P.map π) := hP.map π
  rw [hmap] at hpImage
  exact hpImage.of_equiv Subgroup.topEquiv

omit [Fact p.Prime] in
/-- If `G/K` is a `p`-group, the index of every subgroup containing `K`
divides a power of `p`. -/
theorem index_dvd_prime_power_of_normal_le_of_quotient_isPGroup
    (K I : Subgroup G) [K.Normal]
    (hKI : K ≤ I)
    (hquotient : IsPGroup p (G ⧸ K)) :
    ∃ n : ℕ, I.index ∣ p ^ n := by
  obtain ⟨n, hn⟩ :=
    (isPGroup_iff_card_dvd_pow.mp hquotient)
  refine
    ⟨n,
      (Subgroup.index_dvd_of_le
        (H := K) (K := I) hKI).trans ?_⟩
  simpa only [Subgroup.index_eq_card] using hn

/-- A subgroup above a normal subgroup with `p`-group quotient is the
whole group as soon as its index is prime to `p`. -/
theorem eq_top_of_normal_le_of_quotient_isPGroup
    (K I : Subgroup G) [K.Normal]
    (hKI : K ≤ I)
    (hquotient : IsPGroup p (G ⧸ K))
    (hindex : ¬p ∣ I.index) :
    I = ⊤ := by
  obtain ⟨n, hn⟩ :=
    index_dvd_prime_power_of_normal_le_of_quotient_isPGroup
      K I hKI hquotient
  have hcoprime : Nat.Coprime I.index (p ^ n) :=
    (Fact.out : p.Prime).coprime_pow_of_not_dvd hindex
  have hone : I.index = 1 :=
    Nat.eq_one_of_dvd_coprimes hcoprime (dvd_refl _) hn
  exact Subgroup.index_eq_one.mp hone

end GroupTheory
end McKayConjecture
