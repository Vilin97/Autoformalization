import Mathlib.GroupTheory.GroupAction.Basic
import McKayConjecture.GroupTheory.LayerCentralProduct

/-!
# Subgroups generated by conjugacy orbits of components

Conjugation partitions the components of a group into orbits.  The subgroup
generated by the components in one orbit is normal.  For finite groups,
different orbit subgroups commute, and their product is the whole layer.

These orbit subgroups are not asserted here to be minimal normal subgroups.
-/

noncomputable section

open scoped commutatorElement

universe u

namespace McKayConjecture.GroupTheory

variable (G : Type u) [Group G]

/-- The conjugation orbit space of the components of `G`. -/
abbrev ComponentOrbit :=
  MulAction.orbitRel.Quotient G (ComponentIndex G)

/-- The subgroup generated by all components in a conjugation orbit. -/
def componentOrbitSubgroup (O : ComponentOrbit G) : Subgroup G :=
  ⨆ K : O.orbit, K.1.1

/-- A component lies in the subgroup generated by its conjugation orbit. -/
theorem component_le_componentOrbitSubgroup
    (K : ComponentIndex G) :
    K.1 ≤
      componentOrbitSubgroup G
        (Quotient.mk'' K : ComponentOrbit G) := by
  let KO :
      MulAction.orbitRel.Quotient.orbit
        (Quotient.mk'' K : ComponentOrbit G) :=
    ⟨K, MulAction.orbitRel.Quotient.mem_orbit.mpr rfl⟩
  exact le_iSup
    (fun L :
      MulAction.orbitRel.Quotient.orbit
        (Quotient.mk'' K : ComponentOrbit G) =>
      L.1.1)
    KO

/-- Every orbit-generated component subgroup lies in the layer. -/
theorem componentOrbitSubgroup_le_layer
    (O : ComponentOrbit G) :
    componentOrbitSubgroup G O ≤ layer G := by
  apply iSup_le
  intro K
  exact (show IsComponent K.1.1 from K.1.2).le_layer

/-- The subgroup generated by one conjugation orbit of components is
normal in the ambient group. -/
instance componentOrbitSubgroup_normal
    (O : ComponentOrbit G) :
    (componentOrbitSubgroup G O).Normal := by
  rw [Subgroup.normal_iff_map_conj_eq]
  intro g
  rw [componentOrbitSubgroup, Subgroup.map_iSup]
  apply le_antisymm
  · apply iSup_le
    intro K
    let gK : O.orbit :=
      ⟨g • K.1,
        O.mapsTo_smul_orbit g K.2⟩
    have hmap :
        K.1.1.map (MulAut.conj g).toMonoidHom =
          gK.1.1 := by
      rfl
    change
      K.1.1.map (MulAut.conj g).toMonoidHom ≤
        ⨆ L : O.orbit, L.1.1
    rw [hmap]
    exact le_iSup (fun L : O.orbit => L.1.1) gK
  · apply iSup_le
    intro K
    let ginvK : O.orbit :=
      ⟨g⁻¹ • K.1,
        O.mapsTo_smul_orbit g⁻¹ K.2⟩
    have hmap :
        ginvK.1.1.map (MulAut.conj g).toMonoidHom =
          K.1.1 := by
      change
        ((g • (g⁻¹ • K.1) : ComponentIndex G) :
            Subgroup G) = K.1.1
      rw [smul_inv_smul]
    rw [← hmap]
    exact le_iSup
      (fun L : O.orbit =>
        L.1.1.map (MulAut.conj g).toMonoidHom)
      ginvK

/-- Subgroups generated by different component orbits commute. -/
theorem componentOrbitSubgroup_commutator_eq_bot
    [Finite G] {O P : ComponentOrbit G}
    (hOP : O ≠ P) :
    ⁅componentOrbitSubgroup G O,
        componentOrbitSubgroup G P⁆ =
      (⊥ : Subgroup G) := by
  rw [componentOrbitSubgroup, componentOrbitSubgroup,
    Subgroup.commutator_eq_bot_iff_le_centralizer]
  apply iSup_le
  intro C
  rw [Subgroup.le_centralizer_iff]
  apply iSup_le
  intro D
  rw [← Subgroup.commutator_eq_bot_iff_le_centralizer]
  have hcomponent_ne : C.1 ≠ D.1 := by
    intro hCD
    apply hOP
    calc
      O = Quotient.mk'' C.1 :=
        (MulAction.orbitRel.Quotient.mem_orbit.mp C.2).symm
      _ = Quotient.mk'' D.1 :=
        congrArg
          (fun K : ComponentIndex G =>
            (Quotient.mk'' K : ComponentOrbit G))
          hCD
      _ = P :=
        MulAction.orbitRel.Quotient.mem_orbit.mp D.2
  have hsubgroup_ne : D.1.1 ≠ C.1.1 := by
    intro hDC
    exact hcomponent_ne (Subtype.ext hDC.symm)
  exact
    (show IsComponent D.1.1 from D.1.2).commutator_eq_bot_of_ne
      (show IsComponent C.1.1 from C.1.2)
      hsubgroup_ne

/-- The supremum of the component-orbit subgroups is the layer. -/
theorem iSup_componentOrbitSubgroup_eq_layer :
    (⨆ O : ComponentOrbit G,
        componentOrbitSubgroup G O) =
      layer G := by
  apply le_antisymm
  · apply iSup_le
    intro O
    exact componentOrbitSubgroup_le_layer G O
  · rw [layer_eq_iSup_components]
    apply iSup_le
    intro K
    exact
      (component_le_componentOrbitSubgroup G K).trans
        (le_iSup (componentOrbitSubgroup G)
          (Quotient.mk'' K : ComponentOrbit G))

/-- A finite group has only finitely many conjugation orbits of
components. -/
instance componentOrbit_finite [Finite G] :
    Finite (ComponentOrbit G) :=
  inferInstance

/-- Distinct component-orbit subgroups commute elementwise. -/
theorem componentOrbitSubgroups_pairwise_commute_elements
    [Finite G] :
    Pairwise fun O P : ComponentOrbit G =>
      ∀ x y : G,
        x ∈ componentOrbitSubgroup G O →
        y ∈ componentOrbitSubgroup G P →
        Commute x y := by
  intro O P hOP x y hx hy
  have hbot :
      ⁅componentOrbitSubgroup G O,
          componentOrbitSubgroup G P⁆ =
        (⊥ : Subgroup G) :=
    componentOrbitSubgroup_commutator_eq_bot G hOP
  have hmem : ⁅x, y⁆ ∈ (⊥ : Subgroup G) := by
    rw [← hbot]
    exact Subgroup.commutator_mem_commutator hx hy
  exact commutatorElement_eq_one_iff_commute.mp
    (Subgroup.mem_bot.mp hmem)

/-- Multiplication of the component-orbit subgroups, before restricting
the codomain to the layer. -/
def componentOrbitProductHomToAmbient
    [Finite G] :
    (∀ O : ComponentOrbit G,
      componentOrbitSubgroup G O) →* G := by
  classical
  letI := Fintype.ofFinite (ComponentOrbit G)
  exact Subgroup.noncommPiCoprod
    (componentOrbitSubgroups_pairwise_commute_elements G)

/-- Before codomain restriction, multiplication of the component-orbit
subgroups has range exactly the layer. -/
theorem componentOrbitProductHomToAmbient_range
    [Finite G] :
    (componentOrbitProductHomToAmbient G).range =
      layer G := by
  classical
  letI := Fintype.ofFinite (ComponentOrbit G)
  rw [componentOrbitProductHomToAmbient,
    Subgroup.noncommPiCoprod_range,
    ← iSup_componentOrbitSubgroup_eq_layer]

/-- Multiplication of the component-orbit subgroups as a homomorphism
onto the layer. -/
def componentOrbitProductHom
    [Finite G] :
    (∀ O : ComponentOrbit G,
      componentOrbitSubgroup G O) →* layer G :=
  (componentOrbitProductHomToAmbient G).codRestrict
    (layer G) fun x => by
      rw [← componentOrbitProductHomToAmbient_range G]
      exact ⟨x, rfl⟩

/-- Multiplication of the component-orbit subgroups is surjective onto
the layer. -/
theorem componentOrbitProductHom_surjective
    [Finite G] :
    Function.Surjective (componentOrbitProductHom G) := by
  intro z
  have hz :
      (z : G) ∈
        (componentOrbitProductHomToAmbient G).range := by
    rw [componentOrbitProductHomToAmbient_range G]
    exact z.2
  obtain ⟨x, hx⟩ := hz
  exact ⟨x, Subtype.ext hx⟩

/-- The kernel of orbit-subgroup multiplication is central in the
external direct product. -/
theorem componentOrbitProductHom_ker_le_center
    [Finite G] :
    (componentOrbitProductHom G).ker ≤
      Subgroup.center
        (∀ O : ComponentOrbit G,
          componentOrbitSubgroup G O) := by
  classical
  letI := Fintype.ofFinite (ComponentOrbit G)
  rw [componentOrbitProductHom, MonoidHom.ker_codRestrict]
  exact ker_noncommPiCoprod_le_center
    (componentOrbitSubgroups_pairwise_commute_elements G)

/-- The layer is the quotient of the external direct product of the
component-orbit subgroups by the central multiplication kernel. -/
def componentOrbitProductQuotientEquiv
    [Finite G] :
    ((∀ O : ComponentOrbit G,
        componentOrbitSubgroup G O) ⧸
      (componentOrbitProductHom G).ker) ≃* layer G :=
  QuotientGroup.quotientKerEquivOfSurjective
    (componentOrbitProductHom G)
    (componentOrbitProductHom_surjective G)

end McKayConjecture.GroupTheory
