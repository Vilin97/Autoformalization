import Mathlib.GroupTheory.Nilpotent
import McKayConjecture.GroupTheory.ComponentSubnormal
import McKayConjecture.GroupTheory.NormalQuasisimple

/-!
# Commutation of components

The fundamental component lemma says that a component of a finite group is
either contained in a subnormal subgroup or centralizes it.  We follow the
standard minimal-counterexample proof: take the proper normal closures of
the two subgroups, apply the result inside those normal closures, and finish
the remaining case with the three-subgroups lemma and perfectness.

Consequently distinct components commute, components centralize normal
nilpotent subgroups, and the layer is generated by pairwise commuting
components.
-/

noncomputable section

universe u

namespace McKayConjecture.GroupTheory

variable {G : Type u} [Group G]

private theorem natCard_subgroup_lt
    [Finite G] {H : Subgroup G} (hH : H < ⊤) :
    Nat.card H < Nat.card G := by
  obtain ⟨g, -, hg⟩ := SetLike.exists_of_lt hH
  exact Finite.card_subtype_lt hg

private theorem map_subtype_commutator_eq_bot
    {A B N : Subgroup G} (hA : A ≤ N) (hB : B ≤ N)
    (hcomm :
      ⁅A.subgroupOf N, B.subgroupOf N⁆ = (⊥ : Subgroup N)) :
    ⁅A, B⁆ = ⊥ := by
  have hmap :=
    congrArg (fun L : Subgroup N => L.map N.subtype) hcomm
  simpa only [Subgroup.map_commutator,
    Subgroup.map_subgroupOf_eq_of_le hA,
    Subgroup.map_subgroupOf_eq_of_le hB,
    Subgroup.map_bot] using hmap

/-- A component of a finite group is either contained in a subnormal
subgroup or centralizes it. -/
theorem IsComponent.le_or_commutator_eq_bot_of_isSubnormal
    [Finite G] {C H : Subgroup G}
    (hC : IsComponent C) (hH : H.IsSubnormal) :
    C ≤ H ∨ ⁅C, H⁆ = ⊥ := by
  classical
  refine Nat.strong_induction_on (Nat.card G)
    (p := fun n =>
      ∀ (Y : Type u) [Group Y] [Finite Y],
        Nat.card Y = n →
        ∀ {C H : Subgroup Y},
          IsComponent C → H.IsSubnormal →
            C ≤ H ∨ ⁅C, H⁆ = ⊥) ?_
    G rfl hC hH
  intro n ih Y _ _ hcard C H hC hH
  by_cases hCtop : C = ⊤
  · subst C
    by_cases hHtop : H = ⊤
    · subst H
      exact Or.inl le_rfl
    · have hYq : IsQuasisimple Y :=
        IsQuasisimple.of_mulEquiv Subgroup.topEquiv
          hC.isQuasisimple
      exact Or.inr
        (hYq.commutator_top_subnormal_eq_bot hH hHtop)
  by_cases hHtop : H = ⊤
  · subst H
    exact Or.inl le_top
  let X : Subgroup Y := Subgroup.normalClosure (C : Set Y)
  let Z : Subgroup Y := Subgroup.normalClosure (H : Set Y)
  have hCX : C ≤ X :=
    Subgroup.subset_normalClosure
  have hHZ : H ≤ Z :=
    Subgroup.subset_normalClosure
  have hXproper : X < ⊤ :=
    hC.normalClosure_lt_top hCtop
  have hZproper : Z < ⊤ :=
    normalClosure_lt_top_of_isSubnormal hH hHtop
  have hXcard : Nat.card X < n := by
    rw [← hcard]
    exact natCard_subgroup_lt hXproper
  have hZcard : Nat.card Z < n := by
    rw [← hcard]
    exact natCard_subgroup_lt hZproper
  let I : Subgroup X := (X ⊓ Z).subgroupOf X
  have hCI :
      IsComponent (C.subgroupOf X) :=
    hC.subgroupOf hCX
  have hIsubnormal : I.IsSubnormal := by
    letI : (X ⊓ Z).Normal := inferInstance
    exact (inferInstance : I.Normal).isSubnormal
  obtain hCleI | hcommI :=
    ih (Nat.card X) hXcard X rfl hCI hIsubnormal
  · have hCZ : C ≤ Z := by
      intro c hc
      let cX : X := ⟨c, hCX hc⟩
      have hcCI : cX ∈ C.subgroupOf X := hc
      have hcI : cX ∈ I := hCleI hcCI
      exact hcI.2
    have hCcomponentZ :
        IsComponent (C.subgroupOf Z) :=
      hC.subgroupOf hCZ
    have hHsubnormalZ :
        (H.subgroupOf Z).IsSubnormal :=
      hH.subgroupOf
    obtain hCleH | hcommZH :=
      ih (Nat.card Z) hZcard Z rfl
        hCcomponentZ hHsubnormalZ
    · exact Or.inl fun c hc => by
        let cZ : Z := ⟨c, hCZ hc⟩
        have hcsub : cZ ∈ C.subgroupOf Z := hc
        exact hCleH hcsub
    · exact Or.inr
        (map_subtype_commutator_eq_bot hCZ hHZ hcommZH)
  · right
    have hcommCXZ : ⁅C, X ⊓ Z⁆ = ⊥ :=
      map_subtype_commutator_eq_bot hCX inf_le_left hcommI
    have hZC_le : ⁅Z, C⁆ ≤ X ⊓ Z := by
      have hZX : ⁅Z, X⁆ ≤ X ⊓ Z := by
        rw [inf_comm]
        exact Subgroup.commutator_le_inf (H₁ := Z) (H₂ := X)
      exact
        (Subgroup.commutator_mono le_rfl hCX).trans hZX
    have hZC_C : ⁅⁅Z, C⁆, C⁆ = ⊥ := by
      apply le_bot_iff.mp
      exact
        (Subgroup.commutator_mono hZC_le le_rfl).trans
          (by
            rw [Subgroup.commutator_comm]
            exact le_of_eq hcommCXZ)
    have hCY_C : ⁅⁅C, Z⁆, C⁆ = ⊥ := by
      rw [Subgroup.commutator_comm C Z]
      exact hZC_C
    have hCC_Z : ⁅⁅C, C⁆, Z⁆ = ⊥ :=
      Subgroup.commutator_commutator_eq_bot_of_rotate
        (H₁ := C) (H₂ := C) (H₃ := Z)
        hCY_C hZC_C
    have hCZcomm : ⁅C, Z⁆ = ⊥ := by
      simpa only
        [@Subgroup.commutator_eq_self Y _ C
          hC.isQuasisimple.isPerfect] using hCC_Z
    exact le_bot_iff.mp
      ((Subgroup.commutator_mono le_rfl hHZ).trans
        (le_of_eq hCZcomm))

/-- Equivalent component-in-subnormal-subgroup formulation of the component
lemma. -/
theorem IsComponent.componentOf_or_commutator_eq_bot
    [Finite G] {C H : Subgroup G}
    (hC : IsComponent C) (hH : H.IsSubnormal) :
    IsComponent (C.subgroupOf H) ∨ ⁅C, H⁆ = ⊥ := by
  obtain hCH | hcomm :=
    hC.le_or_commutator_eq_bot_of_isSubnormal hH
  · exact Or.inl (hC.subgroupOf hCH)
  · exact Or.inr hcomm

/-- If one ambient component is contained in another, then they are equal. -/
theorem IsComponent.eq_of_le
    {C D : Subgroup G} (hC : IsComponent C)
    (hD : IsComponent D) (hCD : C ≤ D) :
    C = D := by
  apply le_antisymm hCD
  have hCsub : IsComponent (C.subgroupOf D) :=
    hC.subgroupOf hCD
  have htop : C.subgroupOf D = ⊤ := by
    by_contra hproper
    have hcomm :
        ⁅(⊤ : Subgroup D), C.subgroupOf D⁆ = ⊥ :=
      hD.isQuasisimple.commutator_top_subnormal_eq_bot
        hCsub.isSubnormal hproper
    have hself : ⁅C.subgroupOf D, C.subgroupOf D⁆ = ⊥ := by
      apply le_bot_iff.mp
      exact
        (Subgroup.commutator_mono le_top le_rfl).trans
          (le_of_eq hcomm)
    have hperfect :
        Group.IsPerfect (C.subgroupOf D) :=
      hCsub.isQuasisimple.isPerfect
    have hbot : C.subgroupOf D = ⊥ := by
      rw [← @Subgroup.commutator_eq_self D _
        (C.subgroupOf D) hperfect]
      exact hself
    exact hCsub.ne_bot hbot
  intro d hd
  let dD : D := ⟨d, hd⟩
  have : dD ∈ C.subgroupOf D := by
    rw [htop]
    exact Subgroup.mem_top dD
  exact this

/-- For an ambient component and a subnormal subgroup, being contained in
the subgroup is equivalent to remaining a component inside it. -/
theorem IsComponent.component_subgroupOf_iff_le
    {C H : Subgroup G} (hC : IsComponent C)
    (hH : H.IsSubnormal) :
    IsComponent (C.subgroupOf H) ↔ C ≤ H := by
  constructor
  · intro hCsub
    have hmap :
        IsComponent ((C.subgroupOf H).map H.subtype) :=
      hCsub.map_subtype hH
    have hmap_le_C :
        (C.subgroupOf H).map H.subtype ≤ C := by
      rintro c ⟨cH, hcH, rfl⟩
      exact hcH
    have heq :
        (C.subgroupOf H).map H.subtype = C :=
      hmap.eq_of_le hC hmap_le_C
    rw [← heq]
    exact Subgroup.map_subtype_le _
  · exact hC.subgroupOf

/-- Distinct components of a finite group centralize one another. -/
theorem IsComponent.commutator_eq_bot_of_ne
    [Finite G] {C D : Subgroup G}
    (hC : IsComponent C) (hD : IsComponent D)
    (hne : C ≠ D) :
    ⁅C, D⁆ = ⊥ := by
  obtain hCD | hcomm :=
    hC.le_or_commutator_eq_bot_of_isSubnormal
      hD.isSubnormal
  · exact False.elim (hne (hC.eq_of_le hD hCD))
  · exact hcomm

/-- The set of components is pairwise commuting. -/
theorem components_pairwise_commute [Finite G] :
    (components G).Pairwise
      (fun C D => ⁅C, D⁆ = ⊥) := by
  intro C hC D hD hne
  exact hC.commutator_eq_bot_of_ne hD hne

/-- A component centralizes every normal nilpotent subgroup. -/
theorem IsComponent.commutator_nilpotent_normal_eq_bot
    [Finite G] {C N : Subgroup G}
    (hC : IsComponent C) [N.Normal]
    [Group.IsNilpotent N] :
    ⁅C, N⁆ = ⊥ := by
  obtain hCN | hcomm :=
    hC.le_or_commutator_eq_bot_of_isSubnormal
      (inferInstance : N.Normal).isSubnormal
  · have hCsub : IsComponent (C.subgroupOf N) :=
      hC.subgroupOf hCN
    letI : Nontrivial (C.subgroupOf N) :=
      hCsub.isQuasisimple.nontrivial
    letI : Group.IsPerfect (C.subgroupOf N) :=
      hCsub.isQuasisimple.isPerfect
    exact False.elim
      (Group.IsPerfect.not_isNilpotent (C.subgroupOf N)
        (inferInstance : Group.IsNilpotent (C.subgroupOf N)))
  · exact hcomm

/-- The layer centralizes every normal nilpotent subgroup. -/
theorem layer_commutator_nilpotent_normal_eq_bot
    [Finite G] {N : Subgroup G} [N.Normal]
    [Group.IsNilpotent N] :
    ⁅layer G, N⁆ = ⊥ := by
  rw [Subgroup.commutator_eq_bot_iff_le_centralizer]
  apply layer_le
  intro C hC
  rw [← Subgroup.commutator_eq_bot_iff_le_centralizer]
  exact hC.commutator_nilpotent_normal_eq_bot

/-- Every component is normalized by the layer.  Together with pairwise
commutation and `layer_eq_iSup_components`, this is the internal
central-product form available in the subgroup lattice API. -/
theorem layer_le_normalizer_component
    [Finite G] {C : Subgroup G} (hC : IsComponent C) :
    layer G ≤ Subgroup.normalizer C := by
  apply layer_le
  intro D hD
  by_cases hDC : D = C
  · subst D
    exact C.le_normalizer
  · exact
      (Subgroup.commutator_eq_bot_iff_le_centralizer.mp
        (hD.commutator_eq_bot_of_ne hC hDC)).trans
        (Subgroup.centralizer_le_normalizer (C : Set G))

/-- A component is normal in the layer. -/
theorem IsComponent.normal_subgroupOf_layer
    [Finite G] {C : Subgroup G} (hC : IsComponent C) :
    (C.subgroupOf (layer G)).Normal :=
  Subgroup.normal_subgroupOf_of_le_normalizer
    (layer_le_normalizer_component hC)

/-- The layer is the supremum of its components, explicitly indexed by the
subtype of component subgroups. -/
theorem layer_eq_iSup_components :
    layer G = ⨆ C : components G, C.1 := by
  exact sSup_eq_iSup' (components G)

/-- The layer is generated by the pairwise commuting family of all
components.  This is the subgroup-lattice formulation of saying that the
layer is their central product. -/
theorem layer_generated_by_pairwise_commuting_components [Finite G] :
    layer G = sSup (components G) ∧
      (components G).Pairwise
        (fun C D => ⁅C, D⁆ = ⊥) :=
  ⟨rfl, components_pairwise_commute⟩

end McKayConjecture.GroupTheory
