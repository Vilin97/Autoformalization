import McKayConjecture.GroupTheory.AlternatingSixSchurFiveNormalizerDicyclic
import McKayConjecture.GroupTheory.AlternatingSixSylowFiveNormalizer

/-!
# Product decomposition of the presented-cover five-normalizer

The central order-three subgroup generated by `c²` meets the explicit
dicyclic subgroup trivially.  Their product has order sixty and lies in
the normalizer of the explicit Sylow-five subgroup.  The central-extension
normalizer formula shows that this inclusion is an equality.
-/

noncomputable section

namespace McKayConjecture
namespace GroupTheory

local instance alternatingSixSchurFiveProductFactPrime :
    Fact (Nat.Prime 5) :=
  ⟨Nat.prime_five⟩

private theorem alternatingSixSchurFiveCentralSq_pow_three :
    (alternatingSixSchurFiveCentral ^ 2) ^ 3 = 1 := by
  calc
    (alternatingSixSchurFiveCentral ^ 2) ^ 3 =
        alternatingSixSchurFiveCentral ^ 6 := by group
    _ = 1 := alternatingSixSchurPresentedK0_pow_six

/-- The central `C₃` factor generated by `c²`. -/
def alternatingSixSchurFiveCentralThreeHom :
    Multiplicative (ZMod 3) →*
      AlternatingSixSchurPresentedGroup where
  toFun i :=
    QuaternionGroup.zmodPower
      (alternatingSixSchurFiveCentral ^ 2)
      alternatingSixSchurFiveCentralSq_pow_three
      (Multiplicative.toAdd i)
  map_one' :=
    QuaternionGroup.zmodPower_zero
      (alternatingSixSchurFiveCentral ^ 2)
      alternatingSixSchurFiveCentralSq_pow_three
  map_mul' i j := by
    exact
      QuaternionGroup.zmodPower_add
        (alternatingSixSchurFiveCentral ^ 2)
        alternatingSixSchurFiveCentralSq_pow_three
        (Multiplicative.toAdd i)
        (Multiplicative.toAdd j)

theorem alternatingSixSchurFiveCentralThreeHom_injective :
    Function.Injective alternatingSixSchurFiveCentralThreeHom := by
  intro i j hij
  apply Multiplicative.toAdd.injective
  apply
    QuaternionGroup.zmodPower_injective_of_orderOf_eq
      (alternatingSixSchurFiveCentral ^ 2)
      alternatingSixSchurFiveCentralSq_pow_three
      orderOf_alternatingSixSchurFiveCentral_sq
  exact hij

theorem alternatingSixSchurFiveCentralThreeHom_mem_center
    (i : Multiplicative (ZMod 3)) :
    alternatingSixSchurFiveCentralThreeHom i ∈
      Subgroup.center AlternatingSixSchurPresentedGroup := by
  exact
    (Subgroup.zpowers_le.mpr
      ((Subgroup.center
        AlternatingSixSchurPresentedGroup).pow_mem
        alternatingSixSchurFiveCentral_mem_center 2))
      (QuaternionGroup.zmodPower_mem_zpowers
        (alternatingSixSchurFiveCentral ^ 2)
        alternatingSixSchurFiveCentralSq_pow_three
        (Multiplicative.toAdd i))

/-- Product of the central `C₃` and explicit dicyclic factors. -/
def cyclicThreeTimesQuaternionFiveToAlternatingSixSchur :
    Multiplicative (ZMod 3) × QuaternionGroup 5 →*
      AlternatingSixSchurPresentedGroup where
  toFun y :=
    alternatingSixSchurFiveCentralThreeHom y.1 *
      quaternionFiveToAlternatingSixSchur y.2
  map_one' := by simp
  map_mul' a b := by
    rw [Prod.fst_mul, Prod.snd_mul, map_mul, map_mul]
    have hcomm :
        Commute
          (quaternionFiveToAlternatingSixSchur a.2)
          (alternatingSixSchurFiveCentralThreeHom b.1) :=
      Subgroup.mem_center_iff.mp
        (alternatingSixSchurFiveCentralThreeHom_mem_center b.1)
        (quaternionFiveToAlternatingSixSchur a.2)
    calc
      alternatingSixSchurFiveCentralThreeHom a.1 *
            alternatingSixSchurFiveCentralThreeHom b.1 *
            (quaternionFiveToAlternatingSixSchur a.2 *
              quaternionFiveToAlternatingSixSchur b.2) =
          alternatingSixSchurFiveCentralThreeHom a.1 *
            (alternatingSixSchurFiveCentralThreeHom b.1 *
              quaternionFiveToAlternatingSixSchur a.2) *
            quaternionFiveToAlternatingSixSchur b.2 := by group
      _ =
          alternatingSixSchurFiveCentralThreeHom a.1 *
            (quaternionFiveToAlternatingSixSchur a.2 *
              alternatingSixSchurFiveCentralThreeHom b.1) *
            quaternionFiveToAlternatingSixSchur b.2 := by
              rw [hcomm.eq]
      _ = _ := by group

private theorem multiplicativeZModThree_cube
    (i : Multiplicative (ZMod 3)) :
    i ^ 3 = 1 := by
  simpa [Fintype.card_multiplicative, ZMod.card] using
    (pow_card_eq_one (x := i))

theorem cyclicThreeTimesQuaternionFiveToAlternatingSixSchur_injective :
    Function.Injective
      cyclicThreeTimesQuaternionFiveToAlternatingSixSchur := by
  apply
    (MonoidHom.ker_eq_bot_iff
      cyclicThreeTimesQuaternionFiveToAlternatingSixSchur).mp
  rw [Subgroup.eq_bot_iff_forall]
  rintro ⟨i, g⟩ hg
  rw [MonoidHom.mem_ker] at hg
  change
    alternatingSixSchurFiveCentralThreeHom i *
        quaternionFiveToAlternatingSixSchur g =
      1 at hg
  have hquaternion :
      quaternionFiveToAlternatingSixSchur g =
        (alternatingSixSchurFiveCentralThreeHom i)⁻¹ := by
    calc
      quaternionFiveToAlternatingSixSchur g =
          1 * quaternionFiveToAlternatingSixSchur g := by simp
      _ =
          (alternatingSixSchurFiveCentralThreeHom i)⁻¹ *
            (alternatingSixSchurFiveCentralThreeHom i *
              quaternionFiveToAlternatingSixSchur g) := by group
      _ = (alternatingSixSchurFiveCentralThreeHom i)⁻¹ := by
        rw [hg]
        simp
  have hcube :
      (quaternionFiveToAlternatingSixSchur g) ^ 3 = 1 := by
    rw [hquaternion]
    calc
      (alternatingSixSchurFiveCentralThreeHom i)⁻¹ ^ 3 =
          (alternatingSixSchurFiveCentralThreeHom (i⁻¹)) ^ 3 := by
            rw [map_inv]
      _ =
          alternatingSixSchurFiveCentralThreeHom ((i⁻¹) ^ 3) := by
            rw [map_pow]
      _ = 1 := by
        rw [multiplicativeZModThree_cube]
        simp
  have hdivThree :
      orderOf (quaternionFiveToAlternatingSixSchur g) ∣ 3 :=
    orderOf_dvd_of_pow_eq_one hcube
  have hdivTwenty :
      orderOf (quaternionFiveToAlternatingSixSchur g) ∣ 20 := by
    apply (orderOf_map_dvd
      quaternionFiveToAlternatingSixSchur g).trans
    have h := orderOf_dvd_natCard g
    simpa [Nat.card_eq_fintype_card,
      QuaternionGroup.card] using h
  have horderDvdOne :
      orderOf (quaternionFiveToAlternatingSixSchur g) ∣ 1 := by
    have :=
      Nat.dvd_gcd hdivThree hdivTwenty
    norm_num at this ⊢
    exact this
  have horder :
      orderOf (quaternionFiveToAlternatingSixSchur g) = 1 :=
    Nat.dvd_one.mp horderDvdOne
  have hgOne :
      quaternionFiveToAlternatingSixSchur g = 1 :=
    orderOf_eq_one_iff.mp horder
  have gOne : g = 1 := by
    apply quaternionFiveToAlternatingSixSchur_injective
    simpa using hgOne
  have hiImage :
      alternatingSixSchurFiveCentralThreeHom i = 1 := by
    rw [gOne, map_one, mul_one] at hg
    exact hg
  have iOne : i = 1 := by
    apply alternatingSixSchurFiveCentralThreeHom_injective
    simpa using hiImage
  exact Prod.ext iOne gOne

/-- The explicit Sylow-five subgroup generated by the corrected element
`p`. -/
def alternatingSixSchurFiveSylow :
    Sylow 5 AlternatingSixSchurPresentedGroup :=
  Sylow.ofCard
    (Subgroup.zpowers alternatingSixSchurFiveElement)
    (by
      rw [Nat.card_zpowers,
        orderOf_alternatingSixSchurFiveElement,
        natCard_alternatingSixSchurPresentedGroup]
      have hfactor :
          Nat.factorization 2160 5 = 1 := by
        conv_lhs =>
          rw [show
            2160 = 2 ^ 4 * 3 ^ 3 * 5 by norm_num]
        rw [Nat.factorization_mul (by norm_num) (by norm_num),
          Nat.factorization_mul (by norm_num) (by norm_num),
          Finsupp.add_apply, Finsupp.add_apply,
          Nat.prime_two.factorization_pow,
          Nat.prime_three.factorization_pow,
          Nat.prime_five.factorization]
        norm_num [Finsupp.single_apply]
      rw [hfactor]
      norm_num)

@[simp]
theorem coe_alternatingSixSchurFiveSylow :
    (alternatingSixSchurFiveSylow :
        Subgroup AlternatingSixSchurPresentedGroup) =
      Subgroup.zpowers alternatingSixSchurFiveElement :=
  rfl

private theorem alternatingSixSchurFiveDicyclicGenerator_commute_fiveElement :
    Commute alternatingSixSchurFiveDicyclicGenerator
      alternatingSixSchurFiveElement := by
  rw [alternatingSixSchurFiveDicyclicGenerator]
  exact
    (Commute.refl alternatingSixSchurFiveElement).pow_left 3
      |>.mul_left
        (((alternatingSixSchurFiveCentral_commute
          alternatingSixSchurFiveElement).pow_left 3))

private theorem alternatingSixSchurFiveDicyclicGenerator_mem_normalizer :
    alternatingSixSchurFiveDicyclicGenerator ∈
      Subgroup.normalizer
        (alternatingSixSchurFiveSylow :
          Set AlternatingSixSchurPresentedGroup) := by
  apply Subgroup.mem_normalizer_fintype
  intro y hy
  change
    y ∈ Subgroup.zpowers alternatingSixSchurFiveElement at hy
  change
    alternatingSixSchurFiveDicyclicGenerator * y *
        alternatingSixSchurFiveDicyclicGenerator⁻¹ ∈
      Subgroup.zpowers alternatingSixSchurFiveElement
  obtain ⟨z, rfl⟩ :=
    Subgroup.mem_zpowers_iff.mp hy
  rw [(alternatingSixSchurFiveDicyclicGenerator_commute_fiveElement
    |>.zpow_right z).mul_inv_cancel]
  exact Subgroup.mem_zpowers_iff.mpr ⟨z, rfl⟩

private theorem alternatingSixSchurFiveNormalizerElement_mem_normalizer :
    alternatingSixSchurFiveNormalizerElement ∈
      Subgroup.normalizer
        (alternatingSixSchurFiveSylow :
          Set AlternatingSixSchurPresentedGroup) := by
  apply Subgroup.mem_normalizer_fintype
  intro y hy
  change
    y ∈ Subgroup.zpowers alternatingSixSchurFiveElement at hy
  change
    alternatingSixSchurFiveNormalizerElement * y *
        alternatingSixSchurFiveNormalizerElement⁻¹ ∈
      Subgroup.zpowers alternatingSixSchurFiveElement
  obtain ⟨z, rfl⟩ :=
    Subgroup.mem_zpowers_iff.mp hy
  change
    MulAut.conj alternatingSixSchurFiveNormalizerElement
        (alternatingSixSchurFiveElement ^ z) ∈
      Subgroup.zpowers alternatingSixSchurFiveElement
  rw [map_zpow]
  change
    (alternatingSixSchurFiveNormalizerElement *
        alternatingSixSchurFiveElement *
        alternatingSixSchurFiveNormalizerElement⁻¹) ^ z ∈
      Subgroup.zpowers alternatingSixSchurFiveElement
  rw [alternatingSixSchurFiveNormalizerElement_conj]
  exact
    (Subgroup.zpowers alternatingSixSchurFiveElement).zpow_mem
      ((Subgroup.zpowers alternatingSixSchurFiveElement).inv_mem
        (Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩))
      z

private theorem quaternionFiveToAlternatingSixSchur_mem_normalizer
    (g : QuaternionGroup 5) :
    quaternionFiveToAlternatingSixSchur g ∈
      Subgroup.normalizer
        (alternatingSixSchurFiveSylow :
          Set AlternatingSixSchurPresentedGroup) := by
  rcases g with i | i
  · change
      QuaternionGroup.zmodPower
          alternatingSixSchurFiveDicyclicGenerator
          alternatingSixSchurFiveDicyclicGenerator_pow_ten i ∈
        _
    exact
      (Subgroup.zpowers_le.mpr
        alternatingSixSchurFiveDicyclicGenerator_mem_normalizer)
        (QuaternionGroup.zmodPower_mem_zpowers
          alternatingSixSchurFiveDicyclicGenerator
          alternatingSixSchurFiveDicyclicGenerator_pow_ten i)
  · change
      alternatingSixSchurFiveNormalizerElement *
          QuaternionGroup.zmodPower
            alternatingSixSchurFiveDicyclicGenerator
            alternatingSixSchurFiveDicyclicGenerator_pow_ten i ∈
        _
    exact
      (Subgroup.normalizer
        (alternatingSixSchurFiveSylow :
          Set AlternatingSixSchurPresentedGroup)).mul_mem
        alternatingSixSchurFiveNormalizerElement_mem_normalizer
        ((Subgroup.zpowers_le.mpr
          alternatingSixSchurFiveDicyclicGenerator_mem_normalizer)
          (QuaternionGroup.zmodPower_mem_zpowers
            alternatingSixSchurFiveDicyclicGenerator
            alternatingSixSchurFiveDicyclicGenerator_pow_ten i))

theorem cyclicThreeTimesQuaternionFiveToAlternatingSixSchur_mem_normalizer
    (y : Multiplicative (ZMod 3) × QuaternionGroup 5) :
    cyclicThreeTimesQuaternionFiveToAlternatingSixSchur y ∈
      Subgroup.normalizer
        (alternatingSixSchurFiveSylow :
          Set AlternatingSixSchurPresentedGroup) := by
  apply
    (Subgroup.normalizer
      (alternatingSixSchurFiveSylow :
        Set AlternatingSixSchurPresentedGroup)).mul_mem
  · exact
      Subgroup.center_le_normalizer
        (alternatingSixSchurFiveSylow :
          Set AlternatingSixSchurPresentedGroup)
        (alternatingSixSchurFiveCentralThreeHom_mem_center y.1)
  · exact
      quaternionFiveToAlternatingSixSchur_mem_normalizer y.2

/-- The product map with codomain restricted to the exact normalizer. -/
def cyclicThreeTimesQuaternionFiveToSchurFiveNormalizer :
    Multiplicative (ZMod 3) × QuaternionGroup 5 →*
      Subgroup.normalizer
        (alternatingSixSchurFiveSylow :
          Set AlternatingSixSchurPresentedGroup) :=
  cyclicThreeTimesQuaternionFiveToAlternatingSixSchur.codRestrict
    (Subgroup.normalizer
      (alternatingSixSchurFiveSylow :
        Set AlternatingSixSchurPresentedGroup))
    cyclicThreeTimesQuaternionFiveToAlternatingSixSchur_mem_normalizer

/-- The Sylow subgroup downstairs obtained from the explicit lift. -/
def alternatingSixSchurFiveTargetSylow :
    Sylow 5 AlternatingSix :=
  alternatingSixSchurFiveSylow.mapSurjective
    alternatingSixSchurProjection_surjective

private theorem alternatingSixSchurFiveSylow_eq_centralExtensionLift :
    alternatingSixSchurFiveSylow =
      alternatingSixSchurCentralExtension.sylowLift
        alternatingSixSchurFiveTargetSylow := by
  apply
    (alternatingSixSchurCentralExtension.eq_sylowLift_iff_mapSurjective_eq
      alternatingSixSchurFiveTargetSylow
      alternatingSixSchurFiveSylow).mpr
  rfl

@[simp]
theorem natCard_normalizer_alternatingSixSchurFiveSylow :
    Nat.card
        (Subgroup.normalizer
          (alternatingSixSchurFiveSylow :
            Set AlternatingSixSchurPresentedGroup)) =
      60 := by
  rw [alternatingSixSchurFiveSylow_eq_centralExtensionLift,
    alternatingSixSchurCentralExtension.sylowNormalizer_card_eq]
  change
    Nat.card alternatingSixSchurProjection.ker *
        Nat.card
          (Subgroup.normalizer
            (alternatingSixSchurFiveTargetSylow :
              Set AlternatingSix)) =
      60
  rw [natCard_alternatingSixSchurProjection_ker,
    show
      Nat.card
          (Subgroup.normalizer
            (alternatingSixSchurFiveTargetSylow :
              Set AlternatingSix)) =
        10 by
          simpa using
            (natCard_normalizer_sylowFive_alternatingSix
              alternatingSixSchurFiveTargetSylow)]

theorem cyclicThreeTimesQuaternionFiveToSchurFiveNormalizer_bijective :
    Function.Bijective
      cyclicThreeTimesQuaternionFiveToSchurFiveNormalizer := by
  apply
    (Nat.bijective_iff_injective_and_card
      cyclicThreeTimesQuaternionFiveToSchurFiveNormalizer).mpr
  constructor
  · intro a b hab
    apply
      cyclicThreeTimesQuaternionFiveToAlternatingSixSchur_injective
    exact congrArg Subtype.val hab
  · rw [natCard_normalizer_alternatingSixSchurFiveSylow,
      Nat.card_prod, Nat.card_eq_fintype_card,
      Nat.card_eq_fintype_card,
      Fintype.card_multiplicative, ZMod.card,
      QuaternionGroup.card]

/-- The exact presented-cover normalizer is `C₃ × Dic₅`. -/
def cyclicThreeTimesQuaternionFiveEquivSchurFiveNormalizer :
    Multiplicative (ZMod 3) × QuaternionGroup 5 ≃*
      Subgroup.normalizer
        (alternatingSixSchurFiveSylow :
          Set AlternatingSixSchurPresentedGroup) :=
  MulEquiv.ofBijective
    cyclicThreeTimesQuaternionFiveToSchurFiveNormalizer
    cyclicThreeTimesQuaternionFiveToSchurFiveNormalizer_bijective

end GroupTheory
end McKayConjecture
