import McKayConjecture.GroupTheory.LayerLocalSubgroup

/-!
# The subgroup generated by local subgroups of components

The subgroup generated in `G` by chosen coordinate subgroups `M K ≤ K`
is contained in the image of their product inside the layer.  The
central-kernel properness theorem therefore shows that this generated
subgroup is proper in the layer whenever the coordinate subgroups
contain their centers and one coordinate is proper.
-/

noncomputable section

universe u

namespace McKayConjecture
namespace GroupTheory

variable (G : Type u) [Group G] [Finite G]

/-- The ambient subgroup generated by a chosen subgroup in every
component. -/
def componentLocalSubgroup
    (M : ∀ K : ComponentIndex G, Subgroup K.1) :
    Subgroup G :=
  ⨆ K, (M K).map K.1.subtype

omit [Finite G] in
/-- Each chosen coordinate subgroup lies in the generated ambient
subgroup. -/
theorem map_componentLocal_le
    (M : ∀ K : ComponentIndex G, Subgroup K.1)
    (K : ComponentIndex G) :
    (M K).map K.1.subtype ≤
      componentLocalSubgroup G M :=
  le_iSup
    (fun L : ComponentIndex G =>
      (M L).map L.1.subtype) K

/-- The subgroup generated coordinatewise is contained in the image of
the coordinate product inside the layer. -/
theorem componentLocalSubgroup_le_ambientLayerLocalSubgroup
    (M : ∀ K : ComponentIndex G, Subgroup K.1) :
    componentLocalSubgroup G M ≤
      ambientLayerLocalSubgroup G M := by
  classical
  letI := Fintype.ofFinite (ComponentIndex G)
  apply iSup_le
  intro K
  rintro x ⟨m, hm, rfl⟩
  let y : ∀ L : ComponentIndex G, L.1 :=
    Pi.mulSingle K m
  have hy : y ∈ piLocalSubgroup M := by
    rw [mem_piLocalSubgroup]
    intro L
    by_cases hLK : L = K
    · subst L
      simpa [y] using hm
    · simp [y, hLK]
  let z : layer G :=
    layerProductHom G y
  have hz :
      z ∈ layerLocalSubgroup G M :=
    ⟨y, hy, rfl⟩
  refine ⟨z, hz, ?_⟩
  change
    ((layerProductHom G y : layer G) : G) =
      (m : K.1)
  change
    Subgroup.noncommPiCoprod
        (components_pairwise_commute_elements
          (G := G)) y =
      (m : G)
  rw [show y = Pi.mulSingle K m by rfl,
    Subgroup.noncommPiCoprod_mulSingle]

/-- The generated coordinate subgroup lies in the layer. -/
theorem componentLocalSubgroup_le_layer
    (M : ∀ K : ComponentIndex G, Subgroup K.1) :
    componentLocalSubgroup G M ≤
      layer G :=
  (componentLocalSubgroup_le_ambientLayerLocalSubgroup
    G M).trans
      (ambientLayerLocalSubgroup_le_layer G M)

/-- If every coordinate local subgroup contains its center and at least
one coordinate is proper, their generated ambient subgroup is proper in
the layer. -/
theorem componentLocalSubgroup_lt_layer
    (M : ∀ K : ComponentIndex G, Subgroup K.1)
    (hcenter :
      ∀ K, Subgroup.center K.1 ≤ M K)
    (hproper :
      ∃ K, M K < ⊤) :
    componentLocalSubgroup G M <
      layer G :=
  lt_of_le_of_lt
    (componentLocalSubgroup_le_ambientLayerLocalSubgroup
      G M)
    (ambientLayerLocalSubgroup_lt_layer
      G M hcenter hproper)

end GroupTheory
end McKayConjecture
