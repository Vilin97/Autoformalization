import Mathlib.GroupTheory.GroupAction.FixedPoints
import Mathlib.GroupTheory.Sylow
import McKayConjecture.Character.PRegularDecomposition

/-!
# Fixed-point congruences in Brauer induction

The local counting step in Bernstein's proof of Brauer induction is the
following elementary fact.  If a `p`-element acts on a finite set, then the
cardinality of its fixed-point set is congruent modulo `p` to the
cardinality of the whole set.  In particular, prime-to-`p` cardinality is
preserved.

The final theorems specialize this to the action on cosets of a subgroup
which contains a Sylow `p`-subgroup.  This is the precise fixed-point count
used for the elementary subgroup inside the centralizer of a `p`-regular
element.
-/

noncomputable section

namespace McKayConjecture

open MulAction

variable {p : ℕ}
variable {G : Type*} [Group G]

namespace IsPElement

/-- The cyclic subgroup generated by a `p`-element is a `p`-group. -/
theorem isPGroup_zpowers {g : G}
    (hg : IsPElement p g) :
    IsPGroup p (Subgroup.zpowers g) := by
  obtain ⟨n, hn⟩ := hg
  apply IsPGroup.of_card_dvd_pow (n := n)
  rw [Nat.card_zpowers]
  exact orderOf_dvd_of_pow_eq_one hn

end IsPElement

/-- The points fixed by the cyclic subgroup generated by `g` are exactly
the points fixed by `g`. -/
theorem fixedPoints_zpowers_eq_fixedBy
    {α : Type*} [MulAction G α] (g : G) :
    fixedPoints (Subgroup.zpowers g) α =
      fixedBy α g := by
  ext a
  constructor
  · intro ha
    exact ha ⟨g, Subgroup.mem_zpowers g⟩
  · intro ha z
    obtain ⟨j, hj⟩ :=
      Subgroup.mem_zpowers_iff.mp z.property
    change (z : G) • a = a
    rw [← hj]
    exact
      mem_fixedBy_zpow ha j

/-- A `p`-element acting on a finite set has a number of fixed points
congruent modulo `p` to the cardinality of the set. -/
theorem IsPElement.card_modEq_card_fixedBy
    [Fact p.Prime]
    {α : Type*} [MulAction G α] [Finite α]
    {g : G} (hg : IsPElement p g) :
    Nat.card α ≡ Nat.card (fixedBy α g) [MOD p] := by
  have hmod :=
    hg.isPGroup_zpowers.card_modEq_card_fixedPoints α
  rw [Nat.card_congr
    (Equiv.setCongr
      (fixedPoints_zpowers_eq_fixedBy
        (α := α) g))] at hmod
  exact hmod

/-- If the acted-on set has cardinality prime to `p`, then so does the
fixed-point set of a `p`-element. -/
theorem IsPElement.coprime_card_fixedBy
    [hp : Fact p.Prime]
    {α : Type*} [MulAction G α] [Finite α]
    {g : G} (hg : IsPElement p g)
    (hα : p.Coprime (Nat.card α)) :
    p.Coprime (Nat.card (fixedBy α g)) := by
  rw [hp.out.coprime_iff_not_dvd] at hα ⊢
  intro hfixed
  apply hα
  exact
    Nat.modEq_zero_iff_dvd.mp
      ((hg.card_modEq_card_fixedBy).trans
        (Nat.modEq_zero_iff_dvd.mpr hfixed))

/-- The coset space of a subgroup containing a Sylow `p`-subgroup has
cardinality prime to `p`. -/
theorem coprime_card_quotient_of_sylow_le
    [Finite G] [hp : Fact p.Prime]
    (P : Sylow p G) (E : Subgroup G)
    (hPE : (P : Subgroup G) ≤ E) :
    p.Coprime (Nat.card (G ⧸ E)) := by
  rw [← E.index_eq_card, hp.out.coprime_iff_not_dvd]
  intro hpE
  exact
    P.not_dvd_index
      (hpE.trans (Subgroup.index_dvd_of_le hPE))

/-- Bernstein's fixed-point count on a coset space: a `p`-element has
prime-to-`p` many fixed cosets whenever the stabilizing subgroup contains
a Sylow `p`-subgroup. -/
theorem coprime_card_fixedBy_quotient_of_sylow_le
    [Finite G] [Fact p.Prime]
    (P : Sylow p G) (E : Subgroup G)
    (hPE : (P : Subgroup G) ≤ E)
    {g : G} (hg : IsPElement p g) :
    p.Coprime
      (Nat.card (fixedBy (G ⧸ E) g)) :=
  hg.coprime_card_fixedBy
    (coprime_card_quotient_of_sylow_le
      P E hPE)

end McKayConjecture
