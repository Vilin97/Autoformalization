import McKayConjecture.Character.ClassFunction
import McKayConjecture.Character.CyclicExtensionConstruction

/-!
# Twisted traces for a cyclic coprime action

Let `H` be a normal subgroup and let `g` normalize it.  If a
representation of `H` is extended across a cyclic quotient generated by
`g`, its character on the coset `gH` restricts to a class function on
`C_H(g)`.  In normalized-intertwiner coordinates this class function is

`c ↦ trace(P ρ(c))`.

This is the elementary construction at the start of the cyclic case of
the Glauberman correspondence.  The deeper step, not asserted here, is
that under the coprime hypotheses this twisted class function is a signed
irreducible character of `C_H(g)`.
-/

noncomputable section

namespace McKayConjecture

universe u

variable {G : Type u} [Group G]

/-- The fixed-point subgroup `C_H(g)` for the automorphism of `H`
induced by an ambient element `g`. -/
abbrev cyclicFixedPoints (H : Subgroup G) (g : G) :
    Subgroup G :=
  H ⊓ Subgroup.centralizer {g}

/-- The canonical inclusion `C_H(g) ↪ H`. -/
def cyclicFixedPointsInclusion (H : Subgroup G) (g : G) :
    cyclicFixedPoints H g →* H :=
  Subgroup.inclusion inf_le_left

@[simp]
theorem cyclicFixedPointsInclusion_apply_coe
    (H : Subgroup G) (g : G)
    (c : cyclicFixedPoints H g) :
    ((cyclicFixedPointsInclusion H g c : H) : G) = c :=
  rfl

/-- The trace of an ambient representation on the coset `g C_H(g)` is
a class function of `C_H(g)`. -/
def cosetTraceClassFunction
    (V : FDRep ℂ G) (H : Subgroup G) (g : G) :
    ClassFunction (cyclicFixedPoints H g) :=
  ⟨fun c ↦ V.character (g * (c : G)), by
    intro c x
    change
      V.character
          (g * ((x : G) * (c : G) * (x : G)⁻¹)) =
        V.character (g * (c : G))
    have hxcomm :
        (x : G) * g = g * (x : G) :=
      Subgroup.mem_centralizer_singleton_iff.mp
        x.property.2
    have harg :
        g * ((x : G) * (c : G) * (x : G)⁻¹) =
          (x : G) * (g * (c : G)) * (x : G)⁻¹ := by
      calc
        g * ((x : G) * (c : G) * (x : G)⁻¹) =
            (g * (x : G)) * (c : G) * (x : G)⁻¹ := by
              group
        _ = ((x : G) * g) * (c : G) * (x : G)⁻¹ := by
              rw [hxcomm]
        _ = (x : G) * (g * (c : G)) * (x : G)⁻¹ := by
              group
    rw [harg]
    exact FDRep.char_conj V (g * (c : G)) (x : G)⟩

@[simp]
theorem cosetTraceClassFunction_apply
    (V : FDRep ℂ G) (H : Subgroup G) (g : G)
    (c : cyclicFixedPoints H g) :
    cosetTraceClassFunction V H g c =
      V.character (g * (c : G)) :=
  rfl

namespace RepresentationTheory

variable {H : Subgroup G} [H.Normal]
variable {V : Type} [AddCommGroup V] [Module ℂ V]
variable [FiniteDimensional ℂ V]
variable {ρ : Representation ℂ H V} {g : G}
variable {P : (Module.End ℂ V)ˣ}

/-- The cyclic-extension twisted class function, constructed from a
normalized conjugation unit. -/
def cyclicTwistedTraceClassFunction
    (hP : ∀ h : H, P * ρ.asGroupHom h =
      ρ.asGroupHom
        (ClassFunction.conjByMulEquiv
          (K := G) (H := H) g h) * P)
    (hPt : ∀ (t : ℤ) (ht : g ^ t ∈ H),
      P ^ t = ρ.asGroupHom ⟨g ^ t, ht⟩)
    (hgen : ∀ k : G, ∃ i : ℤ, (g ^ i)⁻¹ * k ∈ H) :
    McKayConjecture.ClassFunction
      (cyclicFixedPoints H g) :=
  cosetTraceClassFunction
    (FDRep.of
      (cyclicExtension
        (K := G) (H := H) (F := ℂ) (V := V)
        ρ g P hP hPt hgen))
    H g

/-- In normalized-intertwiner coordinates, the cyclic twisted class
function is `c ↦ trace(P ρ(c))`. -/
@[simp]
theorem cyclicTwistedTraceClassFunction_apply
    (hP : ∀ h : H, P * ρ.asGroupHom h =
      ρ.asGroupHom
        (ClassFunction.conjByMulEquiv
          (K := G) (H := H) g h) * P)
    (hPt : ∀ (t : ℤ) (ht : g ^ t ∈ H),
      P ^ t = ρ.asGroupHom ⟨g ^ t, ht⟩)
    (hgen : ∀ k : G, ∃ i : ℤ, (g ^ i)⁻¹ * k ∈ H)
    (c : cyclicFixedPoints H g) :
    cyclicTwistedTraceClassFunction hP hPt hgen c =
      LinearMap.trace ℂ V
        ((P : Module.End ℂ V) *
          ρ
            (cyclicFixedPointsInclusion H g c)) := by
  have hc : (c : G) ∈ H :=
    c.property.1
  have hi :
      (g ^ (1 : ℤ))⁻¹ * (g * (c : G)) ∈ H := by
    simpa using hc
  rw [cyclicTwistedTraceClassFunction,
    cosetTraceClassFunction_apply]
  change
    LinearMap.trace ℂ V
        (↑(cyclicExtensionUnit
          (K := G) (H := H) (F := ℂ) (V := V)
          ρ g P hgen (g * (c : G)))) =
      LinearMap.trace ℂ V
        ((P : Module.End ℂ V) *
          ρ
            (cyclicFixedPointsInclusion H g c))
  rw [cyclicExtensionUnit_eq
    (K := G) (H := H) (F := ℂ) (V := V)
    hPt hgen 1 hi]
  simp only [zpow_one, Units.val_mul]
  congr 2
  change ρ _ = ρ _
  congr 1
  apply Subtype.ext
  simp

end RepresentationTheory
end McKayConjecture
