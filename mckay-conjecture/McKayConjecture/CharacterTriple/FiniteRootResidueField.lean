import Mathlib.Algebra.CharP.Quotient
import Mathlib.RingTheory.Ideal.GoingUp
import Mathlib.RingTheory.Ideal.Int
import Mathlib.RingTheory.Ideal.Quotient.HasFiniteQuotients
import McKayConjecture.CharacterTriple.FiniteProjectiveIntegralLattice

/-!
# Finite residue fields of the cyclotomic coefficient ring

For a prime `q` and a positive integer `n`, the cyclotomic coefficient
ring generated by the complex `n`th roots of unity has a maximal ideal
above `(q)`.  Its residue ring is therefore a finite field of
characteristic `q`.

This file also records the reduction map from complex `n`th roots of
unity to units of an arbitrary residue ring.  The construction is kept
separate from projective representations so it can be reused for other
integral models.
-/

noncomputable section

namespace McKayConjecture
namespace CharacterTriple
namespace FiniteRootCoefficientRing

section ResidueRoot

variable (n : ℕ) [NeZero n]

/-- Reduction of complex `n`th roots of unity modulo an ideal of the
cyclotomic coefficient ring. -/
def residueRootHom
    (I : Ideal (FiniteRootCoefficientRing n)) :
    rootsOfUnity n ℂ →*
      (FiniteRootCoefficientRing n ⧸ I)ˣ :=
  (Units.map (Ideal.Quotient.mk I).toMonoidHom).comp
    (rootUnitHom n)

@[simp]
theorem residueRootHom_apply
    (I : Ideal (FiniteRootCoefficientRing n))
    (z : rootsOfUnity n ℂ) :
    residueRootHom n I z =
      Units.map (Ideal.Quotient.mk I).toMonoidHom
        (rootUnit n z) :=
  rfl

@[simp]
theorem residueRootHom_val
    (I : Ideal (FiniteRootCoefficientRing n))
    (z : rootsOfUnity n ℂ) :
    ((residueRootHom n I z :
        (FiniteRootCoefficientRing n ⧸ I)ˣ) :
      FiniteRootCoefficientRing n ⧸ I) =
      Ideal.Quotient.mk I (root n z) :=
  rfl

end ResidueRoot

section PrimeResidue

variable (q n : ℕ) [Fact q.Prime] [NeZero n]

private theorem exists_maximalIdeal_above_prime :
    ∃ Q : Ideal (FiniteRootCoefficientRing n),
      Q.IsMaximal ∧
        Q.LiesOver (Ideal.span {(q : ℤ)}) := by
  letI :
      Module.Finite ℤ (FiniteRootCoefficientRing n) :=
    moduleFinite n
  letI :
      (Ideal.span {(q : ℤ)}).IsMaximal :=
    Int.ideal_span_isMaximal_of_prime q
  exact
    Ideal.exists_maximal_ideal_liesOver_of_isIntegral
      (S := FiniteRootCoefficientRing n)
      (Ideal.span {(q : ℤ)})

/-- A chosen maximal ideal of the cyclotomic coefficient ring lying
above the rational prime `(q)`. -/
def maximalIdealAbovePrime :
    Ideal (FiniteRootCoefficientRing n) :=
  Classical.choose (exists_maximalIdeal_above_prime q n)

instance maximalIdealAbovePrime_isMaximal :
    (maximalIdealAbovePrime q n).IsMaximal :=
  (Classical.choose_spec
    (exists_maximalIdeal_above_prime q n)).1

instance maximalIdealAbovePrime_liesOver :
    (maximalIdealAbovePrime q n).LiesOver
      (Ideal.span {(q : ℤ)}) :=
  (Classical.choose_spec
    (exists_maximalIdeal_above_prime q n)).2

theorem maximalIdealAbovePrime_ne_bot :
    maximalIdealAbovePrime q n ≠ ⊥ := by
  exact
    Ideal.ne_bot_of_liesOver_of_ne_bot
      (p := Ideal.span {(q : ℤ)})
      (by simp [(Fact.out : q.Prime).ne_zero])
      (maximalIdealAbovePrime q n)

/-- The chosen finite residue field of the cyclotomic coefficient ring
at a maximal ideal above `q`. -/
abbrev ResidueFieldAbovePrime :=
  FiniteRootCoefficientRing n ⧸
    maximalIdealAbovePrime q n

noncomputable instance residueFieldAbovePrime_field :
    Field (ResidueFieldAbovePrime q n) :=
  Ideal.Quotient.field (maximalIdealAbovePrime q n)

noncomputable instance residueFieldAbovePrime_finite :
    Finite (ResidueFieldAbovePrime q n) := by
  letI :
      Module.Finite ℤ (FiniteRootCoefficientRing n) :=
    moduleFinite n
  exact
    Ring.HasFiniteQuotients.finiteQuotient
      (maximalIdealAbovePrime_ne_bot q n)

noncomputable instance residueFieldAbovePrime_charP :
    CharP (ResidueFieldAbovePrime q n) q := by
  apply
    (CharP.charP_iff_prime_eq_zero
      (R := ResidueFieldAbovePrime q n)
      (Fact.out : q.Prime)).2
  rw [show (q : ResidueFieldAbovePrime q n) =
      Ideal.Quotient.mk (maximalIdealAbovePrime q n)
        (algebraMap ℤ (FiniteRootCoefficientRing n) q) by
        simp]
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  exact
    (Ideal.mem_of_liesOver
      (P := maximalIdealAbovePrime q n)
      (p := Ideal.span {(q : ℤ)})
      (q : ℤ)).mp
      (Ideal.subset_span (Set.mem_singleton (q : ℤ)))

/-- The chosen reduction of complex `n`th roots of unity to the finite
residue field above `q`. -/
def rootToResidueField :
    rootsOfUnity n ℂ →*
      (ResidueFieldAbovePrime q n)ˣ :=
  residueRootHom n (maximalIdealAbovePrime q n)

@[simp]
theorem rootToResidueField_apply
    (z : rootsOfUnity n ℂ) :
    rootToResidueField q n z =
      residueRootHom n (maximalIdealAbovePrime q n) z :=
  rfl

end PrimeResidue

end FiniteRootCoefficientRing
end CharacterTriple
end McKayConjecture
