module

public import SplittingSpheres.Foundations.RelationMappingClass

/-!
# Endpoint-relation quotients modulo selected representatives

Starting from the group quotient generated by an endpoint relation, this file imposes a second
normal-closure quotient which declares a selected set of representatives trivial.  A group
homomorphism descends through both quotients when it preserves the endpoint relation and sends
selected source representatives to selected target representatives.

The construction is purely algebraic.  In particular, no injectivity statement is made for an
induced quotient homomorphism.
-/

@[expose] public section

open Function Set

namespace SplittingSpheres

universe uG uH uK

variable {G : Type uG} [Group G]
variable {H : Type uH} [Group H]
variable {K : Type uK} [Group K]

/-- The endpoint-relation quotient with every representative in `T` additionally declared
trivial. -/
abbrev RelationMappingClassMod (R : G → G → Prop) (T : Set G) :=
  RelationMappingClass R ⧸
    Subgroup.normalClosure (relationMappingClassMk R '' T)

/-- The canonical homomorphism from representatives to the endpoint-relation quotient modulo
the selected set. -/
def relationMappingClassModMk (R : G → G → Prop) (T : Set G) :
    G →* RelationMappingClassMod R T :=
  (QuotientGroup.mk'
    (Subgroup.normalClosure (relationMappingClassMk R '' T))).comp
      (relationMappingClassMk R)

/-- Formula for the canonical map as the composite of the two quotient maps. -/
@[simp]
theorem relationMappingClassModMk_apply (R : G → G → Prop) (T : Set G) (f : G) :
    relationMappingClassModMk R T f =
      QuotientGroup.mk'
        (Subgroup.normalClosure (relationMappingClassMk R '' T))
        (relationMappingClassMk R f) :=
  rfl

@[simp]
theorem relationMappingClassModMk_one (R : G → G → Prop) (T : Set G) :
    relationMappingClassModMk R T 1 = 1 :=
  map_one _

/-- Every selected representative is trivial in the second quotient. -/
theorem relationMappingClassModMk_eq_one
    {R : G → G → Prop} {T : Set G} {f : G} (hf : f ∈ T) :
    relationMappingClassModMk R T f = 1 := by
  change ((relationMappingClassMk R f : RelationMappingClass R) :
    RelationMappingClassMod R T) = 1
  exact (QuotientGroup.eq_one_iff _).mpr <|
    Subgroup.subset_normalClosure (mem_image_of_mem _ hf)

/-- Mapping selected representatives into the target selected set sends the normal subgroup
defining the source second quotient into the normal subgroup defining the target quotient. -/
theorem relationMappingClassSelectedNormal_le_comap
    {R : G → G → Prop} {S : H → H → Prop}
    (Phi : G →* H) (hPhi : PreservesEndpointRelation R S Phi)
    (T : Set G) (U : Set H) (hTU : MapsTo Phi T U) :
    Subgroup.normalClosure (relationMappingClassMk R '' T) ≤
      (Subgroup.normalClosure (relationMappingClassMk S '' U)).comap
        (relationMappingClassMap Phi hPhi) := by
  apply Subgroup.normalClosure_le_normal
  rintro q ⟨f, hf, rfl⟩
  change relationMappingClassMap Phi hPhi (relationMappingClassMk R f) ∈
    Subgroup.normalClosure (relationMappingClassMk S '' U)
  rw [relationMappingClassMap_mk]
  exact Subgroup.subset_normalClosure ⟨Phi f, hTU hf, rfl⟩

/-- A relation-preserving homomorphism which maps `T` into `U` induces a homomorphism on the
corresponding second quotients. -/
def relationMappingClassModMap
    {R : G → G → Prop} {S : H → H → Prop}
    (Phi : G →* H) (hPhi : PreservesEndpointRelation R S Phi)
    (T : Set G) (U : Set H) (hTU : MapsTo Phi T U) :
    RelationMappingClassMod R T →* RelationMappingClassMod S U :=
  QuotientGroup.map
    (Subgroup.normalClosure (relationMappingClassMk R '' T))
    (Subgroup.normalClosure (relationMappingClassMk S '' U))
    (relationMappingClassMap Phi hPhi)
    (relationMappingClassSelectedNormal_le_comap Phi hPhi T U hTU)

/-- Formula for the induced homomorphism on a representative in the first quotient. -/
@[simp]
theorem relationMappingClassModMap_mk
    {R : G → G → Prop} {S : H → H → Prop}
    (Phi : G →* H) (hPhi : PreservesEndpointRelation R S Phi)
    (T : Set G) (U : Set H) (hTU : MapsTo Phi T U)
    (q : RelationMappingClass R) :
    relationMappingClassModMap Phi hPhi T U hTU
        (QuotientGroup.mk'
          (Subgroup.normalClosure (relationMappingClassMk R '' T)) q) =
      QuotientGroup.mk'
        (Subgroup.normalClosure (relationMappingClassMk S '' U))
        (relationMappingClassMap Phi hPhi q) :=
  QuotientGroup.map_mk' _ _ _ _ q

/-- Formula for the induced homomorphism on an original group representative. -/
@[simp]
theorem relationMappingClassModMap_apply
    {R : G → G → Prop} {S : H → H → Prop}
    (Phi : G →* H) (hPhi : PreservesEndpointRelation R S Phi)
    (T : Set G) (U : Set H) (hTU : MapsTo Phi T U) (f : G) :
    relationMappingClassModMap Phi hPhi T U hTU
        (relationMappingClassModMk R T f) =
      relationMappingClassModMk S U (Phi f) := by
  rfl

@[simp]
theorem relationMappingClassModMap_one
    {R : G → G → Prop} {S : H → H → Prop}
    (Phi : G →* H) (hPhi : PreservesEndpointRelation R S Phi)
    (T : Set G) (U : Set H) (hTU : MapsTo Phi T U) :
    relationMappingClassModMap Phi hPhi T U hTU 1 = 1 :=
  map_one _

/-- The homomorphism induced by the identity on `G` is the identity on the second quotient. -/
theorem relationMappingClassModMap_id (R : G → G → Prop) (T : Set G) :
    relationMappingClassModMap (MonoidHom.id G)
        (preservesEndpointRelation_id R) T T (mapsTo_id T) =
      MonoidHom.id (RelationMappingClassMod R T) := by
  apply MonoidHom.ext
  intro q
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective
    (Subgroup.normalClosure (relationMappingClassMk R '' T)) q
  rw [relationMappingClassModMap_mk, relationMappingClassMap_id]
  rfl

/-- Induced maps on the two-stage quotients compose in the same order as their underlying group
homomorphisms. -/
theorem relationMappingClassModMap_comp
    {R : G → G → Prop} {S : H → H → Prop} {Q : K → K → Prop}
    (Phi : G →* H) (Psi : H →* K)
    (hPhi : PreservesEndpointRelation R S Phi)
    (hPsi : PreservesEndpointRelation S Q Psi)
    (A : Set G) (B : Set H) (C : Set K)
    (hAB : MapsTo Phi A B) (hBC : MapsTo Psi B C) :
    relationMappingClassModMap (Psi.comp Phi) (hPsi.comp hPhi) A C
        (hBC.comp hAB) =
      (relationMappingClassModMap Psi hPsi B C hBC).comp
        (relationMappingClassModMap Phi hPhi A B hAB) := by
  apply MonoidHom.ext
  intro q
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective
    (Subgroup.normalClosure (relationMappingClassMk R '' A)) q
  obtain ⟨f, rfl⟩ := QuotientGroup.mk'_surjective (endpointRelationNormal R) x
  rfl

end SplittingSpheres
