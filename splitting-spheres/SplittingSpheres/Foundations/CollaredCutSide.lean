module

public import Mathlib.Geometry.Manifold.ContMDiff.Atlas

/-!
# Direct smooth atlases on collared cut sides

This file constructs reusable point-set and atlas infrastructure for a closed side of a cut.
The cut side is the intrinsic subtype of a closed ambient subset.  Its explicit atlas consists of
native ambient charts away from the new boundary and charts lifted from a one-sided collar at that
boundary.

For compact applications, the robust closed subset is generally the closure of an open side.
This file deliberately does not identify that closure with the open side plus the seam: such an
identity is an application-level density and range statement.  The collar-half range, atlas
coverage, chart compatibility, and inverse-coordinate smoothness of the ambient inclusion remain
visible hypotheses.

When an application already has two complementary open sides in the full compact ambient space,
it can avoid a closure calculation entirely: the two closed cut sides are the complements of the
opposite open sides.  A point-set homeomorphism to a separated model may be used to identify those
subsets, while the smooth atlas below is still constructed intrinsically from ambient and collar
charts.

In particular, no smooth structure is transported through an unrelated homeomorphism.
-/

@[expose] public section

noncomputable section

open Function Set Topology TopologicalSpace
open scoped ContDiff Manifold

universe u v w

namespace SplittingSpheres

variable {M P H : Type*}
variable [TopologicalSpace M] [TopologicalSpace P] [TopologicalSpace H]

/-- A cut side is represented intrinsically as a subset of the ambient space. -/
abbrev CollaredCutSide (C : Set M) := C

/-- The robust intrinsic closed side generated by an open side in an ambient compact space. -/
def collaredCutSideClosure (U : Set M) : Set M := closure U

/-- Inclusion of any closed side in its ambient space is a closed embedding. -/
theorem isClosedEmbedding_collaredCutSideSubtypeVal (C : Set M)
    (hC : IsClosed C) :
    IsClosedEmbedding (Subtype.val : CollaredCutSide C → M) :=
  hC.isClosedEmbedding_subtypeVal

/-- In particular, a closure-defined cut side is closed embedded in the ambient space. -/
theorem isClosedEmbedding_collaredCutSideClosureSubtypeVal (U : Set M) :
    IsClosedEmbedding
      (Subtype.val : CollaredCutSide (collaredCutSideClosure U) → M) :=
  isClosed_closure.isClosedEmbedding_subtypeVal

/-- The part of a closed cut side away from its new boundary. -/
def collaredCutSideOffBoundary (C B : Set M) : Set M := C \ B

/-- The native off-boundary part, bundled as an open subset of the ambient space. -/
def collaredCutSideOffBoundaryOpens (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B)) : Opens M :=
  ⟨collaredCutSideOffBoundary C B, hopen⟩

/-- Include the native off-boundary region in the closed cut side. -/
def collaredCutSideOffBoundaryMap (C B : Set M)
    (x : ↑(collaredCutSideOffBoundary C B)) : CollaredCutSide C :=
  ⟨x.1, x.2.1⟩

omit [TopologicalSpace M] in
@[simp]
theorem collaredCutSideOffBoundaryMap_coe (C B : Set M)
    (x : ↑(collaredCutSideOffBoundary C B)) :
    (collaredCutSideOffBoundaryMap C B x : M) = x.1 :=
  rfl

omit [TopologicalSpace M] in
theorem range_collaredCutSideOffBoundaryMap (C B : Set M) :
    range (collaredCutSideOffBoundaryMap C B) =
      Subtype.val ⁻¹' collaredCutSideOffBoundary C B := by
  ext z
  constructor
  · rintro ⟨x, rfl⟩
    exact x.2
  · intro hz
    exact ⟨⟨z.1, hz⟩, Subtype.ext rfl⟩

/-- The native region is open embedded in the cut side whenever it is ambient-open. -/
theorem isOpenEmbedding_collaredCutSideOffBoundaryMap (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B)) :
    IsOpenEmbedding (collaredCutSideOffBoundaryMap C B) := by
  refine ⟨?_, ?_⟩
  · apply Topology.IsEmbedding.subtypeVal.of_comp_iff.mp
    change IsEmbedding (Subtype.val : ↑(collaredCutSideOffBoundary C B) → M)
    exact Topology.IsEmbedding.subtypeVal
  · rw [range_collaredCutSideOffBoundaryMap]
    exact hopen.preimage continuous_subtype_val

/-- Lift a collar-half map whose ambient range lies in the selected closed side. -/
def collaredCutSideHalfCollarMap (C : Set M) (c : P → M)
    (hc : range c ⊆ C) (p : P) : CollaredCutSide C :=
  ⟨c p, hc (mem_range_self p)⟩

omit [TopologicalSpace M] [TopologicalSpace P] in
@[simp]
theorem collaredCutSideHalfCollarMap_coe (C : Set M) (c : P → M)
    (hc : range c ⊆ C) (p : P) :
    (collaredCutSideHalfCollarMap C c hc p : M) = c p :=
  rfl

omit [TopologicalSpace M] [TopologicalSpace P] in
theorem range_collaredCutSideHalfCollarMap (C : Set M) (c : P → M)
    (hc : range c ⊆ C) :
    range (collaredCutSideHalfCollarMap C c hc) =
      Subtype.val ⁻¹' range c := by
  ext z
  constructor
  · rintro ⟨p, rfl⟩
    exact mem_range_self p
  · rintro ⟨p, hp⟩
    exact ⟨p, Subtype.ext hp⟩

/-- A useful point-set criterion for a collar half to be open embedded in the closed side.
The equation says that its ambient range is the intersection of the side with an ambient-open
collar range. -/
theorem isOpenEmbedding_collaredCutSideHalfCollarMap
    (C : Set M) (c : P → M) (hc : range c ⊆ C)
    (hemb : IsEmbedding c) (V : Set M) (hV : IsOpen V)
    (hrange : range c = V ∩ C) :
    IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc) := by
  refine ⟨?_, ?_⟩
  · apply Topology.IsEmbedding.subtypeVal.of_comp_iff.mp
    change IsEmbedding c
    exact hemb
  · rw [range_collaredCutSideHalfCollarMap, hrange]
    change IsOpen (Subtype.val ⁻¹' (V ∩ C))
    have heq : (Subtype.val : CollaredCutSide C → M) ⁻¹' (V ∩ C) =
        (Subtype.val : CollaredCutSide C → M) ⁻¹' V := by
      ext z
      simp
    rw [heq]
    exact hV.preimage continuous_subtype_val

/-- The new boundary inside the cut-side subtype. -/
def collaredCutSideBoundary (C B : Set M) : Set (CollaredCutSide C) :=
  Subtype.val ⁻¹' B

omit [TopologicalSpace M] in
theorem compl_range_collaredCutSideOffBoundaryMap (C B : Set M) :
    (range (collaredCutSideOffBoundaryMap C B))ᶜ =
      collaredCutSideBoundary C B := by
  rw [range_collaredCutSideOffBoundaryMap]
  ext z
  simp [collaredCutSideOffBoundary, collaredCutSideBoundary]

section Atlas

variable [Nonempty H] [ChartedSpace H M] [ChartedSpace H P]

/-- Indices for the direct cut-side atlas: ambient-native charts off the new boundary and
one-sided collar charts at the new boundary. -/
inductive CollaredCutSideAtlasIndex (C B : Set M) (P : Type*) where
  | native : ↑(collaredCutSideOffBoundary C B) →
      CollaredCutSideAtlasIndex C B P
  | collar : P → CollaredCutSideAtlasIndex C B P

/-- A native ambient chart restricted to the off-boundary region and lifted to the cut side. -/
def collaredCutSideNativeChart (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B))
    (x : ↑(collaredCutSideOffBoundary C B)) :
    OpenPartialHomeomorph (CollaredCutSide C) H :=
  let U := collaredCutSideOffBoundaryOpens C B hopen
  let x' : ↑U := ⟨x.1, x.2⟩
  let j : ↑U → CollaredCutSide C := fun y ↦ ⟨y.1, y.2.1⟩
  have hj : IsOpenEmbedding j := by
    refine ⟨?_, ?_⟩
    · apply Topology.IsEmbedding.subtypeVal.of_comp_iff.mp
      change IsEmbedding (Subtype.val : ↑U → M)
      exact Topology.IsEmbedding.subtypeVal
    · have hrange : range j =
          (Subtype.val : CollaredCutSide C → M) ⁻¹' U := by
        ext z
        constructor
        · rintro ⟨y, rfl⟩
          exact y.2
        · intro hz
          exact ⟨⟨z.1, hz⟩, Subtype.ext rfl⟩
      rw [hrange]
      exact U.2.preimage continuous_subtype_val
  ((chartAt H x.1).subtypeRestr (s := U) ⟨x'⟩).lift_openEmbedding hj

/-- A chart from the one-sided collar source, lifted along its open embedding into the cut
side. -/
def collaredCutSideCollarChart (C : Set M) (c : P → M)
    (hc : range c ⊆ C)
    (hcollar : IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc))
    (p : P) : OpenPartialHomeomorph (CollaredCutSide C) H :=
  (chartAt H p).lift_openEmbedding hcollar

/-- The explicit chart represented by a cut-side atlas index. -/
def collaredCutSideAtlasChart (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B))
    (c : P → M) (hc : range c ⊆ C)
    (hcollar : IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc)) :
    CollaredCutSideAtlasIndex C B P →
      OpenPartialHomeomorph (CollaredCutSide C) H
  | .native x => collaredCutSideNativeChart C B hopen x
  | .collar p => collaredCutSideCollarChart C c hc hcollar p

theorem mem_collaredCutSideNativeChart_source (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B))
    (x : ↑(collaredCutSideOffBoundary C B)) :
    collaredCutSideOffBoundaryMap C B x ∈
      (collaredCutSideNativeChart (H := H) C B hopen x).source := by
  simp only [collaredCutSideNativeChart,
    OpenPartialHomeomorph.lift_openEmbedding_source,
    OpenPartialHomeomorph.subtypeRestr_source]
  exact ⟨⟨x.1, x.2⟩, mem_chart_source H x.1, rfl⟩

omit [ChartedSpace H M] in
theorem mem_collaredCutSideCollarChart_source (C : Set M) (c : P → M)
    (hc : range c ⊆ C)
    (hcollar : IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc))
    (p : P) :
    collaredCutSideHalfCollarMap C c hc p ∈
      (collaredCutSideCollarChart (H := H) C c hc hcollar p).source := by
  rw [collaredCutSideCollarChart,
    OpenPartialHomeomorph.lift_openEmbedding_source]
  exact ⟨p, mem_chart_source H p, rfl⟩

/-- The native and collar charts cover provided every side point is either off the new boundary
or in the chosen half-collar range. -/
theorem collaredCutSideAtlasChart_covers (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B))
    (c : P → M) (hc : range c ⊆ C)
    (hcollar : IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc))
    (hcover : ∀ z : CollaredCutSide C,
      z.1 ∈ collaredCutSideOffBoundary C B ∨ z.1 ∈ range c)
    (z : CollaredCutSide C) :
    ∃ i : CollaredCutSideAtlasIndex C B P,
      z ∈ (collaredCutSideAtlasChart (H := H)
        C B hopen c hc hcollar i).source := by
  rcases hcover z with hz | hz
  · let x : ↑(collaredCutSideOffBoundary C B) := ⟨z.1, hz⟩
    refine ⟨CollaredCutSideAtlasIndex.native x, ?_⟩
    have hx : collaredCutSideOffBoundaryMap C B x = z := Subtype.ext rfl
    rw [← hx]
    exact mem_collaredCutSideNativeChart_source (H := H) C B hopen x
  · obtain ⟨p, hp⟩ := hz
    refine ⟨CollaredCutSideAtlasIndex.collar p, ?_⟩
    have hp' : collaredCutSideHalfCollarMap C c hc p = z :=
      Subtype.ext hp
    rw [← hp']
    exact mem_collaredCutSideCollarChart_source (H := H)
      C c hc hcollar p

noncomputable def collaredCutSidePreferredChart (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B))
    (c : P → M) (hc : range c ⊆ C)
    (hcollar : IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc))
    (hcover : ∀ z : CollaredCutSide C,
      z.1 ∈ collaredCutSideOffBoundary C B ∨ z.1 ∈ range c)
    (z : CollaredCutSide C) :
    OpenPartialHomeomorph (CollaredCutSide C) H :=
  collaredCutSideAtlasChart (H := H) C B hopen c hc hcollar
    (collaredCutSideAtlasChart_covers (H := H)
      C B hopen c hc hcollar hcover z).choose

/-- The charted-space structure generated directly from ambient-native off-boundary charts and
one-sided collar charts. -/
@[instance_reducible]
noncomputable def collaredCutSideChartedSpace (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B))
    (c : P → M) (hc : range c ⊆ C)
    (hcollar : IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc))
    (hcover : ∀ z : CollaredCutSide C,
      z.1 ∈ collaredCutSideOffBoundary C B ∨ z.1 ∈ range c) :
    ChartedSpace H (CollaredCutSide C) where
  atlas := range (collaredCutSideAtlasChart (H := H)
    C B hopen c hc hcollar)
  chartAt := collaredCutSidePreferredChart (H := H)
    C B hopen c hc hcollar hcover
  mem_chart_source z :=
    (collaredCutSideAtlasChart_covers (H := H)
      C B hopen c hc hcollar hcover z).choose_spec
  chart_mem_atlas _ := ⟨_, rfl⟩

section Manifold

variable {𝕜 E : Type*} [NontriviallyNormedField 𝕜]
variable [NormedAddCommGroup E] [NormedSpace 𝕜 E]
variable (I : ModelWithCorners 𝕜 E H) (n : ℕ∞ω)

/-- Conditional manifold recognition for the direct cut-side atlas.  The only compatibility
input is between its two explicit chart classes. -/
theorem isManifold_collaredCutSideChartedSpace (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B))
    (c : P → M) (hc : range c ⊆ C)
    (hcollar : IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc))
    (hcover : ∀ z : CollaredCutSide C,
      z.1 ∈ collaredCutSideOffBoundary C B ∨ z.1 ∈ range c)
    (hcompat : ∀ i j : CollaredCutSideAtlasIndex C B P,
      (collaredCutSideAtlasChart (H := H)
        C B hopen c hc hcollar i).symm.trans
          (collaredCutSideAtlasChart (H := H)
            C B hopen c hc hcollar j) ∈
        contDiffGroupoid n I) :
    letI := collaredCutSideChartedSpace (H := H)
      C B hopen c hc hcollar hcover
    IsManifold I n (CollaredCutSide C) := by
  let _ := collaredCutSideChartedSpace (H := H)
    C B hopen c hc hcollar hcover
  refine { compatible := ?_ }
  intro e e' he he'
  obtain ⟨i, rfl⟩ := he
  obtain ⟨j, rfl⟩ := he'
  exact hcompat i j

section Inclusion

variable {E' H' : Type*} [NormedAddCommGroup E'] [NormedSpace 𝕜 E']
variable [TopologicalSpace H'] [ChartedSpace H' M]
variable (J : ModelWithCorners 𝕜 E' H')

/-- Smoothness of the intrinsic inclusion follows from smoothness in the inverse coordinates of
each explicit atlas chart.  This is a genuine chart-level criterion: it does not transport a
smooth structure through an unrelated homeomorphism. -/
theorem contMDiff_collaredCutSideSubtypeVal (C B : Set M)
    (hopen : IsOpen (collaredCutSideOffBoundary C B))
    (c : P → M) (hc : range c ⊆ C)
    (hcollar : IsOpenEmbedding (collaredCutSideHalfCollarMap C c hc))
    (hcover : ∀ z : CollaredCutSide C,
      z.1 ∈ collaredCutSideOffBoundary C B ∨ z.1 ∈ range c)
    (hcompat : ∀ i j : CollaredCutSideAtlasIndex C B P,
      (collaredCutSideAtlasChart (H := H)
        C B hopen c hc hcollar i).symm.trans
          (collaredCutSideAtlasChart (H := H)
            C B hopen c hc hcollar j) ∈
        contDiffGroupoid n I)
    (hinclusion : ∀ i : CollaredCutSideAtlasIndex C B P,
      ContMDiffOn I J n
        ((Subtype.val : CollaredCutSide C → M) ∘
          (collaredCutSideAtlasChart (H := H)
            C B hopen c hc hcollar i).symm)
        (collaredCutSideAtlasChart (H := H)
          C B hopen c hc hcollar i).target) :
    letI := collaredCutSideChartedSpace (H := H)
      C B hopen c hc hcollar hcover
    ContMDiff I J n (Subtype.val : CollaredCutSide C → M) := by
  let _ := collaredCutSideChartedSpace (H := H)
    C B hopen c hc hcollar hcover
  let hman : IsManifold I n (CollaredCutSide C) :=
    isManifold_collaredCutSideChartedSpace I n
      C B hopen c hc hcollar hcover hcompat
  let _ : IsManifold I n (CollaredCutSide C) := hman
  apply contMDiff_of_locally_contMDiffOn
  intro z
  obtain ⟨i, hzi⟩ := collaredCutSideAtlasChart_covers (H := H)
    C B hopen c hc hcollar hcover z
  let φ := collaredCutSideAtlasChart (H := H)
    C B hopen c hc hcollar i
  refine ⟨φ.source, φ.open_source, hzi, ?_⟩
  have hφatlas : φ ∈ atlas H (CollaredCutSide C) := by
    exact ⟨i, rfl⟩
  have hφmax : φ ∈ IsManifold.maximalAtlas I n (CollaredCutSide C) :=
    IsManifold.mem_maximalAtlas_iff.mpr
      (StructureGroupoid.subset_maximalAtlas (contDiffGroupoid n I) hφatlas)
  have hφsmooth : ContMDiffOn I I n φ φ.source :=
    contMDiffOn_of_mem_maximalAtlas hφmax
  have hcomp := (hinclusion i).comp hφsmooth (fun y hy ↦ φ.map_source hy)
  apply hcomp.congr
  intro y hy
  change (Subtype.val : CollaredCutSide C → M) y =
    (Subtype.val : CollaredCutSide C → M) (φ.symm (φ y))
  rw [φ.left_inv hy]

end Inclusion

end Manifold

end Atlas

end SplittingSpheres
