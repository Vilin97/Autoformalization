module

public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.GroupTheory.QuotientGroup.Defs

/-!
# Group quotients generated by an endpoint relation

Given an arbitrary relation `R` on a group, this file quotients by the normal closure of all
endpoint differences `f / g` with `R f g`.  No equivalence or compatibility assumptions are
placed on `R`; taking the normal closure is exactly what makes the result a group quotient.

This is the algebraic core of constrained mapping-class constructions, where `R f g` records the
existence of a geometric family whose every slice satisfies an additional condition.
-/

@[expose] public section

open Function Set

namespace SplittingSpheres

universe uG uH uK

variable {G : Type uG} [Group G]
variable {H : Type uH} [Group H]
variable {K : Type uK} [Group K]

/-- Endpoint differences generated by an arbitrary relation on a group. -/
def endpointDifferenceRelators (R : G → G → Prop) : Set G :=
  {r | ∃ f g, R f g ∧ r = f / g}

/-- The normal subgroup generated by all endpoint differences for `R`. -/
def endpointRelationNormal (R : G → G → Prop) : Subgroup G :=
  Subgroup.normalClosure (endpointDifferenceRelators R)

instance endpointRelationNormal_normal (R : G → G → Prop) :
    (endpointRelationNormal R).Normal :=
  Subgroup.normalClosure_normal

/-- The group obtained by imposing every endpoint relation `R f g`. -/
abbrev RelationMappingClass (R : G → G → Prop) :=
  G ⧸ endpointRelationNormal R

/-- The canonical homomorphism to the quotient generated by `R`. -/
def relationMappingClassMk (R : G → G → Prop) :
    G →* RelationMappingClass R :=
  QuotientGroup.mk' (endpointRelationNormal R)

@[simp]
theorem relationMappingClassMk_one (R : G → G → Prop) :
    relationMappingClassMk R 1 = 1 :=
  map_one _

/-- Every declared endpoint pair has equal image in the generated quotient. -/
theorem relationMappingClassMk_eq {R : G → G → Prop} {f g : G} (hfg : R f g) :
    relationMappingClassMk R f = relationMappingClassMk R g := by
  change (f : RelationMappingClass R) = g
  apply QuotientGroup.eq_iff_div_mem.mpr
  exact Subgroup.subset_normalClosure ⟨f, g, hfg, rfl⟩

/-- A homomorphism preserves endpoint relations when it sends every related pair to a related
pair. -/
def PreservesEndpointRelation (R : G → G → Prop) (S : H → H → Prop)
    (Phi : G →* H) : Prop :=
  ∀ ⦃f g : G⦄, R f g → S (Phi f) (Phi g)

/-- Relation preservation sends each generating endpoint difference to a target generator. -/
theorem mapsTo_endpointDifferenceRelators
    {R : G → G → Prop} {S : H → H → Prop} (Phi : G →* H)
    (hPhi : PreservesEndpointRelation R S Phi) :
    MapsTo Phi (endpointDifferenceRelators R) (endpointDifferenceRelators S) := by
  rintro r ⟨f, g, hfg, rfl⟩
  refine ⟨Phi f, Phi g, hPhi hfg, ?_⟩
  exact map_div Phi f g

/-- Relation preservation extends from the endpoint differences to their normal closures. -/
theorem endpointRelationNormal_le_comap
    {R : G → G → Prop} {S : H → H → Prop} (Phi : G →* H)
    (hPhi : PreservesEndpointRelation R S Phi) :
    endpointRelationNormal R ≤ (endpointRelationNormal S).comap Phi := by
  apply Subgroup.normalClosure_le_normal
  intro r hr
  exact Subgroup.subset_normalClosure (mapsTo_endpointDifferenceRelators Phi hPhi hr)

/-- The homomorphism induced on the quotients generated by endpoint relations. -/
def relationMappingClassMap
    {R : G → G → Prop} {S : H → H → Prop} (Phi : G →* H)
    (hPhi : PreservesEndpointRelation R S Phi) :
    RelationMappingClass R →* RelationMappingClass S :=
  QuotientGroup.map (endpointRelationNormal R) (endpointRelationNormal S) Phi
    (endpointRelationNormal_le_comap Phi hPhi)

/-- Formula for the induced map on a canonical representative. -/
@[simp]
theorem relationMappingClassMap_mk
    {R : G → G → Prop} {S : H → H → Prop} (Phi : G →* H)
    (hPhi : PreservesEndpointRelation R S Phi) (f : G) :
    relationMappingClassMap Phi hPhi (relationMappingClassMk R f) =
      relationMappingClassMk S (Phi f) :=
  QuotientGroup.map_mk' _ _ _ _ f

@[simp]
theorem relationMappingClassMap_one
    {R : G → G → Prop} {S : H → H → Prop} (Phi : G →* H)
    (hPhi : PreservesEndpointRelation R S Phi) :
    relationMappingClassMap Phi hPhi 1 = 1 :=
  map_one _

/-- The identity homomorphism preserves every endpoint relation. -/
theorem preservesEndpointRelation_id (R : G → G → Prop) :
    PreservesEndpointRelation R R (MonoidHom.id G) := by
  intro f g hfg
  exact hfg

/-- Endpoint-relation preservation is closed under composition. -/
theorem PreservesEndpointRelation.comp
    {R : G → G → Prop} {S : H → H → Prop} {T : K → K → Prop}
    {Phi : G →* H} {Psi : H →* K}
    (hPsi : PreservesEndpointRelation S T Psi)
    (hPhi : PreservesEndpointRelation R S Phi) :
    PreservesEndpointRelation R T (Psi.comp Phi) := by
  intro f g hfg
  exact hPsi (hPhi hfg)

/-- The quotient map induced by the identity homomorphism is the identity. -/
theorem relationMappingClassMap_id (R : G → G → Prop) :
    relationMappingClassMap (MonoidHom.id G) (preservesEndpointRelation_id R) =
      MonoidHom.id (RelationMappingClass R) := by
  apply MonoidHom.ext
  intro q
  obtain ⟨f, rfl⟩ := QuotientGroup.mk'_surjective (endpointRelationNormal R) q
  rfl

/-- Induced maps on endpoint-relation quotients compose in the same order as their underlying
group homomorphisms. -/
theorem relationMappingClassMap_comp
    {R : G → G → Prop} {S : H → H → Prop} {T : K → K → Prop}
    (Phi : G →* H) (Psi : H →* K)
    (hPhi : PreservesEndpointRelation R S Phi)
    (hPsi : PreservesEndpointRelation S T Psi) :
    relationMappingClassMap (Psi.comp Phi) (hPsi.comp hPhi) =
      (relationMappingClassMap Psi hPsi).comp
        (relationMappingClassMap Phi hPhi) := by
  apply MonoidHom.ext
  intro q
  obtain ⟨f, rfl⟩ := QuotientGroup.mk'_surjective (endpointRelationNormal R) q
  rfl

end SplittingSpheres
