private theorem isOpenEmbedding_rightTubeClosedOneHandleHalfCollar :
    IsOpenEmbedding rightTubeClosedOneHandleHalfCollar := by
  have h := rightTubeClosedOneHandleHomeomorph.symm.isOpenEmbedding.comp
    (oneHandleCollarOpens.2.isOpenEmbedding_subtypeVal.comp
      oneHandleCollarDiffeomorph.toHomeomorph.isOpenEmbedding)
