namespace SplittingSpheres

private abbrev P := CoordinateUnlinkExteriorEighthCollarDomain

private def oneHandleCollarRadialValue (p : P) : ℝ :=
  9 / 8 - unlinkExteriorCollarRadiusValue p.2.2

private theorem oneHandleCollarRadialValue_pos (p : P) :
    0 < oneHandleCollarRadialValue p := by
  rw [oneHandleCollarRadialValue]
  linarith [unlinkExteriorCollarRadiusValue_lt_upper p.2.2]

private theorem oneHandleCollarRadialValue_le_one (p : P) :
    oneHandleCollarRadialValue p ≤ 1 := by
  rw [oneHandleCollarRadialValue]
  linarith [unlinkExteriorCollarRadiusValue_lower p.2.2]

private theorem oneHandleCollarRadialValue_gt_sevenEighths (p : P) :
    7 / 8 < oneHandleCollarRadialValue p := by
  rw [oneHandleCollarRadialValue]
  linarith [unlinkExteriorCollarRadiusValue_lt_upper p.2.2]

private def oneHandleCollarBall (p : P) : EuclideanClosedBall 3 :=
  ⟨oneHandleCollarRadialValue p • p.1.1, by
    rw [mem_closedBall_zero_iff, norm_smul, Real.norm_eq_abs,
      abs_of_pos (oneHandleCollarRadialValue_pos p),
      mem_sphere_zero_iff_norm.mp p.1.2, mul_one]
    exact oneHandleCollarRadialValue_le_one p⟩

/-- Internal target collar used to assemble the exported exact collar law. -/
public def oneHandleCollarMap
    (p : CoordinateUnlinkExteriorEighthCollarDomain) : OneHandlePiece :=
  (p.2.1, oneHandleCollarBall p)

@[simp] private theorem oneHandleCollarMap_fst (p : P) :
    (oneHandleCollarMap p).1 = p.2.1 := rfl

@[simp] private theorem oneHandleCollarMap_snd_val (p : P) :
    (oneHandleCollarMap p).2.1 = oneHandleCollarRadialValue p • p.1.1 := rfl

@[simp] private theorem norm_oneHandleCollarMap_snd (p : P) :
    ‖(oneHandleCollarMap p).2.1‖ = oneHandleCollarRadialValue p := by
  rw [oneHandleCollarMap_snd_val, norm_smul, Real.norm_eq_abs,
    abs_of_pos (oneHandleCollarRadialValue_pos p),
    mem_sphere_zero_iff_norm.mp p.1.2, mul_one]

private def oneHandleCollarOpens : Opens OneHandlePiece :=
  ⟨{x | (7 / 8 : ℝ) < ‖x.2.1‖},
    isOpen_lt continuous_const
      (continuous_norm.comp (continuous_subtype_val.comp continuous_snd))⟩

private def oneHandleCollarToOpens (p : P) : oneHandleCollarOpens :=
  ⟨oneHandleCollarMap p, by
    change (7 / 8 : ℝ) < ‖(oneHandleCollarMap p).2.1‖
    rw [norm_oneHandleCollarMap_snd]
    exact oneHandleCollarRadialValue_gt_sevenEighths p⟩

private theorem oneHandleCollarOpens_norm_pos (x : oneHandleCollarOpens) :
    0 < ‖x.1.2.1‖ := by
  have hx := x.2
  change (7 / 8 : ℝ) < ‖x.1.2.1‖ at hx
  linarith

private def oneHandleCollarInverseSphere (x : oneHandleCollarOpens) : Sphere 2 :=
  ⟨‖x.1.2.1‖⁻¹ • x.1.2.1, by
    rw [mem_sphere_zero_iff_norm, norm_smul, Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr (oneHandleCollarOpens_norm_pos x)),
      inv_mul_cancel₀ (oneHandleCollarOpens_norm_pos x).ne']⟩

private def oneHandleCollarInverseRadius
    (x : oneHandleCollarOpens) : CoordinateUnlinkExteriorEighthCollarRadius :=
  ⟨⟨9 / 8 - ‖x.1.2.1‖, by
      constructor
      · have hx := mem_closedBall_zero_iff.mp x.1.2.2
        change ‖x.1.2.1‖ ≤ 1 at hx
        linarith
      · have hx := x.2
        change (7 / 8 : ℝ) < ‖x.1.2.1‖ at hx
        linarith⟩,
    by
      have hx := x.2
      change (7 / 8 : ℝ) < ‖x.1.2.1‖ at hx
      change 9 / 8 - ‖x.1.2.1‖ < (1 / 4 : ℝ)
      linarith⟩

private def oneHandleCollarFromOpens (x : oneHandleCollarOpens) : P :=
  (oneHandleCollarInverseSphere x,
    (x.1.1, oneHandleCollarInverseRadius x))

private theorem oneHandleCollarFromOpens_toOpens (p : P) :
    oneHandleCollarFromOpens (oneHandleCollarToOpens p) = p := by
  simp only [oneHandleCollarFromOpens, oneHandleCollarToOpens]
  apply Prod.ext
  · apply Subtype.ext
    simp only [oneHandleCollarInverseSphere, oneHandleCollarMap_snd_val]
    rw [norm_smul, Real.norm_eq_abs,
      abs_of_pos (oneHandleCollarRadialValue_pos p),
      mem_sphere_zero_iff_norm.mp p.1.2, mul_one]
    change (oneHandleCollarRadialValue p)⁻¹ •
        (oneHandleCollarRadialValue p • p.1.1) = p.1.1
    rw [smul_smul, inv_mul_cancel₀ (oneHandleCollarRadialValue_pos p).ne', one_smul]
  · apply Prod.ext
    · rfl
    · apply Subtype.ext
      apply Subtype.ext
      simp only [oneHandleCollarInverseRadius, oneHandleCollarMap_snd_val]
      rw [norm_smul, Real.norm_eq_abs,
        abs_of_pos (oneHandleCollarRadialValue_pos p),
        mem_sphere_zero_iff_norm.mp p.1.2, mul_one]
      change 9 / 8 - oneHandleCollarRadialValue p =
        unlinkExteriorCollarRadiusValue p.2.2
      rw [oneHandleCollarRadialValue]
      ring

private theorem oneHandleCollarToOpens_fromOpens (x : oneHandleCollarOpens) :
    oneHandleCollarToOpens (oneHandleCollarFromOpens x) = x := by
  simp only [oneHandleCollarToOpens, oneHandleCollarFromOpens]
  apply Subtype.ext
  apply Prod.ext
  · rfl
  · apply Subtype.ext
    simp only [oneHandleCollarMap_snd_val, oneHandleCollarRadialValue,
      oneHandleCollarInverseRadius, oneHandleCollarInverseSphere]
    change (9 / 8 - (9 / 8 - ‖x.1.2.1‖)) •
        (‖x.1.2.1‖⁻¹ • x.1.2.1) = x.1.2.1
    rw [show 9 / 8 - (9 / 8 - ‖x.1.2.1‖) = ‖x.1.2.1‖ by ring,
      smul_smul, mul_inv_cancel₀ (oneHandleCollarOpens_norm_pos x).ne', one_smul]

private def oneHandleCollarHomeomorph : P ≃ₜ oneHandleCollarOpens where
  toFun := oneHandleCollarToOpens
  invFun := oneHandleCollarFromOpens
  left_inv := oneHandleCollarFromOpens_toOpens
  right_inv := oneHandleCollarToOpens_fromOpens
  continuous_toFun := by
    apply Continuous.subtype_mk
    apply Continuous.prodMk
    · exact continuous_fst.comp continuous_snd
    · apply Continuous.subtype_mk
      exact ((continuous_const.sub
        (continuous_unlinkExteriorCollarRadiusValue.comp
          (continuous_snd.comp continuous_snd))).smul
            (continuous_subtype_val.comp continuous_fst))
  continuous_invFun := by
    have hb : Continuous (fun x : oneHandleCollarOpens ↦ x.1.2.1) :=
      by fun_prop
    have hn : Continuous (fun x : oneHandleCollarOpens ↦ ‖x.1.2.1‖) :=
      continuous_norm.comp hb
    have hs : Continuous oneHandleCollarInverseSphere := by
      apply Continuous.subtype_mk
      exact (hn.inv₀ (fun x ↦ (oneHandleCollarOpens_norm_pos x).ne')).smul hb
    have ht : Continuous oneHandleCollarInverseRadius := by
      apply Continuous.subtype_mk
      apply Continuous.subtype_mk
      exact continuous_const.sub hn
    exact hs.prodMk ((continuous_fst.comp continuous_subtype_val).prodMk ht)

private theorem contMDiff_oneHandleCollarToOpens :
    ContMDiff coordinateUnlinkExteriorModel oneHandlePieceModel ∞
      oneHandleCollarToOpens := by
  apply (ContMDiff.subtypeVal_comp_iff oneHandleCollarOpens _).mp
  rw [ContinuousLinearEquiv.contMDiff_transContinuousLinearEquiv_left]
  have hu : ContMDiff standardUnlinkExteriorCollarModel
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 1))) ∞
      (fun p : P ↦ p.2.1) := contMDiff_fst.comp contMDiff_snd
  have ht : ContMDiff standardUnlinkExteriorCollarModel
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun p : P ↦ unlinkExteriorCollarRadiusValue p.2.2) :=
    contMDiff_unlinkExteriorCollarRadiusValue.comp
      (contMDiff_snd.comp contMDiff_snd)
  have hs : ContMDiff standardUnlinkExteriorCollarModel
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 2))) ∞
      (fun p : P ↦ p.1) := contMDiff_fst
  have hbval : ContMDiff standardUnlinkExteriorCollarModel
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 3))) ∞
      (fun p : P ↦ (oneHandleCollarBall p : EuclideanSpace ℝ (Fin 3))) := by
    let : Fact (Module.finrank ℝ (EuclideanSpace ℝ (Fin 3)) = 2 + 1) := ⟨by simp⟩
    have hsval := (contMDiff_coe_sphere (n := 2)).comp hs
    exact ((contMDiff_const.sub ht).smul hsval).congr fun _ ↦ rfl
  have hb : ContMDiff standardUnlinkExteriorCollarModel
      (euclideanClosedBallModel 3) ∞ oneHandleCollarBall :=
    contMDiff_euclideanClosedBall_of_contMDiff_val hbval
  exact (hu.prodMk hb).congr fun _ ↦ rfl

private theorem contMDiff_oneHandleCollarFromOpens :
    ContMDiff oneHandlePieceModel coordinateUnlinkExteriorModel ∞
      oneHandleCollarFromOpens := by
  rw [ContinuousLinearEquiv.contMDiff_transContinuousLinearEquiv_right]
  have hb : ContMDiff oneHandlePieceModel
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 3))) ∞
      (fun x : oneHandleCollarOpens ↦ x.1.2.1) :=
    (contMDiff_closedUnitBall_inclusion (EuclideanSpace ℝ (Fin 3))).comp
      (contMDiff_snd.comp contMDiff_subtype_val)
  have hn : ContMDiff oneHandlePieceModel (modelWithCornersSelf ℝ ℝ) ∞
      (fun x : oneHandleCollarOpens ↦ ‖x.1.2.1‖) := by
    intro x
    have h := (contDiffAt_norm ℝ (norm_pos_iff.mp
      (oneHandleCollarOpens_norm_pos x))).contMDiffAt.comp x hb.contMDiffAt
    exact h.congr_of_eventuallyEq (Filter.Eventually.of_forall fun _ ↦ rfl)
  have hsraw : ContMDiff oneHandlePieceModel
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 3))) ∞
      (fun x : oneHandleCollarOpens ↦ ‖x.1.2.1‖⁻¹ • x.1.2.1) :=
    (hn.inv₀ (fun x ↦ (oneHandleCollarOpens_norm_pos x).ne')).smul hb
  let : Fact (Module.finrank ℝ (EuclideanSpace ℝ (Fin 3)) = 2 + 1) := ⟨by simp⟩
  have hs : ContMDiff oneHandlePieceModel
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 2))) ∞
      oneHandleCollarInverseSphere := by
    exact (hsraw.codRestrict_sphere (n := 2)
      (fun x ↦ (oneHandleCollarInverseSphere x).2)).congr fun _ ↦ rfl
  have hu : ContMDiff oneHandlePieceModel
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 1))) ∞
      (fun x : oneHandleCollarOpens ↦ x.1.1) :=
    contMDiff_fst.comp contMDiff_subtype_val
  have ht : ContMDiff oneHandlePieceModel
      (modelWithCornersEuclideanHalfSpace 1) ∞
      oneHandleCollarInverseRadius := by
    apply (ContMDiff.subtypeVal_comp_iff
      (unlinkExteriorCollarRadius (1 / 8 : ℝ) (1 / 4 : ℝ)) _).mp
    rw [contMDiff_iff_comp_subtypeVal_Icc]
    constructor
    · exact (continuous_const.sub hn.continuous).subtype_mk _
    · exact (contMDiff_const.sub hn).congr fun _ ↦ rfl
  exact (hs.prodMk (hu.prodMk ht)).congr fun _ ↦ rfl

private def oneHandleCollarDiffeomorph :
    P ≃ₘ^∞⟮coordinateUnlinkExteriorModel,
      oneHandlePieceModel⟯ oneHandleCollarOpens where
  toEquiv := oneHandleCollarHomeomorph.toEquiv
  contMDiff_toFun := contMDiff_oneHandleCollarToOpens
  contMDiff_invFun := contMDiff_oneHandleCollarFromOpens

end SplittingSpheres

