        rightTubePositiveCollarToCommonSphere by
      funext z
      exact (rightTubePositiveCollarToCommonSphere_eq_ambient z).symm]
    exact isLocalDiffeomorph_rightTubePositiveCollarToCommonSphere
  have h := isLocalDiffeomorphAt_of_localDiffeomorph_parametrization
    coordinateUnlinkExteriorModel coordinateUnlinkExteriorModel
    rightTubeClosedOneHandleCollarAmbient
    (Subtype.val : rightTubeClosedCollarPositiveOpens →
