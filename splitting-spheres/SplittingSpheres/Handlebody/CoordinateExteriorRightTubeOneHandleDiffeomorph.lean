private theorem isLocalDiffeomorphOn_rightTubeClosedOneHandleCollarAmbient :
    letI := coordinateUnlinkExteriorCommonModelSphereChartedSpace
    IsLocalDiffeomorphOn coordinateUnlinkExteriorModel
      coordinateUnlinkExteriorModel ∞
      rightTubeClosedOneHandleCollarAmbient
      (rightTubeClosedOneHandleCollarAmbient ⁻¹'
