    oneHandlePieceInterior oneHandleCollarMap_positive_mem_interior

private theorem isLocalDiffeomorph_oneHandleCollarMap :
    IsLocalDiffeomorph coordinateUnlinkExteriorModel
      oneHandlePieceModel ∞ oneHandleCollarMap := by
