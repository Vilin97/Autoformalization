    rightTubeClosedOneHandleHomeomorph cOne cTwo cTwo
    hcOne hcTwo hcTwo hFcOne hFcTwo hFcTwo
  intro z
  rcases rightTubeClosedOneHandle_cover z with hz | hz
  · exact Or.inl ⟨⟨z.1, hz⟩, Subtype.ext rfl⟩
  · rcases hz with ⟨p, hp⟩
