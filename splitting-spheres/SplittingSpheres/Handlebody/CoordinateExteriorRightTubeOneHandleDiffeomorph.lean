module

public import SplittingSpheres.Geometry.CoordinateUnlinkExteriorCommonModelSphere
public import SplittingSpheres.Geometry.UnlinkCyclicCover
public import SplittingSpheres.Handlebody.AlignedSphereHandleDecomposition
public import SplittingSpheres.Handlebody.OneHandleInteriorDiffeomorph
public import SplittingSpheres.Foundations.CollaredCutSideBoundary
import SplittingSpheres.Handlebody.CoordinateExteriorPlanarOuterRadial
import SplittingSpheres.Handlebody.AlignedSphereHandleSmoothness
import SplittingSpheres.Foundations.DiffeomorphOverLocalDiffeomorph
import SplittingSpheres.Foundations.LocalDiffeomorphismRecognition
import SplittingSpheres.Geometry.CoordinateUnlinkExteriorSmoothAtlas

/-!
# Direct smooth recognition of the closed right-tube exterior

This file constructs an explicit direction-dependent affine radial diffeomorphism from the
closed complement of the open radius-`1/8` tube around the right unlink component to the
natural compact one-handle `Sphere 1 × EuclideanClosedBall 3`.  Its source carries the direct
common-model atlas generated by the ambient sphere and an explicit one-sided collar.

The radial formula preserves the argument of the right meridian character and changes its
magnitude by a positive scalar.  No capping or pushout identification is asserted here.
-/


open Function Metric Set Topology
open TopologicalSpace
open scoped ContDiff Manifold

noncomputable section

namespace SplittingSpheres.RightTubeRadialScout

private abbrev sourceInnerRadius : ℝ := 1 / 8

/-- The first intersection of the ray from `(1/2, 0)` with the target circle of
radius `sphereHandleRadius` about the origin. -/
private def targetInnerRayRadius (a : ℝ) : ℝ :=
  planarOuterQuadraticRadius a

/-- The first intersection of the ray from `(1/2, 0)` with the unit circle. -/
private def outerRayRadius (a : ℝ) : ℝ :=
  (Real.sqrt (a ^ 2 + 3) - a) / 2

private theorem targetInnerRayRadius_sq_add_mul (a : ℝ) :
    targetInnerRayRadius a ^ 2 + a * targetInnerRayRadius a = 1 / 4 := by
  exact planarOuterQuadraticRadius_sq_add_mul a

private theorem outerRayRadius_sq_add_mul (a : ℝ) :
    outerRayRadius a ^ 2 + a * outerRayRadius a = 3 / 4 := by
  have hs : 0 ≤ a ^ 2 + 3 := by positivity
  have hsqrt := Real.sq_sqrt hs
  rw [outerRayRadius]
  nlinarith

private theorem targetInnerRayRadius_pos {a : ℝ} (ha : a ≤ 1) :
    0 < targetInnerRayRadius a :=
  planarOuterQuadraticRadius_pos ha

private theorem targetInnerRayRadius_add_arg_pos {a : ℝ} (ha : -1 ≤ a) :
    0 < targetInnerRayRadius a + a :=
  planarOuterQuadraticRadius_add_arg_pos ha

private theorem outerRayRadius_pos {a : ℝ} (ha : a ≤ 1) :
    0 < outerRayRadius a := by
  have hsqrt0 : 0 ≤ Real.sqrt (a ^ 2 + 3) := Real.sqrt_nonneg _
  have hsqrt_sq : Real.sqrt (a ^ 2 + 3) ^ 2 = a ^ 2 + 3 :=
    Real.sq_sqrt (by positivity)
  rw [outerRayRadius]
  nlinarith

private theorem outerRayRadius_add_arg_pos {a : ℝ} (ha : -1 ≤ a) :
    0 < outerRayRadius a + a := by
  have hsqrt0 : 0 ≤ Real.sqrt (a ^ 2 + 3) := Real.sqrt_nonneg _
  have hsqrt_sq : Real.sqrt (a ^ 2 + 3) ^ 2 = a ^ 2 + 3 :=
    Real.sq_sqrt (by positivity)
  rw [outerRayRadius]
  nlinarith

private theorem sq_add_mul_eq_threeQuarter_iff_eq_outerRayRadius
    {a r : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) (hr : 0 ≤ r) :
    r ^ 2 + a * r = 3 / 4 ↔ r = outerRayRadius a := by
  let q := outerRayRadius a
  have hq : 0 < q := outerRayRadius_pos ha₁
  have hqa : 0 < q + a := outerRayRadius_add_arg_pos ha₀
  have hqEq : q ^ 2 + a * q = 3 / 4 := outerRayRadius_sq_add_mul a
  constructor
  · intro h
    have hfactor : (r - q) * (r + q + a) = 0 := by
      nlinarith
    rcases mul_eq_zero.mp hfactor with hrq | hsecond
    · exact sub_eq_zero.mp hrq
    · have : 0 < r + q + a := by linarith
      exact (this.ne' hsecond).elim
  · rintro rfl
    exact hqEq

private theorem sourceInnerRadius_lt_targetInnerRayRadius
    {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    sourceInnerRadius < targetInnerRayRadius a := by
  let p := targetInnerRayRadius a
  have hp : 0 < p := targetInnerRayRadius_pos ha₁
  have hpa : 0 < p + a := targetInnerRayRadius_add_arg_pos ha₀
  have hpEq : p ^ 2 + a * p = 1 / 4 :=
    targetInnerRayRadius_sq_add_mul a
  have hprod : 0 < (p - sourceInnerRadius) * (p + sourceInnerRadius + a) := by
    rw [show (p - sourceInnerRadius) * (p + sourceInnerRadius + a) =
        p ^ 2 + a * p -
          (sourceInnerRadius ^ 2 + a * sourceInnerRadius) by ring]
    dsimp only [sourceInnerRadius]
    nlinarith
  have hsecond : 0 < p + sourceInnerRadius + a := by
    dsimp only [sourceInnerRadius]
    linarith
  exact sub_pos.mp (pos_of_mul_pos_left hprod hsecond.le)

private theorem targetInnerRayRadius_lt_outerRayRadius
    {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    targetInnerRayRadius a < outerRayRadius a := by
  let p := targetInnerRayRadius a
  let q := outerRayRadius a
  have hp : 0 < p := targetInnerRayRadius_pos ha₁
  have hpa : 0 < p + a := targetInnerRayRadius_add_arg_pos ha₀
  have hq : 0 < q := outerRayRadius_pos ha₁
  have hpEq : p ^ 2 + a * p = 1 / 4 :=
    targetInnerRayRadius_sq_add_mul a
  have hqEq : q ^ 2 + a * q = 3 / 4 :=
    outerRayRadius_sq_add_mul a
  have hprod : 0 < (q - p) * (q + p + a) := by
    rw [show (q - p) * (q + p + a) =
        (q ^ 2 + a * q) - (p ^ 2 + a * p) by ring]
    nlinarith
  have hsecond : 0 < q + p + a := by linarith
  exact sub_pos.mp (pos_of_mul_pos_left hprod hsecond.le)

private theorem sourceInnerRadius_lt_outerRayRadius
    {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    sourceInnerRadius < outerRayRadius a :=
  (sourceInnerRadius_lt_targetInnerRayRadius ha₀ ha₁).trans
    (targetInnerRayRadius_lt_outerRayRadius ha₀ ha₁)

/-- The positive affine slope taking the source radial interval to the target interval. -/
private def raySlope (a : ℝ) : ℝ :=
  (outerRayRadius a - targetInnerRayRadius a) /
    (outerRayRadius a - sourceInnerRadius)

private theorem raySlope_pos {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    0 < raySlope a := by
  exact div_pos
    (sub_pos.mpr (targetInnerRayRadius_lt_outerRayRadius ha₀ ha₁))
    (sub_pos.mpr (sourceInnerRadius_lt_outerRayRadius ha₀ ha₁))

private theorem raySlope_lt_one {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    raySlope a < 1 := by
  rw [raySlope, div_lt_one
    (sub_pos.mpr (sourceInnerRadius_lt_outerRayRadius ha₀ ha₁))]
  exact sub_lt_sub_left
    (sourceInnerRadius_lt_targetInnerRayRadius ha₀ ha₁) _

private theorem outer_sub_targetInner_eq_mul_raySlope
    {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    outerRayRadius a - targetInnerRayRadius a =
      (outerRayRadius a - sourceInnerRadius) * raySlope a := by
  rw [raySlope]
  exact (mul_div_cancel₀ _
    (sub_ne_zero.mpr
      (sourceInnerRadius_lt_outerRayRadius ha₀ ha₁).ne')).symm

/-- Affine radial interpolation: the source inner radius goes to the target inner ray,
while the unit-circle endpoint is fixed. -/
private def forwardRadius (a r : ℝ) : ℝ :=
  targetInnerRayRadius a + (r - sourceInnerRadius) * raySlope a

/-- The inverse affine radial interpolation. -/
private def inverseRadius (a s : ℝ) : ℝ :=
  sourceInnerRadius + (s - targetInnerRayRadius a) / raySlope a

@[simp] private theorem forwardRadius_sourceInner (a : ℝ) :
    forwardRadius a sourceInnerRadius = targetInnerRayRadius a := by
  simp [forwardRadius]

private theorem forwardRadius_outer {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    forwardRadius a (outerRayRadius a) = outerRayRadius a := by
  rw [forwardRadius, ← outer_sub_targetInner_eq_mul_raySlope ha₀ ha₁]
  ring

@[simp] private theorem inverseRadius_targetInner (a : ℝ) :
    inverseRadius a (targetInnerRayRadius a) = sourceInnerRadius := by
  simp [inverseRadius]

private theorem forwardRadius_sub_targetInner (a r : ℝ) :
    forwardRadius a r - targetInnerRayRadius a =
      (r - sourceInnerRadius) * raySlope a := by
  rw [forwardRadius]
  ring

private theorem outer_sub_forwardRadius
    {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) (r : ℝ) :
    outerRayRadius a - forwardRadius a r =
      (outerRayRadius a - r) * raySlope a := by
  rw [forwardRadius]
  calc
    outerRayRadius a -
          (targetInnerRayRadius a + (r - sourceInnerRadius) * raySlope a) =
        (outerRayRadius a - targetInnerRayRadius a) -
          (r - sourceInnerRadius) * raySlope a := by ring
    _ = (outerRayRadius a - sourceInnerRadius) * raySlope a -
          (r - sourceInnerRadius) * raySlope a := by
      rw [outer_sub_targetInner_eq_mul_raySlope ha₀ ha₁]
    _ = (outerRayRadius a - r) * raySlope a := by ring

private theorem inverseRadius_forwardRadius
    {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) (r : ℝ) :
    inverseRadius a (forwardRadius a r) = r := by
  rw [inverseRadius, forwardRadius_sub_targetInner]
  field_simp [(raySlope_pos ha₀ ha₁).ne']
  ring

private theorem forwardRadius_inverseRadius
    {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) (s : ℝ) :
    forwardRadius a (inverseRadius a s) = s := by
  rw [forwardRadius, inverseRadius]
  field_simp [(raySlope_pos ha₀ ha₁).ne']
  ring

private theorem forwardRadius_mem_targetRay
    {a r : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1)
    (hr : r ∈ Ioc sourceInnerRadius (outerRayRadius a)) :
    forwardRadius a r ∈ Ioc (targetInnerRayRadius a) (outerRayRadius a) := by
  constructor
  · rw [← sub_pos, forwardRadius_sub_targetInner]
    exact mul_pos (sub_pos.mpr hr.1) (raySlope_pos ha₀ ha₁)
  · rw [← sub_nonneg, outer_sub_forwardRadius ha₀ ha₁]
    exact mul_nonneg (sub_nonneg.mpr hr.2) (raySlope_pos ha₀ ha₁).le

private theorem inverseRadius_outer
    {a : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    inverseRadius a (outerRayRadius a) = outerRayRadius a := by
  calc
    inverseRadius a (outerRayRadius a) =
        inverseRadius a (forwardRadius a (outerRayRadius a)) := by
      rw [forwardRadius_outer ha₀ ha₁]
    _ = outerRayRadius a := inverseRadius_forwardRadius ha₀ ha₁ _

private theorem inverseRadius_mem_sourceRay
    {a s : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1)
    (hs : s ∈ Ioc (targetInnerRayRadius a) (outerRayRadius a)) :
    inverseRadius a s ∈ Ioc sourceInnerRadius (outerRayRadius a) := by
  have hk := raySlope_pos ha₀ ha₁
  constructor
  · rw [inverseRadius]
    exact sub_pos.mp (by
      rw [add_sub_cancel_left]
      exact div_pos (sub_pos.mpr hs.1) hk)
  · rw [← inverseRadius_outer ha₀ ha₁]
    rw [inverseRadius, inverseRadius]
    exact add_le_add_right
      (div_le_div_of_nonneg_right
        (sub_le_sub_right hs.2 _) hk.le) _

/-- For each direction, the affine radial map is a literal bijection of the strict-inner,
closed-outer ray intervals. -/
private def rayEquiv (a : ℝ) (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    ↑(Ioc sourceInnerRadius (outerRayRadius a)) ≃
      ↑(Ioc (targetInnerRayRadius a) (outerRayRadius a)) where
  toFun r := ⟨forwardRadius a r.1,
    forwardRadius_mem_targetRay ha₀ ha₁ r.2⟩
  invFun s := ⟨inverseRadius a s.1,
    inverseRadius_mem_sourceRay ha₀ ha₁ s.2⟩
  left_inv r := Subtype.ext (inverseRadius_forwardRadius ha₀ ha₁ r.1)
  right_inv s := Subtype.ext (forwardRadius_inverseRadius ha₀ ha₁ s.1)

/-- The negative root of the outer unit-circle equation. -/
private def outerRayNegativeRoot (a : ℝ) : ℝ :=
  -a - outerRayRadius a

private theorem outer_circle_defect_factor (a r : ℝ) :
    1 - (r ^ 2 + a * r + 1 / 4) =
      (outerRayRadius a - r) * (r - outerRayNegativeRoot a) := by
  rw [outerRayNegativeRoot]
  have h := outerRayRadius_sq_add_mul a
  nlinarith

/-- The squared tangential scaling, written in its nonsingular factored form at the
outer unit circle. -/
private def tangentialScaleSq (a r : ℝ) : ℝ :=
  raySlope a *
    (forwardRadius a r - outerRayNegativeRoot a) /
      (r - outerRayNegativeRoot a)

private theorem outerRayNegativeRoot_lt_zero {a : ℝ} (ha₀ : -1 ≤ a) :
    outerRayNegativeRoot a < 0 := by
  rw [outerRayNegativeRoot]
  linarith [outerRayRadius_add_arg_pos ha₀]

private theorem tangentialScaleSq_pos
    {a r : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1)
    (hr : sourceInnerRadius ≤ r) :
    0 < tangentialScaleSq a r := by
  have hneg := outerRayNegativeRoot_lt_zero ha₀
  have hspos : 0 < forwardRadius a r := by
    rw [forwardRadius]
    exact add_pos_of_pos_of_nonneg (targetInnerRayRadius_pos ha₁)
      (mul_nonneg (sub_nonneg.mpr hr) (raySlope_pos ha₀ ha₁).le)
  rw [tangentialScaleSq]
  exact div_pos (mul_pos (raySlope_pos ha₀ ha₁) (sub_pos.mpr (hneg.trans hspos)))
    (sub_pos.mpr (hneg.trans_le (by
      dsimp only [sourceInnerRadius] at hr ⊢
      linarith)))

private theorem tangentialScaleSq_mul_source_defect
    {a r : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1)
    (hr : sourceInnerRadius ≤ r) :
    tangentialScaleSq a r * (1 - (r ^ 2 + a * r + 1 / 4)) =
      1 - (forwardRadius a r ^ 2 +
        a * forwardRadius a r + 1 / 4) := by
  have hden : r - outerRayNegativeRoot a ≠ 0 := by
    have hneg := outerRayNegativeRoot_lt_zero ha₀
    exact sub_ne_zero.mpr (hneg.trans_le (by
      dsimp only [sourceInnerRadius] at hr ⊢
      linarith)).ne'
  rw [outer_circle_defect_factor, tangentialScaleSq]
  rw [show 1 - (forwardRadius a r ^ 2 +
        a * forwardRadius a r + 1 / 4) =
      (outerRayRadius a - forwardRadius a r) *
        (forwardRadius a r - outerRayNegativeRoot a) by
      exact outer_circle_defect_factor a (forwardRadius a r)]
  rw [outer_sub_forwardRadius ha₀ ha₁]
  field_simp [hden]

/-- The positive smooth tangential scale used in the sphere lift. -/
private def tangentialScale (a r : ℝ) : ℝ :=
  Real.sqrt (tangentialScaleSq a r)

private theorem tangentialScale_pos
    {a r : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1)
    (hr : sourceInnerRadius ≤ r) :
    0 < tangentialScale a r :=
  Real.sqrt_pos.2 (tangentialScaleSq_pos ha₀ ha₁ hr)

private theorem tangentialScale_sq
    {a r : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1)
    (hr : sourceInnerRadius ≤ r) :
    tangentialScale a r ^ 2 = tangentialScaleSq a r := by
  exact Real.sq_sqrt (tangentialScaleSq_pos ha₀ ha₁ hr).le

private theorem contDiff_targetInnerRayRadius :
    ContDiff ℝ ∞ targetInnerRayRadius := by
  unfold targetInnerRayRadius planarOuterQuadraticRadius
  exact ((((contDiff_id.pow 2).add contDiff_const).sqrt (fun a ↦ by positivity)).sub
    contDiff_id).div_const 2

private theorem contDiff_outerRayRadius :
    ContDiff ℝ ∞ outerRayRadius := by
  unfold outerRayRadius
  exact ((((contDiff_id.pow 2).add contDiff_const).sqrt (fun a ↦ by positivity)).sub
    contDiff_id).div_const 2

/-! ## The smooth normal-plane map -/

/-- The real angular coordinate of a nonzero ray based at the right unlink center. -/
private def polarAngularReal (v : UnlinkPuncturedNormalPlane 1) : ℝ :=
  (unlinkNormalPolarDirection 1 v).1 0

private theorem polarAngularReal_bounds (v : UnlinkPuncturedNormalPlane 1) :
    -1 ≤ polarAngularReal v ∧ polarAngularReal v ≤ 1 := by
  have h := PiLp.norm_apply_le (unlinkNormalPolarDirection 1 v).1 0
  rw [mem_sphere_zero_iff_norm.mp (unlinkNormalPolarDirection 1 v).2] at h
  simpa only [polarAngularReal, Real.norm_eq_abs] using (abs_le.mp h)

private theorem norm_center_one_add_ray_sq (u : Sphere 1) (r : ℝ) :
    ‖standardUnlinkNormalCenter 1 + r • (u.1 : UnlinkNormalPlane)‖ ^ 2 =
      r ^ 2 + u.1 0 * r + 1 / 4 := by
  rw [EuclideanSpace.real_norm_sq_eq]
  simp [standardUnlinkNormalCenter, standardUnlinkHeight,
    Fin.sum_univ_succ]
  have hu : u.1 0 ^ 2 + u.1 1 ^ 2 = 1 := by
    have h := congrArg (fun t : ℝ ↦ t ^ 2)
      (mem_sphere_zero_iff_norm.mp u.2)
    rw [EuclideanSpace.real_norm_sq_eq] at h
    simpa [Fin.sum_univ_succ] using h
  nlinarith

private theorem norm_center_one_add_ray_le_sphereHandleRadius_iff
    (u : Sphere 1) {r : ℝ} (hr : 0 ≤ r) :
    ‖standardUnlinkNormalCenter 1 + r • (u.1 : UnlinkNormalPlane)‖ ≤
        sphereHandleRadius ↔
      r ≤ targetInnerRayRadius (u.1 0) := by
  rw [← sq_le_sq₀ (norm_nonneg _) sphereHandleRadius_pos.le,
    sphereHandleRadius_sq, norm_center_one_add_ray_sq]
  have huBounds : -1 ≤ u.1 0 ∧ u.1 0 ≤ 1 := by
    have h := PiLp.norm_apply_le u.1 0
    rw [mem_sphere_zero_iff_norm.mp u.2] at h
    have h' : |u.1 0| ≤ 1 := by
      simpa only [Real.norm_eq_abs] using h
    exact abs_le.mp h'
  have hquad := sq_add_mul_le_quarter_iff_le_planarOuterQuadraticRadius
    huBounds.1 huBounds.2 hr
  change r ^ 2 + u.1 0 * r + 1 / 4 ≤ 1 / 2 ↔
    r ≤ planarOuterQuadraticRadius (u.1 0)
  constructor
  · intro h
    apply hquad.mp
    nlinarith
  · intro h
    have := hquad.mpr h
    nlinarith

private theorem contMDiff_polarAngularReal :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞ polarAngularReal := by
  let : Fact (Module.finrank ℝ UnlinkNormalPlane = 1 + 1) := ⟨by simp⟩
  have hdir := (contMDiff_coe_sphere (n := 1)).comp
    (contMDiff_unlinkNormalPolarDirection 1)
  have hcoord : ContDiff ℝ ∞ (fun x : UnlinkNormalPlane ↦ x 0) := by
    fun_prop
  exact hcoord.contMDiff.comp hdir

/-- The direct normal-plane ray map, still expressed in the ambient normal plane. -/
private def normalForwardMap (v : UnlinkPuncturedNormalPlane 1) : UnlinkNormalPlane :=
  standardUnlinkNormalCenter 1 +
    forwardRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) •
      (unlinkNormalPolarDirection 1 v).1

private theorem normalForwardMap_sub_center (v : UnlinkPuncturedNormalPlane 1) :
    normalForwardMap v - standardUnlinkNormalCenter 1 =
      forwardRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) •
        (unlinkNormalPolarDirection 1 v).1 := by
  rw [normalForwardMap, add_sub_cancel_left]

private theorem contMDiff_raySlope_polar :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun v : UnlinkPuncturedNormalPlane 1 ↦ raySlope (polarAngularReal v)) := by
  have hA := contMDiff_polarAngularReal
  have houter := contDiff_outerRayRadius.contMDiff.comp hA
  have htarget := contDiff_targetInnerRayRadius.contMDiff.comp hA
  have hden := houter.sub
    (contMDiff_const : ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun _ : UnlinkPuncturedNormalPlane 1 ↦ sourceInnerRadius))
  have hdenInv := hden.inv₀ fun v ↦ by
    have hv := polarAngularReal_bounds v
    exact (sub_pos.mpr
      (sourceInnerRadius_lt_outerRayRadius hv.1 hv.2)).ne'
  exact ((houter.sub htarget).smul hdenInv).congr fun _ ↦ by
    simp [raySlope, Function.comp_apply, div_eq_mul_inv]

private theorem contMDiff_forwardRadius_polar :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun v : UnlinkPuncturedNormalPlane 1 ↦
        forwardRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v)) := by
  have hA := contMDiff_polarAngularReal
  have htarget := contDiff_targetInnerRayRadius.contMDiff.comp hA
  have hr := contMDiff_unlinkNormalPolarRadius 1
  exact (htarget.add ((hr.sub
      (contMDiff_const : ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
        (modelWithCornersSelf ℝ ℝ) ∞
        (fun _ : UnlinkPuncturedNormalPlane 1 ↦ sourceInnerRadius))).smul
    contMDiff_raySlope_polar)).congr fun _ ↦ rfl

private theorem contMDiff_normalForwardMap :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ normalForwardMap := by
  let : Fact (Module.finrank ℝ UnlinkNormalPlane = 1 + 1) := ⟨by simp⟩
  have hdir := (contMDiff_coe_sphere (n := 1)).comp
    (contMDiff_unlinkNormalPolarDirection 1)
  exact (contMDiff_const.add (contMDiff_forwardRadius_polar.smul hdir)).congr
    fun _ ↦ rfl

private theorem normalForwardRadius_pos
    (v : UnlinkPuncturedNormalPlane 1)
    (hv : sourceInnerRadius ≤ unlinkNormalPolarRadius 1 v) :
    0 < forwardRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) := by
  have ha := polarAngularReal_bounds v
  rw [forwardRadius]
  exact add_pos_of_pos_of_nonneg (targetInnerRayRadius_pos ha.2)
    (mul_nonneg (sub_nonneg.mpr hv) (raySlope_pos ha.1 ha.2).le)

private theorem norm_normalForwardMap_sub_center
    (v : UnlinkPuncturedNormalPlane 1)
    (hv : sourceInnerRadius ≤ unlinkNormalPolarRadius 1 v) :
    ‖normalForwardMap v - standardUnlinkNormalCenter 1‖ =
      forwardRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) := by
  rw [normalForwardMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos (normalForwardRadius_pos v hv),
    mem_sphere_zero_iff_norm.mp (unlinkNormalPolarDirection 1 v).2, mul_one]

private theorem unlinkNormalPlaneToComplex_real_smul
    (c : ℝ) (v : UnlinkNormalPlane) :
    unlinkNormalPlaneToComplex (c • v) = (c : ℂ) * unlinkNormalPlaneToComplex v := by
  apply Complex.ext <;>
    simp [unlinkNormalPlaneToComplex, Complex.equivRealProdCLM_symm_apply]

private theorem unlinkNormalPlaneToComplex_sub_scout
    (v w : UnlinkNormalPlane) :
    unlinkNormalPlaneToComplex (v - w) =
      unlinkNormalPlaneToComplex v - unlinkNormalPlaneToComplex w := by
  apply Complex.ext <;>
    simp [unlinkNormalPlaneToComplex, Complex.equivRealProdCLM_symm_apply]

/-- The exact positive-scalar law for the right character.  This is the lift datum needed
for the power coordinate and involves no choice of root. -/
private theorem normalForwardMap_rightCharacter_positiveScalar
    (v : UnlinkPuncturedNormalPlane 1)
    (hv : sourceInnerRadius ≤ unlinkNormalPolarRadius 1 v) :
    ∃ c : ℝ, 0 < c ∧
      unlinkNormalPlaneToComplex
          (normalForwardMap v - standardUnlinkNormalCenter 1) =
        (c : ℂ) * unlinkNormalPlaneToComplex
          (v.1 - standardUnlinkNormalCenter 1) := by
  let r := unlinkNormalPolarRadius 1 v
  let s := forwardRadius (polarAngularReal v) r
  refine ⟨s / r, div_pos (normalForwardRadius_pos v hv)
    (unlinkNormalPolarRadius_pos 1 v), ?_⟩
  rw [normalForwardMap_sub_center, unlinkNormalPlaneToComplex_real_smul,
    unlinkNormalPolarDirection_coe, unlinkNormalPlaneToComplex_real_smul]
  push_cast
  rw [div_eq_mul_inv]
  dsimp only [s, r, unlinkNormalPolarRadius]
  ring

/-! ## A direct normal-plane diffeomorphism -/

/-- The normal plane strictly outside the closed radius-`1/8` disk about the right center. -/
private def sourceNormalExteriorOpens : Opens UnlinkNormalPlane :=
  ⟨{v | sourceInnerRadius < ‖v - standardUnlinkNormalCenter 1‖},
    isOpen_lt continuous_const
      (continuous_norm.comp (continuous_id.sub continuous_const))⟩

private abbrev SourceNormalExterior := sourceNormalExteriorOpens

@[simp] private theorem mem_sourceNormalExteriorOpens (v : UnlinkNormalPlane) :
    v ∈ sourceNormalExteriorOpens ↔
      sourceInnerRadius < ‖v - standardUnlinkNormalCenter 1‖ := Iff.rfl

private theorem sourceNormalExterior_ne_center (v : SourceNormalExterior) :
    v.1 ≠ standardUnlinkNormalCenter 1 := by
  intro h
  have hv : sourceInnerRadius <
      ‖v.1 - standardUnlinkNormalCenter 1‖ := v.2
  rw [h, sub_self, norm_zero] at hv
  norm_num [sourceInnerRadius] at hv

/-- The open normal-plane region appearing as the interior of the aligned one-handle. -/
private def oneHandleNormalInteriorOpens : Opens UnlinkNormalPlane :=
  ⟨{v | sphereHandleRadius < ‖v‖},
    isOpen_lt continuous_const continuous_norm⟩

private abbrev OneHandleNormalInterior := oneHandleNormalInteriorOpens

private def sourceNormalToPunctured
    (v : SourceNormalExterior) : UnlinkPuncturedNormalPlane 1 :=
  ⟨v.1, sourceNormalExterior_ne_center v⟩

private theorem contMDiff_sourceNormalToPunctured :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ sourceNormalToPunctured := by
  apply (ContMDiff.subtypeVal_comp_iff (unlinkPuncturedNormalPlane 1) _).mp
  exact contMDiff_subtype_val

private theorem center_add_polar_reconstruction (v : UnlinkPuncturedNormalPlane 1) :
    standardUnlinkNormalCenter 1 +
        unlinkNormalPolarRadius 1 v • (unlinkNormalPolarDirection 1 v).1 =
      v.1 := by
  rw [unlinkNormalPolarRadius, unlinkNormalPolarDirection_coe, smul_smul]
  have hr : ‖v.1 - standardUnlinkNormalCenter 1‖ ≠ 0 :=
    norm_ne_zero_iff.mpr (sub_ne_zero.mpr
      (unlinkPuncturedNormalPlane_coe_ne_center 1 v))
  rw [mul_inv_cancel₀ hr, one_smul]
  abel

private theorem normalForwardMap_mem_oneHandleNormalInterior
    (v : SourceNormalExterior) :
    normalForwardMap (sourceNormalToPunctured v) ∈ oneHandleNormalInteriorOpens := by
  let p := sourceNormalToPunctured v
  let r := unlinkNormalPolarRadius 1 p
  let a := polarAngularReal p
  let s := forwardRadius a r
  have ha := polarAngularReal_bounds p
  have hr : sourceInnerRadius < r := v.2
  have hs : targetInnerRayRadius a < s := by
    apply sub_pos.mp
    rw [show s - targetInnerRayRadius a =
      (r - sourceInnerRadius) * raySlope a by
        exact forwardRadius_sub_targetInner a r]
    exact mul_pos (sub_pos.mpr hr) (raySlope_pos ha.1 ha.2)
  have hspos : 0 ≤ s := (targetInnerRayRadius_pos ha.2).le.trans hs.le
  rw [show normalForwardMap p =
      standardUnlinkNormalCenter 1 +
        s • (unlinkNormalPolarDirection 1 p).1 by rfl]
  exact lt_of_not_ge fun h ↦ (not_le.mpr hs) <|
    (norm_center_one_add_ray_le_sphereHandleRadius_iff
      (unlinkNormalPolarDirection 1 p) hspos).mp h

private def normalForward (v : SourceNormalExterior) :
    OneHandleNormalInterior :=
  ⟨normalForwardMap (sourceNormalToPunctured v),
    normalForwardMap_mem_oneHandleNormalInterior v⟩

private theorem contMDiff_normalForward :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ normalForward := by
  apply (ContMDiff.subtypeVal_comp_iff oneHandleNormalInteriorOpens _).mp
  exact contMDiff_normalForwardMap.comp contMDiff_sourceNormalToPunctured

private theorem normalForward_eq_self_of_norm_eq_one
    (v : SourceNormalExterior) (hv : ‖v.1‖ = 1) :
    (normalForward v).1 = v.1 := by
  let p := sourceNormalToPunctured v
  let r := unlinkNormalPolarRadius 1 p
  let a := polarAngularReal p
  have ha := polarAngularReal_bounds p
  have hr : 0 ≤ r := (unlinkNormalPolarRadius_pos 1 p).le
  have hsq : r ^ 2 + a * r = 3 / 4 := by
    have hnorm := norm_center_one_add_ray_sq
      (unlinkNormalPolarDirection 1 p) r
    have hpval : p.1 = v.1 := rfl
    rw [center_add_polar_reconstruction p, hpval, hv] at hnorm
    change 1 ^ 2 = r ^ 2 + a * r + 1 / 4 at hnorm
    nlinarith
  have hrOuter : r = outerRayRadius a :=
    (sq_add_mul_eq_threeQuarter_iff_eq_outerRayRadius ha.1 ha.2 hr).mp hsq
  have hforwardOuter :
      forwardRadius (polarAngularReal p) (unlinkNormalPolarRadius 1 p) =
        unlinkNormalPolarRadius 1 p := by
    change forwardRadius a r = r
    rw [hrOuter, forwardRadius_outer ha.1 ha.2]
  change normalForwardMap p = v.1
  rw [normalForwardMap, hforwardOuter]
  exact center_add_polar_reconstruction p

private def targetNormalToPunctured
    (v : OneHandleNormalInterior) : UnlinkPuncturedNormalPlane 1 := by
  refine ⟨v.1, ?_⟩
  change v.1 ≠ standardUnlinkNormalCenter 1
  intro h
  have hv : sphereHandleRadius < ‖v.1‖ := v.2
  rw [h, norm_standardUnlinkNormalCenter] at hv
  exact (not_lt_of_ge half_lt_sphereHandleRadius.le) hv

private theorem contMDiff_targetNormalToPunctured :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ targetNormalToPunctured := by
  apply (ContMDiff.subtypeVal_comp_iff (unlinkPuncturedNormalPlane 1) _).mp
  exact contMDiff_subtype_val

/-- The inverse ray map in the ambient normal plane. -/
private def normalInverseMap (v : UnlinkPuncturedNormalPlane 1) : UnlinkNormalPlane :=
  standardUnlinkNormalCenter 1 +
    inverseRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) •
      (unlinkNormalPolarDirection 1 v).1

private theorem normalInverseMap_sub_center (v : UnlinkPuncturedNormalPlane 1) :
    normalInverseMap v - standardUnlinkNormalCenter 1 =
      inverseRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) •
        (unlinkNormalPolarDirection 1 v).1 := by
  rw [normalInverseMap, add_sub_cancel_left]

private theorem contMDiff_inverseRadius_polar :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun v : UnlinkPuncturedNormalPlane 1 ↦
        inverseRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v)) := by
  have hA := contMDiff_polarAngularReal
  have htarget := contDiff_targetInnerRayRadius.contMDiff.comp hA
  have hr := contMDiff_unlinkNormalPolarRadius 1
  have hk := contMDiff_raySlope_polar
  have hkInv := hk.inv₀ fun v ↦ by
    have hv := polarAngularReal_bounds v
    exact (raySlope_pos hv.1 hv.2).ne'
  exact ((contMDiff_const : ContMDiff
      (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun _ : UnlinkPuncturedNormalPlane 1 ↦ sourceInnerRadius)).add
    ((hr.sub htarget).smul hkInv)).congr fun v ↦ by
    simp [inverseRadius, Function.comp_apply, div_eq_mul_inv]

private theorem contMDiff_normalInverseMap :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ normalInverseMap := by
  let : Fact (Module.finrank ℝ UnlinkNormalPlane = 1 + 1) := ⟨by simp⟩
  have hdir := (contMDiff_coe_sphere (n := 1)).comp
    (contMDiff_unlinkNormalPolarDirection 1)
  exact (contMDiff_const.add (contMDiff_inverseRadius_polar.smul hdir)).congr
    fun _ ↦ rfl

private theorem targetRadius_gt_targetInner (v : OneHandleNormalInterior) :
    targetInnerRayRadius
        (polarAngularReal (targetNormalToPunctured v)) <
      unlinkNormalPolarRadius 1 (targetNormalToPunctured v) := by
  let p := targetNormalToPunctured v
  let r := unlinkNormalPolarRadius 1 p
  have hr : 0 ≤ r := (unlinkNormalPolarRadius_pos 1 p).le
  have hp := center_add_polar_reconstruction p
  have hnot : ¬ ‖standardUnlinkNormalCenter 1 +
      r • (unlinkNormalPolarDirection 1 p).1‖ ≤ sphereHandleRadius := by
    rw [hp]
    exact not_le.mpr v.2
  exact lt_of_not_ge fun h ↦ hnot <|
    (norm_center_one_add_ray_le_sphereHandleRadius_iff
      (unlinkNormalPolarDirection 1 p) hr).mpr h

private theorem normalInverseMap_mem_sourceExterior
    (v : OneHandleNormalInterior) :
    normalInverseMap (targetNormalToPunctured v) ∈
      sourceNormalExteriorOpens := by
  let p := targetNormalToPunctured v
  let s := unlinkNormalPolarRadius 1 p
  let a := polarAngularReal p
  have ha := polarAngularReal_bounds p
  have hs : targetInnerRayRadius a < s := targetRadius_gt_targetInner v
  have hinv : sourceInnerRadius < inverseRadius a s := by
    rw [inverseRadius]
    exact lt_add_of_pos_right _ (div_pos (sub_pos.mpr hs)
      (raySlope_pos ha.1 ha.2))
  rw [mem_sourceNormalExteriorOpens, normalInverseMap_sub_center,
    norm_smul, Real.norm_eq_abs, abs_of_pos
      (lt_trans (by norm_num : (0 : ℝ) < sourceInnerRadius) hinv),
    mem_sphere_zero_iff_norm.mp (unlinkNormalPolarDirection 1 p).2, mul_one]
  exact hinv

private def normalInverse (v : OneHandleNormalInterior) :
    SourceNormalExterior :=
  ⟨normalInverseMap (targetNormalToPunctured v),
    normalInverseMap_mem_sourceExterior v⟩

private theorem contMDiff_normalInverse :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ normalInverse := by
  apply (ContMDiff.subtypeVal_comp_iff sourceNormalExteriorOpens _).mp
  exact contMDiff_normalInverseMap.comp contMDiff_targetNormalToPunctured

private theorem polarRadius_normalForward (v : SourceNormalExterior) :
    unlinkNormalPolarRadius 1
        (targetNormalToPunctured (normalForward v)) =
      forwardRadius (polarAngularReal (sourceNormalToPunctured v))
        (unlinkNormalPolarRadius 1 (sourceNormalToPunctured v)) := by
  change ‖normalForwardMap (sourceNormalToPunctured v) -
      standardUnlinkNormalCenter 1‖ = _
  exact norm_normalForwardMap_sub_center _ v.2.le

private theorem polarDirection_normalForward (v : SourceNormalExterior) :
    unlinkNormalPolarDirection 1
        (targetNormalToPunctured (normalForward v)) =
      unlinkNormalPolarDirection 1 (sourceNormalToPunctured v) := by
  apply Subtype.ext
  change ‖normalForwardMap (sourceNormalToPunctured v) -
          standardUnlinkNormalCenter 1‖⁻¹ •
        (normalForwardMap (sourceNormalToPunctured v) -
          standardUnlinkNormalCenter 1) = _
  have hs := normalForwardRadius_pos (sourceNormalToPunctured v) v.2.le
  rw [normalForwardMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos hs,
    mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 (sourceNormalToPunctured v)).2,
    mul_one, smul_smul, inv_mul_cancel₀ hs.ne', one_smul]

private theorem polarAngularReal_normalForward (v : SourceNormalExterior) :
    polarAngularReal (targetNormalToPunctured (normalForward v)) =
      polarAngularReal (sourceNormalToPunctured v) := by
  rw [polarAngularReal, polarDirection_normalForward]
  rfl

private theorem normalInverseRadius_pos (v : OneHandleNormalInterior) :
    0 < inverseRadius (polarAngularReal (targetNormalToPunctured v))
      (unlinkNormalPolarRadius 1 (targetNormalToPunctured v)) := by
  let p := targetNormalToPunctured v
  have ha := polarAngularReal_bounds p
  have hs := targetRadius_gt_targetInner v
  rw [inverseRadius]
  exact add_pos_of_pos_of_nonneg (by norm_num : (0 : ℝ) < sourceInnerRadius)
    (div_nonneg (sub_nonneg.mpr hs.le) (raySlope_pos ha.1 ha.2).le)

private theorem polarRadius_normalInverse (v : OneHandleNormalInterior) :
    unlinkNormalPolarRadius 1
        (sourceNormalToPunctured (normalInverse v)) =
      inverseRadius (polarAngularReal (targetNormalToPunctured v))
        (unlinkNormalPolarRadius 1 (targetNormalToPunctured v)) := by
  change ‖normalInverseMap (targetNormalToPunctured v) -
      standardUnlinkNormalCenter 1‖ = _
  rw [normalInverseMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos (normalInverseRadius_pos v),
    mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 (targetNormalToPunctured v)).2,
    mul_one]

private theorem polarDirection_normalInverse (v : OneHandleNormalInterior) :
    unlinkNormalPolarDirection 1
        (sourceNormalToPunctured (normalInverse v)) =
      unlinkNormalPolarDirection 1 (targetNormalToPunctured v) := by
  apply Subtype.ext
  change ‖normalInverseMap (targetNormalToPunctured v) -
          standardUnlinkNormalCenter 1‖⁻¹ •
        (normalInverseMap (targetNormalToPunctured v) -
          standardUnlinkNormalCenter 1) = _
  rw [normalInverseMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos (normalInverseRadius_pos v),
    mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 (targetNormalToPunctured v)).2,
    mul_one, smul_smul,
    inv_mul_cancel₀ (normalInverseRadius_pos v).ne', one_smul]

private theorem polarAngularReal_normalInverse (v : OneHandleNormalInterior) :
    polarAngularReal (sourceNormalToPunctured (normalInverse v)) =
      polarAngularReal (targetNormalToPunctured v) := by
  rw [polarAngularReal, polarDirection_normalInverse]
  rfl

private theorem normalInverse_forward (v : SourceNormalExterior) :
    normalInverse (normalForward v) = v := by
  apply Subtype.ext
  change normalInverseMap (targetNormalToPunctured (normalForward v)) = v.1
  rw [normalInverseMap, polarAngularReal_normalForward,
    polarRadius_normalForward, polarDirection_normalForward]
  have ha := polarAngularReal_bounds (sourceNormalToPunctured v)
  rw [inverseRadius_forwardRadius ha.1 ha.2]
  exact center_add_polar_reconstruction (sourceNormalToPunctured v)

private theorem normalForward_inverse (v : OneHandleNormalInterior) :
    normalForward (normalInverse v) = v := by
  apply Subtype.ext
  change normalForwardMap (sourceNormalToPunctured (normalInverse v)) = v.1
  rw [normalForwardMap, polarAngularReal_normalInverse,
    polarRadius_normalInverse, polarDirection_normalInverse]
  have ha := polarAngularReal_bounds (targetNormalToPunctured v)
  rw [forwardRadius_inverseRadius ha.1 ha.2]
  exact center_add_polar_reconstruction (targetNormalToPunctured v)

/-- Direct smooth radial recognition of the right normal-plane exterior. -/
private def normalDiffeomorph :
    SourceNormalExterior ≃ₘ^∞⟮
      modelWithCornersSelf ℝ UnlinkNormalPlane,
      modelWithCornersSelf ℝ UnlinkNormalPlane⟯ OneHandleNormalInterior where
  toFun := normalForward
  invFun := normalInverse
  left_inv := normalInverse_forward
  right_inv := normalForward_inverse
  contMDiff_toFun := contMDiff_normalForward
  contMDiff_invFun := contMDiff_normalInverse

private theorem isLocalDiffeomorph_normalForward :
    IsLocalDiffeomorph (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ normalForward :=
  normalDiffeomorph.isLocalDiffeomorph

/-! The affine normal map across the radius-`1/8` face. -/

private theorem crossing_forwardRadius_pos
    (v : UnlinkPuncturedNormalPlane 1) :
    0 < forwardRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) := by
  have ha := polarAngularReal_bounds v
  have hA := sourceInnerRadius_lt_targetInnerRayRadius ha.1 ha.2
  have hk0 := raySlope_pos ha.1 ha.2
  have hk1 := raySlope_lt_one ha.1 ha.2
  have hr := unlinkNormalPolarRadius_pos 1 v
  have hsource : 0 < sourceInnerRadius := by norm_num [sourceInnerRadius]
  have hsk : sourceInnerRadius * raySlope (polarAngularReal v) <
      sourceInnerRadius := (mul_lt_iff_lt_one_right hsource).2 hk1
  have hrk : 0 < unlinkNormalPolarRadius 1 v *
      raySlope (polarAngularReal v) := mul_pos hr hk0
  rw [forwardRadius]
  nlinarith

private theorem crossing_norm_normalForwardMap_sub_center
    (v : UnlinkPuncturedNormalPlane 1) :
    ‖normalForwardMap v - standardUnlinkNormalCenter 1‖ =
      forwardRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) := by
  rw [normalForwardMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos (crossing_forwardRadius_pos v),
    mem_sphere_zero_iff_norm.mp (unlinkNormalPolarDirection 1 v).2, mul_one]

private theorem crossing_normalForwardMap_ne_center
    (v : UnlinkPuncturedNormalPlane 1) :
    normalForwardMap v ≠ standardUnlinkNormalCenter 1 := by
  intro h
  have hz : ‖normalForwardMap v - standardUnlinkNormalCenter 1‖ = 0 := by
    rw [h, sub_self, norm_zero]
  rw [crossing_norm_normalForwardMap_sub_center] at hz
  exact (crossing_forwardRadius_pos v).ne' hz

private def crossingNormalTargetOpens : Opens (UnlinkPuncturedNormalPlane 1) :=
  ⟨{v | 0 < inverseRadius (polarAngularReal v)
      (unlinkNormalPolarRadius 1 v)},
    isOpen_lt continuous_const contMDiff_inverseRadius_polar.continuous⟩

private abbrev CrossingNormalTarget := crossingNormalTargetOpens

private def crossingNormalForwardPunctured
    (v : UnlinkPuncturedNormalPlane 1) : UnlinkPuncturedNormalPlane 1 :=
  ⟨normalForwardMap v, crossing_normalForwardMap_ne_center v⟩

private theorem crossing_polarRadius_normalForward
    (v : UnlinkPuncturedNormalPlane 1) :
    unlinkNormalPolarRadius 1 (crossingNormalForwardPunctured v) =
      forwardRadius (polarAngularReal v) (unlinkNormalPolarRadius 1 v) :=
  crossing_norm_normalForwardMap_sub_center v

private theorem crossing_polarDirection_normalForward
    (v : UnlinkPuncturedNormalPlane 1) :
    unlinkNormalPolarDirection 1 (crossingNormalForwardPunctured v) =
      unlinkNormalPolarDirection 1 v := by
  apply Subtype.ext
  change ‖normalForwardMap v - standardUnlinkNormalCenter 1‖⁻¹ •
      (normalForwardMap v - standardUnlinkNormalCenter 1) = _
  rw [normalForwardMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos (crossing_forwardRadius_pos v),
    mem_sphere_zero_iff_norm.mp (unlinkNormalPolarDirection 1 v).2,
    mul_one, smul_smul,
    inv_mul_cancel₀ (crossing_forwardRadius_pos v).ne', one_smul]

private theorem crossing_polarAngularReal_normalForward
    (v : UnlinkPuncturedNormalPlane 1) :
    polarAngularReal (crossingNormalForwardPunctured v) = polarAngularReal v := by
  rw [polarAngularReal, crossing_polarDirection_normalForward]
  rfl

private def crossingNormalForward
    (v : UnlinkPuncturedNormalPlane 1) : CrossingNormalTarget := by
  refine ⟨crossingNormalForwardPunctured v, ?_⟩
  change 0 < inverseRadius
    (polarAngularReal (crossingNormalForwardPunctured v))
    (unlinkNormalPolarRadius 1 (crossingNormalForwardPunctured v))
  rw [crossing_polarAngularReal_normalForward,
    crossing_polarRadius_normalForward]
  have ha := polarAngularReal_bounds v
  rw [inverseRadius_forwardRadius ha.1 ha.2]
  exact unlinkNormalPolarRadius_pos 1 v

private theorem contMDiff_crossingNormalForward :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ crossingNormalForward := by
  apply (ContMDiff.subtypeVal_comp_iff crossingNormalTargetOpens _).mp
  apply (ContMDiff.subtypeVal_comp_iff (unlinkPuncturedNormalPlane 1) _).mp
  exact contMDiff_normalForwardMap

private theorem crossing_normalInverseMap_ne_center
    (v : CrossingNormalTarget) :
    normalInverseMap v.1 ≠ standardUnlinkNormalCenter 1 := by
  intro h
  have hz : ‖normalInverseMap v.1 - standardUnlinkNormalCenter 1‖ = 0 := by
    rw [h, sub_self, norm_zero]
  rw [normalInverseMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos v.2, mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 v.1).2, mul_one] at hz
  exact v.2.ne' hz

private def crossingNormalInverse
    (v : CrossingNormalTarget) : UnlinkPuncturedNormalPlane 1 :=
  ⟨normalInverseMap v.1, crossing_normalInverseMap_ne_center v⟩

private theorem contMDiff_crossingNormalInverse :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ crossingNormalInverse := by
  apply (ContMDiff.subtypeVal_comp_iff (unlinkPuncturedNormalPlane 1) _).mp
  exact contMDiff_normalInverseMap.comp contMDiff_subtype_val

private theorem crossing_polarRadius_normalInverse (v : CrossingNormalTarget) :
    unlinkNormalPolarRadius 1 (crossingNormalInverse v) =
      inverseRadius (polarAngularReal v.1) (unlinkNormalPolarRadius 1 v.1) := by
  change ‖normalInverseMap v.1 - standardUnlinkNormalCenter 1‖ = _
  rw [normalInverseMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos v.2, mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 v.1).2, mul_one]

private theorem crossing_polarDirection_normalInverse (v : CrossingNormalTarget) :
    unlinkNormalPolarDirection 1 (crossingNormalInverse v) =
      unlinkNormalPolarDirection 1 v.1 := by
  apply Subtype.ext
  change ‖normalInverseMap v.1 - standardUnlinkNormalCenter 1‖⁻¹ •
      (normalInverseMap v.1 - standardUnlinkNormalCenter 1) = _
  rw [normalInverseMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos v.2, mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 v.1).2,
    mul_one, smul_smul, inv_mul_cancel₀ v.2.ne', one_smul]

private theorem crossing_polarAngularReal_normalInverse (v : CrossingNormalTarget) :
    polarAngularReal (crossingNormalInverse v) = polarAngularReal v.1 := by
  rw [polarAngularReal, crossing_polarDirection_normalInverse]
  rfl

private theorem crossingNormalInverse_forward (v : UnlinkPuncturedNormalPlane 1) :
    crossingNormalInverse (crossingNormalForward v) = v := by
  apply Subtype.ext
  change normalInverseMap (crossingNormalForwardPunctured v) = v.1
  rw [normalInverseMap, crossing_polarAngularReal_normalForward,
    crossing_polarRadius_normalForward, crossing_polarDirection_normalForward]
  have ha := polarAngularReal_bounds v
  rw [inverseRadius_forwardRadius ha.1 ha.2]
  exact center_add_polar_reconstruction v

private theorem crossingNormalForward_inverse (v : CrossingNormalTarget) :
    crossingNormalForward (crossingNormalInverse v) = v := by
  apply Subtype.ext
  apply Subtype.ext
  change normalForwardMap (crossingNormalInverse v) = v.1.1
  rw [normalForwardMap, crossing_polarAngularReal_normalInverse,
    crossing_polarRadius_normalInverse, crossing_polarDirection_normalInverse]
  have ha := polarAngularReal_bounds v.1
  rw [forwardRadius_inverseRadius ha.1 ha.2]
  exact center_add_polar_reconstruction v.1

private def crossingNormalDiffeomorph :
    UnlinkPuncturedNormalPlane 1 ≃ₘ^∞⟮
      modelWithCornersSelf ℝ UnlinkNormalPlane,
      modelWithCornersSelf ℝ UnlinkNormalPlane⟯ CrossingNormalTarget where
  toFun := crossingNormalForward
  invFun := crossingNormalInverse
  left_inv := crossingNormalInverse_forward
  right_inv := crossingNormalForward_inverse
  contMDiff_toFun := contMDiff_crossingNormalForward
  contMDiff_invFun := contMDiff_crossingNormalInverse

private theorem isLocalDiffeomorph_crossingNormalForward :
    IsLocalDiffeomorph (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ crossingNormalForward :=
  crossingNormalDiffeomorph.isLocalDiffeomorph

/-! ## The direct lift to the four-sphere -/

private theorem unlinkAlignedSplitEquiv_symm_norm_sq
    (v : SphereHandleFirst) (y : SphereHandleSecond) :
    ‖unlinkAlignedSplitEquiv.symm (v, y)‖ ^ 2 = ‖v‖ ^ 2 + ‖y‖ ^ 2 := by
  change ‖unlinkAlignedAmbientEquiv
      (sphereHandleSplitEquiv.symm (v, y))‖ ^ 2 = _
  rw [unlinkAlignedAmbientEquiv.norm_map]
  exact sphereHandleSplitEquiv_symm_norm_sq v y

private theorem unlinkAlignedSplitEquiv_sphere_norm_sq (q : Sphere 4) :
    ‖(unlinkAlignedSplitEquiv q.1).1‖ ^ 2 +
        ‖(unlinkAlignedSplitEquiv q.1).2‖ ^ 2 = 1 := by
  have h := unlinkAlignedSplitEquiv_symm_norm_sq
    (unlinkAlignedSplitEquiv q.1).1 (unlinkAlignedSplitEquiv q.1).2
  rw [show ((unlinkAlignedSplitEquiv q.1).1,
      (unlinkAlignedSplitEquiv q.1).2) = unlinkAlignedSplitEquiv q.1 by rfl,
    unlinkAlignedSplitEquiv.symm_apply_apply,
    mem_sphere_zero_iff_norm.mp q.2] at h
  nlinarith

private theorem contMDiff_tangentialScaleSq_polar :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun v : UnlinkPuncturedNormalPlane 1 ↦
        tangentialScaleSq (polarAngularReal v)
          (unlinkNormalPolarRadius 1 v)) := by
  have hA := contMDiff_polarAngularReal
  have hr := contMDiff_unlinkNormalPolarRadius 1
  have houter := contDiff_outerRayRadius.contMDiff.comp hA
  have hzero : ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun _ : UnlinkPuncturedNormalPlane 1 ↦ (0 : ℝ)) := contMDiff_const
  have hnegative : ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞
      (fun v : UnlinkPuncturedNormalPlane 1 ↦
        outerRayNegativeRoot (polarAngularReal v)) := by
    exact ((hzero.sub hA).sub houter).congr fun v ↦ by
      simp [outerRayNegativeRoot, Function.comp_apply]
  have hforward := contMDiff_forwardRadius_polar
  have hk := contMDiff_raySlope_polar
  have hden := hr.sub hnegative
  have hdenInv := hden.inv₀ fun v ↦ by
    have ha := polarAngularReal_bounds v
    have hnegative' := outerRayNegativeRoot_lt_zero ha.1
    exact sub_ne_zero.mpr
      (hnegative'.trans (unlinkNormalPolarRadius_pos 1 v)).ne'
  exact (hk.smul ((hforward.sub hnegative).smul hdenInv)).congr fun v ↦ by
    simp [tangentialScaleSq, outerRayNegativeRoot, div_eq_mul_inv]
    ring

private def sourceTangentialScale (v : SourceNormalExterior) : ℝ :=
  tangentialScale (polarAngularReal (sourceNormalToPunctured v))
    (unlinkNormalPolarRadius 1 (sourceNormalToPunctured v))

private theorem sourceTangentialScale_pos (v : SourceNormalExterior) :
    0 < sourceTangentialScale v := by
  exact tangentialScale_pos
    (polarAngularReal_bounds (sourceNormalToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalToPunctured v)).2 v.2.le

private theorem contMDiff_sourceTangentialScale :
    ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
      (modelWithCornersSelf ℝ ℝ) ∞ sourceTangentialScale := by
  have hsq := contMDiff_tangentialScaleSq_polar.comp
    contMDiff_sourceNormalToPunctured
  change ContMDiff (modelWithCornersSelf ℝ UnlinkNormalPlane)
    (modelWithCornersSelf ℝ ℝ) ∞
    (fun v : SourceNormalExterior ↦ Real.sqrt
      (tangentialScaleSq (polarAngularReal (sourceNormalToPunctured v))
        (unlinkNormalPolarRadius 1 (sourceNormalToPunctured v))))
  intro v
  have hne := (tangentialScaleSq_pos
    (polarAngularReal_bounds (sourceNormalToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalToPunctured v)).2 v.2.le).ne'
  have hsqrt : ContMDiffAt (modelWithCornersSelf ℝ ℝ)
      (modelWithCornersSelf ℝ ℝ) ∞ Real.sqrt
      (tangentialScaleSq (polarAngularReal (sourceNormalToPunctured v))
        (unlinkNormalPolarRadius 1 (sourceNormalToPunctured v))) :=
    (Real.contDiffAt_sqrt hne).contMDiffAt
  simpa only [Function.comp_def] using
    hsqrt.comp v hsq.contMDiffAt

private theorem norm_sourceNormal_sq
    (v : SourceNormalExterior) :
    ‖v.1‖ ^ 2 =
      unlinkNormalPolarRadius 1 (sourceNormalToPunctured v) ^ 2 +
        polarAngularReal (sourceNormalToPunctured v) *
          unlinkNormalPolarRadius 1 (sourceNormalToPunctured v) + 1 / 4 := by
  let p := sourceNormalToPunctured v
  change ‖p.1‖ ^ 2 = unlinkNormalPolarRadius 1 p ^ 2 +
    polarAngularReal p * unlinkNormalPolarRadius 1 p + 1 / 4
  calc
    ‖p.1‖ ^ 2 = ‖standardUnlinkNormalCenter 1 +
        unlinkNormalPolarRadius 1 p • (unlinkNormalPolarDirection 1 p).1‖ ^ 2 := by
      rw [center_add_polar_reconstruction p]
    _ = unlinkNormalPolarRadius 1 p ^ 2 +
        (unlinkNormalPolarDirection 1 p).1 0 *
          unlinkNormalPolarRadius 1 p + 1 / 4 :=
      norm_center_one_add_ray_sq _ _
    _ = _ := by rfl

private theorem norm_normalForward_sq
    (v : SourceNormalExterior) :
    ‖(normalForward v : OneHandleNormalInterior).1‖ ^ 2 =
      forwardRadius (polarAngularReal (sourceNormalToPunctured v))
          (unlinkNormalPolarRadius 1 (sourceNormalToPunctured v)) ^ 2 +
        polarAngularReal (sourceNormalToPunctured v) *
          forwardRadius (polarAngularReal (sourceNormalToPunctured v))
            (unlinkNormalPolarRadius 1 (sourceNormalToPunctured v)) + 1 / 4 := by
  let p := sourceNormalToPunctured v
  let s := forwardRadius (polarAngularReal p) (unlinkNormalPolarRadius 1 p)
  change ‖normalForwardMap p‖ ^ 2 = _
  rw [show normalForwardMap p = standardUnlinkNormalCenter 1 +
      s • (unlinkNormalPolarDirection 1 p).1 by rfl,
    norm_center_one_add_ray_sq]
  rfl

private theorem sourceTangentialScale_sq_mul_normalDefect
    (v : SourceNormalExterior) :
    sourceTangentialScale v ^ 2 * (1 - ‖v.1‖ ^ 2) =
      1 - ‖(normalForward v : OneHandleNormalInterior).1‖ ^ 2 := by
  have hscale := tangentialScale_sq
    (polarAngularReal_bounds (sourceNormalToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalToPunctured v)).2 v.2.le
  change sourceTangentialScale v ^ 2 = _ at hscale
  rw [hscale, norm_sourceNormal_sq, norm_normalForward_sq]
  exact tangentialScaleSq_mul_source_defect
    (polarAngularReal_bounds (sourceNormalToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalToPunctured v)).2 v.2.le

/-- The literal open complement of the closed right radius-`1/8` tube. -/
private def rightTubeExteriorOpens : Opens (Sphere 4) :=
  ⟨{q | sourceInnerRadius <
      ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖},
    isOpen_lt continuous_const <|
      continuous_norm.comp
        (continuous_standardUnlinkNormalProjection.sub continuous_const)⟩

private abbrev RightTubeExterior := rightTubeExteriorOpens

/-- The aligned open one-handle region, detected directly by its normal block. -/
private def alignedOneHandleInteriorOpens : Opens (Sphere 4) :=
  ⟨{q | sphereHandleRadius < ‖standardUnlinkNormalProjection q‖},
    isOpen_lt continuous_const
      (continuous_norm.comp continuous_standardUnlinkNormalProjection)⟩

private abbrev AlignedOneHandleInterior := alignedOneHandleInteriorOpens

private theorem rightTubeExteriorOpens_eq_compl_closedTube :
    (rightTubeExteriorOpens : Set (Sphere 4)) =
      (standardUnlinkClosedTube 1 sourceInnerRadius)ᶜ := by
  change {q | sourceInnerRadius <
      ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖} = _
  ext q
  change sourceInnerRadius <
      ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ ↔
    ¬ dist (standardUnlinkNormalProjection q)
      (standardUnlinkNormalCenter 1) ≤ sourceInnerRadius
  rw [dist_eq_norm]
  exact not_le.symm

private def rightTubeNormal (q : RightTubeExterior) : SourceNormalExterior :=
  ⟨standardUnlinkNormalProjection q.1, q.2⟩

private def alignedOneHandleNormal
    (q : AlignedOneHandleInterior) : OneHandleNormalInterior :=
  ⟨standardUnlinkNormalProjection q.1, q.2⟩

private theorem contMDiff_rightTubeNormal :
    ContMDiff (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ rightTubeNormal := by
  apply (ContMDiff.subtypeVal_comp_iff sourceNormalExteriorOpens _).mp
  exact contMDiff_standardUnlinkNormalProjection.comp contMDiff_subtype_val

private theorem contMDiff_alignedOneHandleNormal :
    ContMDiff (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ UnlinkNormalPlane) ∞ alignedOneHandleNormal := by
  apply (ContMDiff.subtypeVal_comp_iff oneHandleNormalInteriorOpens _).mp
  exact contMDiff_standardUnlinkNormalProjection.comp contMDiff_subtype_val

private theorem contMDiff_rightTubeTangentialProjection :
    ContMDiff (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ SphereHandleSecond) ∞
      (fun q : RightTubeExterior ↦
        (unlinkAlignedSplitEquiv q.1.1).2) := by
  let : Fact (Module.finrank ℝ SphereHandleAmbient = 4 + 1) := ⟨by simp⟩
  have hsub : ContMDiff
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))) ∞
      (Subtype.val : RightTubeExterior → Sphere 4) := contMDiff_subtype_val
  have hcoeSphere : ContMDiff
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ SphereHandleAmbient) ∞
      (Subtype.val : Sphere 4 → SphereHandleAmbient) :=
    contMDiff_coe_sphere (n := 4)
  have hcoe := hcoeSphere.comp hsub
  have hsplit := unlinkAlignedSplitEquiv.contDiff.comp_contMDiff hcoe
  have hsnd : ContDiff ℝ ∞
      (fun p : SphereHandleFirst × SphereHandleSecond ↦ p.2) := by
    fun_prop
  exact hsnd.comp_contMDiff hsplit

private theorem contMDiff_alignedTangentialProjection :
    ContMDiff (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ SphereHandleSecond) ∞
      (fun q : AlignedOneHandleInterior ↦
        (unlinkAlignedSplitEquiv q.1.1).2) := by
  let : Fact (Module.finrank ℝ SphereHandleAmbient = 4 + 1) := ⟨by simp⟩
  have hsub : ContMDiff
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))) ∞
      (Subtype.val : AlignedOneHandleInterior → Sphere 4) := contMDiff_subtype_val
  have hcoeSphere : ContMDiff
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ SphereHandleAmbient) ∞
      (Subtype.val : Sphere 4 → SphereHandleAmbient) :=
    contMDiff_coe_sphere (n := 4)
  have hcoe := hcoeSphere.comp hsub
  have hsplit := unlinkAlignedSplitEquiv.contDiff.comp_contMDiff hcoe
  have hsnd : ContDiff ℝ ∞
      (fun p : SphereHandleFirst × SphereHandleSecond ↦ p.2) := by
    fun_prop
  exact hsnd.comp_contMDiff hsplit

/-- The ambient formula for the lifted sphere map. -/
private def sphereForwardAmbient (q : RightTubeExterior) : SphereHandleAmbient :=
  unlinkAlignedSplitEquiv.symm
    ((normalForward (rightTubeNormal q)).1,
      sourceTangentialScale (rightTubeNormal q) •
        (unlinkAlignedSplitEquiv q.1.1).2)

private theorem norm_sphereForwardAmbient (q : RightTubeExterior) :
    ‖sphereForwardAmbient q‖ = 1 := by
  let v := rightTubeNormal q
  let c := sourceTangentialScale v
  let y := (unlinkAlignedSplitEquiv q.1.1).2
  have hq := unlinkAlignedSplitEquiv_sphere_norm_sq q.1
  have hcompat := sourceTangentialScale_sq_mul_normalDefect v
  have hc : 0 < c := sourceTangentialScale_pos v
  rw [unlinkAlignedSplitEquiv_fst] at hq
  change ‖v.1‖ ^ 2 + ‖y‖ ^ 2 = 1 at hq
  change c ^ 2 * (1 - ‖v.1‖ ^ 2) =
    1 - ‖(normalForward v : OneHandleNormalInterior).1‖ ^ 2 at hcompat
  have hsq : ‖sphereForwardAmbient q‖ ^ 2 = 1 := by
    rw [sphereForwardAmbient, unlinkAlignedSplitEquiv_symm_norm_sq,
      norm_smul, Real.norm_eq_abs, abs_of_pos hc]
    change ‖(normalForward v : OneHandleNormalInterior).1‖ ^ 2 +
      (c * ‖y‖) ^ 2 = 1
    nlinarith [sq_nonneg c, sq_nonneg ‖y‖]
  nlinarith [norm_nonneg (sphereForwardAmbient q)]

private def sphereForwardSphere (q : RightTubeExterior) : Sphere 4 :=
  ⟨sphereForwardAmbient q,
    mem_sphere_zero_iff_norm.mpr (norm_sphereForwardAmbient q)⟩

@[simp] private theorem unlinkAlignedSplitEquiv_sphereForwardSphere
    (q : RightTubeExterior) :
    unlinkAlignedSplitEquiv (sphereForwardSphere q).1 =
      ((normalForward (rightTubeNormal q)).1,
        sourceTangentialScale (rightTubeNormal q) •
          (unlinkAlignedSplitEquiv q.1.1).2) := by
  exact unlinkAlignedSplitEquiv.apply_symm_apply _

@[simp] private theorem standardUnlinkNormalProjection_sphereForwardSphere
    (q : RightTubeExterior) :
    standardUnlinkNormalProjection (sphereForwardSphere q) =
      (normalForward (rightTubeNormal q)).1 := by
  rw [← unlinkAlignedSplitEquiv_fst,
    unlinkAlignedSplitEquiv_sphereForwardSphere]

private def sphereForward (q : RightTubeExterior) : AlignedOneHandleInterior :=
  ⟨sphereForwardSphere q, by
    change sphereHandleRadius <
      ‖standardUnlinkNormalProjection (sphereForwardSphere q)‖
    rw [standardUnlinkNormalProjection_sphereForwardSphere]
    exact (normalForward (rightTubeNormal q)).2⟩

@[simp] private theorem unlinkAlignedSplitEquiv_sphereForward
    (q : RightTubeExterior) :
    unlinkAlignedSplitEquiv (sphereForward q).1.1 =
      ((normalForward (rightTubeNormal q)).1,
        sourceTangentialScale (rightTubeNormal q) •
          (unlinkAlignedSplitEquiv q.1.1).2) :=
  unlinkAlignedSplitEquiv_sphereForwardSphere q

/-- The lifted map fixes the outer normal circle pointwise. -/
private theorem sphereForward_eq_self_of_normal_norm_eq_one
    (q : RightTubeExterior)
    (hqNormal : ‖standardUnlinkNormalProjection q.1‖ = 1) :
    (sphereForward q).1 = q.1 := by
  apply Subtype.ext
  apply unlinkAlignedSplitEquiv.injective
  rw [unlinkAlignedSplitEquiv_sphereForward]
  have hnormal : (normalForward (rightTubeNormal q)).1 =
      (rightTubeNormal q).1 :=
    normalForward_eq_self_of_norm_eq_one (rightTubeNormal q) hqNormal
  have hsum := unlinkAlignedSplitEquiv_sphere_norm_sq q.1
  rw [unlinkAlignedSplitEquiv_fst, hqNormal] at hsum
  have htangent : (unlinkAlignedSplitEquiv q.1.1).2 = 0 := by
    apply norm_eq_zero.mp
    nlinarith [norm_nonneg (unlinkAlignedSplitEquiv q.1.1).2]
  rw [hnormal, htangent, smul_zero]
  apply Prod.ext
  · exact (unlinkAlignedSplitEquiv_fst q.1).symm
  · exact htangent.symm

private theorem contMDiff_sphereForward :
    ContMDiff (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))) ∞
      sphereForward := by
  have hnormal := contMDiff_subtype_val.comp
    (contMDiff_normalForward.comp contMDiff_rightTubeNormal)
  have hscale := contMDiff_sourceTangentialScale.comp contMDiff_rightTubeNormal
  have htangent := contMDiff_rightTubeTangentialProjection
  have hpair : ContMDiff
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (SphereHandleFirst × SphereHandleSecond)) ∞
      (fun q : RightTubeExterior ↦
        ((normalForward (rightTubeNormal q)).1,
          sourceTangentialScale (rightTubeNormal q) •
            (unlinkAlignedSplitEquiv q.1.1).2)) :=
    (contMDiff_prod_module_iff _).2 ⟨hnormal, hscale.smul htangent⟩
  have hambient := unlinkAlignedSplitEquiv.symm.contDiff.comp_contMDiff hpair
  let : Fact (Module.finrank ℝ SphereHandleAmbient = 4 + 1) := ⟨by simp⟩
  have hsphere := hambient.codRestrict_sphere (n := 4) fun q ↦ by
    rw [mem_sphere_zero_iff_norm]
    exact norm_sphereForwardAmbient q
  apply (ContMDiff.subtypeVal_comp_iff alignedOneHandleInteriorOpens _).mp
  exact hsphere.congr fun _ ↦ rfl

private def sphereInverseSourceNormal
    (q : AlignedOneHandleInterior) : SourceNormalExterior :=
  normalInverse (alignedOneHandleNormal q)

private def sphereInverseAmbient
    (q : AlignedOneHandleInterior) : SphereHandleAmbient :=
  let v := sphereInverseSourceNormal q
  unlinkAlignedSplitEquiv.symm
    (v.1, (sourceTangentialScale v)⁻¹ •
      (unlinkAlignedSplitEquiv q.1.1).2)

private theorem norm_sphereInverseAmbient (q : AlignedOneHandleInterior) :
    ‖sphereInverseAmbient q‖ = 1 := by
  let v' := alignedOneHandleNormal q
  let v := sphereInverseSourceNormal q
  let c := sourceTangentialScale v
  let y := (unlinkAlignedSplitEquiv q.1.1).2
  have hq := unlinkAlignedSplitEquiv_sphere_norm_sq q.1
  rw [unlinkAlignedSplitEquiv_fst] at hq
  change ‖v'.1‖ ^ 2 + ‖y‖ ^ 2 = 1 at hq
  have hcompat := sourceTangentialScale_sq_mul_normalDefect v
  have hvforward : normalForward v = v' := by
    exact normalForward_inverse v'
  rw [hvforward] at hcompat
  change c ^ 2 * (1 - ‖v.1‖ ^ 2) = 1 - ‖v'.1‖ ^ 2 at hcompat
  have hc : 0 < c := sourceTangentialScale_pos v
  have hcinv : c⁻¹ * c = 1 := inv_mul_cancel₀ hc.ne'
  have hscaled : (c⁻¹) ^ 2 * (1 - ‖v'.1‖ ^ 2) =
      1 - ‖v.1‖ ^ 2 := by
    calc
      (c⁻¹) ^ 2 * (1 - ‖v'.1‖ ^ 2) =
          (c⁻¹) ^ 2 * (c ^ 2 * (1 - ‖v.1‖ ^ 2)) := by rw [hcompat]
      _ = (c⁻¹ * c) ^ 2 * (1 - ‖v.1‖ ^ 2) := by ring
      _ = 1 - ‖v.1‖ ^ 2 := by rw [hcinv]; ring
  have hsq : ‖sphereInverseAmbient q‖ ^ 2 = 1 := by
    rw [sphereInverseAmbient, unlinkAlignedSplitEquiv_symm_norm_sq,
      norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hc)]
    change ‖v.1‖ ^ 2 + (c⁻¹ * ‖y‖) ^ 2 = 1
    nlinarith [sq_nonneg (c⁻¹), sq_nonneg ‖y‖]
  nlinarith [norm_nonneg (sphereInverseAmbient q)]

private def sphereInverseSphere (q : AlignedOneHandleInterior) : Sphere 4 :=
  ⟨sphereInverseAmbient q,
    mem_sphere_zero_iff_norm.mpr (norm_sphereInverseAmbient q)⟩

@[simp] private theorem unlinkAlignedSplitEquiv_sphereInverseSphere
    (q : AlignedOneHandleInterior) :
    unlinkAlignedSplitEquiv (sphereInverseSphere q).1 =
      ((sphereInverseSourceNormal q).1,
        (sourceTangentialScale (sphereInverseSourceNormal q))⁻¹ •
          (unlinkAlignedSplitEquiv q.1.1).2) := by
  exact unlinkAlignedSplitEquiv.apply_symm_apply _

@[simp] private theorem standardUnlinkNormalProjection_sphereInverseSphere
    (q : AlignedOneHandleInterior) :
    standardUnlinkNormalProjection (sphereInverseSphere q) =
      (sphereInverseSourceNormal q).1 := by
  rw [← unlinkAlignedSplitEquiv_fst,
    unlinkAlignedSplitEquiv_sphereInverseSphere]

private def sphereInverse (q : AlignedOneHandleInterior) : RightTubeExterior :=
  ⟨sphereInverseSphere q, by
    change sourceInnerRadius <
      ‖standardUnlinkNormalProjection (sphereInverseSphere q) -
        standardUnlinkNormalCenter 1‖
    rw [standardUnlinkNormalProjection_sphereInverseSphere]
    exact (sphereInverseSourceNormal q).2⟩

@[simp] private theorem unlinkAlignedSplitEquiv_sphereInverse
    (q : AlignedOneHandleInterior) :
    unlinkAlignedSplitEquiv (sphereInverse q).1.1 =
      ((sphereInverseSourceNormal q).1,
        (sourceTangentialScale (sphereInverseSourceNormal q))⁻¹ •
          (unlinkAlignedSplitEquiv q.1.1).2) :=
  unlinkAlignedSplitEquiv_sphereInverseSphere q

private theorem contMDiff_sphereInverse :
    ContMDiff (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))) ∞
      sphereInverse := by
  have hsource := contMDiff_normalInverse.comp contMDiff_alignedOneHandleNormal
  have hnormal := contMDiff_subtype_val.comp hsource
  have hscale := contMDiff_sourceTangentialScale.comp hsource
  have hscaleInv := hscale.inv₀ fun q ↦
    (sourceTangentialScale_pos (sphereInverseSourceNormal q)).ne'
  have htangent := contMDiff_alignedTangentialProjection
  have hpair : ContMDiff
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (SphereHandleFirst × SphereHandleSecond)) ∞
      (fun q : AlignedOneHandleInterior ↦
        ((sphereInverseSourceNormal q).1,
          (sourceTangentialScale (sphereInverseSourceNormal q))⁻¹ •
            (unlinkAlignedSplitEquiv q.1.1).2)) :=
    (contMDiff_prod_module_iff _).2 ⟨hnormal, hscaleInv.smul htangent⟩
  have hambient := unlinkAlignedSplitEquiv.symm.contDiff.comp_contMDiff hpair
  let : Fact (Module.finrank ℝ SphereHandleAmbient = 4 + 1) := ⟨by simp⟩
  have hsphere := hambient.codRestrict_sphere (n := 4) fun q ↦ by
    rw [mem_sphere_zero_iff_norm]
    exact norm_sphereInverseAmbient q
  apply (ContMDiff.subtypeVal_comp_iff rightTubeExteriorOpens _).mp
  exact hsphere.congr fun _ ↦ rfl

@[simp] private theorem alignedOneHandleNormal_sphereForward
    (q : RightTubeExterior) :
    alignedOneHandleNormal (sphereForward q) = normalForward (rightTubeNormal q) := by
  apply Subtype.ext
  exact standardUnlinkNormalProjection_sphereForwardSphere q

@[simp] private theorem rightTubeNormal_sphereInverse
    (q : AlignedOneHandleInterior) :
    rightTubeNormal (sphereInverse q) = sphereInverseSourceNormal q := by
  apply Subtype.ext
  exact standardUnlinkNormalProjection_sphereInverseSphere q

private theorem sphereInverse_forward (q : RightTubeExterior) :
    sphereInverse (sphereForward q) = q := by
  apply Subtype.ext
  apply Subtype.ext
  apply unlinkAlignedSplitEquiv.injective
  change unlinkAlignedSplitEquiv (sphereInverseSphere (sphereForward q)).1 =
    unlinkAlignedSplitEquiv q.1.1
  rw [unlinkAlignedSplitEquiv_sphereInverseSphere,
    unlinkAlignedSplitEquiv_sphereForward,
    sphereInverseSourceNormal, alignedOneHandleNormal_sphereForward,
    normalInverse_forward]
  apply Prod.ext
  · exact (unlinkAlignedSplitEquiv_fst q.1).symm
  · have hc := sourceTangentialScale_pos (rightTubeNormal q)
    rw [smul_smul, inv_mul_cancel₀ hc.ne', one_smul]

private theorem sphereForward_inverse (q : AlignedOneHandleInterior) :
    sphereForward (sphereInverse q) = q := by
  apply Subtype.ext
  apply Subtype.ext
  apply unlinkAlignedSplitEquiv.injective
  change unlinkAlignedSplitEquiv (sphereForwardSphere (sphereInverse q)).1 =
    unlinkAlignedSplitEquiv q.1.1
  rw [unlinkAlignedSplitEquiv_sphereForwardSphere,
    unlinkAlignedSplitEquiv_sphereInverse,
    rightTubeNormal_sphereInverse, sphereInverseSourceNormal,
    normalForward_inverse]
  apply Prod.ext
  · exact (unlinkAlignedSplitEquiv_fst q.1).symm
  · have hc := sourceTangentialScale_pos
      (normalInverse (alignedOneHandleNormal q))
    rw [smul_smul, mul_inv_cancel₀ hc.ne', one_smul]

/-- The desired direct smooth recognition of the one-component right-tube exterior as the
aligned open one-handle region. -/
private def sphereDiffeomorph :
    RightTubeExterior ≃ₘ^∞⟮
      modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)),
      modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))⟯
      AlignedOneHandleInterior where
  toFun := sphereForward
  invFun := sphereInverse
  left_inv := sphereInverse_forward
  right_inv := sphereForward_inverse
  contMDiff_toFun := contMDiff_sphereForward
  contMDiff_invFun := contMDiff_sphereInverse

private theorem isLocalDiffeomorph_sphereForward :
    IsLocalDiffeomorph
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))) ∞
      sphereForward :=
  sphereDiffeomorph.isLocalDiffeomorph

/-- The lifted map changes the exact right character by a positive real scalar. -/
private theorem sphereForward_rightCharacter_positiveScalar (q : RightTubeExterior) :
    ∃ c : ℝ, 0 < c ∧
      unlinkNormalPlaneToComplex
          (standardUnlinkNormalProjection (sphereForward q).1 -
            standardUnlinkNormalCenter 1) =
        (c : ℂ) * unlinkNormalPlaneToComplex
          (standardUnlinkNormalProjection q.1 -
            standardUnlinkNormalCenter 1) := by
  rw [show standardUnlinkNormalProjection (sphereForward q).1 =
      (normalForward (rightTubeNormal q)).1 by
    exact standardUnlinkNormalProjection_sphereForwardSphere q]
  exact normalForwardMap_rightCharacter_positiveScalar
    (sourceNormalToPunctured (rightTubeNormal q)) q.2.le

private theorem standardUnlinkRightDisplacementComplex_sphereForward_positiveScalar
    (q : RightTubeExterior) :
    ∃ c : ℝ, 0 < c ∧
      standardUnlinkRightDisplacementComplex (sphereForward q).1 =
        (c : ℂ) * standardUnlinkRightDisplacementComplex q.1 := by
  simpa only [standardUnlinkRightDisplacementComplex] using
    sphereForward_rightCharacter_positiveScalar q

/-! ## Recognition as the literal one-handle interior -/

private theorem sphereHandleSplitEquiv_alignedDiffeomorph_symm
    (q : Sphere 4) :
    sphereHandleSplitEquiv (unlinkAlignedSphereDiffeomorph.symm q).1 =
      unlinkAlignedSplitEquiv q.1 := by
  have heq : unlinkAlignedSphereDiffeomorph.symm q =
      unlinkAlignedSphereHomeomorph.symm q := by
    have h := congrArg (fun e : Sphere 4 ≃ₜ Sphere 4 ↦ e.symm q)
      unlinkAlignedSphereDiffeomorph_toHomeomorph
    exact h
  rw [heq, unlinkAlignedSphereHomeomorph_symm_coe]
  rfl

private theorem unlinkAlignedSplitEquiv_alignedDiffeomorph
    (q : Sphere 4) :
    unlinkAlignedSplitEquiv (unlinkAlignedSphereDiffeomorph q).1 =
      sphereHandleSplitEquiv q.1 := by
  rw [unlinkAlignedSphereDiffeomorph_apply,
    unlinkAlignedSphereHomeomorph_coe,
    unlinkAlignedSplitEquiv_unlinkAlignedAmbientEquiv]

private def alignedToSphereHandleRegion
    (q : AlignedOneHandleInterior) : SphereHandleOneRegion := by
  refine ⟨unlinkAlignedSphereDiffeomorph.symm q.1, ?_⟩
  change ‖sphereHandleSecondProjection
      (unlinkAlignedSphereDiffeomorph.symm q.1)‖ < sphereHandleRadius
  rw [sphereHandleSecondProjection,
    sphereHandleSplitEquiv_alignedDiffeomorph_symm]
  have hsum := unlinkAlignedSplitEquiv_sphere_norm_sq q.1
  rw [unlinkAlignedSplitEquiv_fst] at hsum
  have hn : sphereHandleRadius <
      ‖standardUnlinkNormalProjection q.1‖ := q.2
  nlinarith [sphereHandleRadius_sq, sphereHandleRadius_pos,
    norm_nonneg (standardUnlinkNormalProjection q.1),
    norm_nonneg (unlinkAlignedSplitEquiv q.1.1).2]

private def sphereHandleRegionToAligned
    (q : SphereHandleOneRegion) : AlignedOneHandleInterior := by
  refine ⟨unlinkAlignedSphereDiffeomorph q.1, ?_⟩
  change sphereHandleRadius <
    ‖standardUnlinkNormalProjection (unlinkAlignedSphereDiffeomorph q.1)‖
  rw [← unlinkAlignedSplitEquiv_fst,
    unlinkAlignedSplitEquiv_alignedDiffeomorph]
  have hsum := sphereHandleSplitEquiv_sphere_norm_sq q.1
  have ht : ‖sphereHandleSecondProjection q.1‖ < sphereHandleRadius := q.2
  change ‖(sphereHandleSplitEquiv q.1.1).2‖ < sphereHandleRadius at ht
  nlinarith [sphereHandleRadius_sq, sphereHandleRadius_pos,
    norm_nonneg (sphereHandleSplitEquiv q.1.1).1,
    norm_nonneg (sphereHandleSplitEquiv q.1.1).2]

private theorem alignedToSphereHandleRegion_inverse
    (q : AlignedOneHandleInterior) :
    sphereHandleRegionToAligned (alignedToSphereHandleRegion q) = q := by
  apply Subtype.ext
  exact unlinkAlignedSphereDiffeomorph.apply_symm_apply q.1

private theorem sphereHandleRegionToAligned_inverse
    (q : SphereHandleOneRegion) :
    alignedToSphereHandleRegion (sphereHandleRegionToAligned q) = q := by
  apply Subtype.ext
  exact unlinkAlignedSphereDiffeomorph.symm_apply_apply q.1

private theorem contMDiff_alignedToSphereHandleRegion :
    ContMDiff (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))) ∞
      alignedToSphereHandleRegion := by
  apply (ContMDiff.subtypeVal_comp_iff sphereHandleOneRegion _).mp
  exact unlinkAlignedSphereDiffeomorph.symm.contMDiff.comp contMDiff_subtype_val

private theorem contMDiff_sphereHandleRegionToAligned :
    ContMDiff (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))) ∞
      sphereHandleRegionToAligned := by
  apply (ContMDiff.subtypeVal_comp_iff alignedOneHandleInteriorOpens _).mp
  exact unlinkAlignedSphereDiffeomorph.contMDiff.comp contMDiff_subtype_val

private def alignedSphereHandleRegionDiffeomorph :
    AlignedOneHandleInterior ≃ₘ^∞⟮
      modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)),
      modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4))⟯
      SphereHandleOneRegion where
  toFun := alignedToSphereHandleRegion
  invFun := sphereHandleRegionToAligned
  left_inv := alignedToSphereHandleRegion_inverse
  right_inv := sphereHandleRegionToAligned_inverse
  contMDiff_toFun := contMDiff_alignedToSphereHandleRegion
  contMDiff_invFun := contMDiff_sphereHandleRegionToAligned

/-- Final direct base recognition of the complement of the closed right tube as the model
interior of `OneHandlePiece`. -/
private def rightTubeExteriorOneHandleInteriorDiffeomorph :
    RightTubeExterior ≃ₘ^∞⟮
      modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)),
      oneHandlePieceModel⟯ oneHandlePieceInterior :=
  sphereDiffeomorph.trans <|
    alignedSphereHandleRegionDiffeomorph.trans
      oneHandleInteriorToSphereRegionDiffeomorph.symm

end SplittingSpheres.RightTubeRadialScout

namespace SplittingSpheres.RightTubeRadialScout

/-
/-! ## Closed lift to the four-sphere -/

private def sourceTangentialScaleClosed (v : SourceNormalClosed) : ℝ :=
  tangentialScale (polarAngularReal (sourceNormalClosedToPunctured v))
    (unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v))

private theorem sourceTangentialScaleClosed_pos (v : SourceNormalClosed) :
    0 < sourceTangentialScaleClosed v :=
  tangentialScale_pos
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).2 v.2

private theorem continuous_sourceTangentialScaleClosed :
    Continuous sourceTangentialScaleClosed := by
  have hsq := contMDiff_tangentialScaleSq_polar.continuous.comp
    continuous_sourceNormalClosedToPunctured
  exact Real.continuous_sqrt.comp hsq

private theorem norm_sourceNormalClosed_sq (v : SourceNormalClosed) :
    ‖v.1‖ ^ 2 =
      unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v) ^ 2 +
        polarAngularReal (sourceNormalClosedToPunctured v) *
          unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v) + 1 / 4 := by
  let p := sourceNormalClosedToPunctured v
  change ‖p.1‖ ^ 2 = unlinkNormalPolarRadius 1 p ^ 2 +
    polarAngularReal p * unlinkNormalPolarRadius 1 p + 1 / 4
  calc
    ‖p.1‖ ^ 2 = ‖standardUnlinkNormalCenter 1 +
        unlinkNormalPolarRadius 1 p • (unlinkNormalPolarDirection 1 p).1‖ ^ 2 := by
      rw [center_add_polar_reconstruction p]
    _ = unlinkNormalPolarRadius 1 p ^ 2 +
        (unlinkNormalPolarDirection 1 p).1 0 *
          unlinkNormalPolarRadius 1 p + 1 / 4 :=
      norm_center_one_add_ray_sq _ _
    _ = _ := by rfl

private theorem norm_normalForwardClosed_sq (v : SourceNormalClosed) :
    ‖(normalForwardClosed v : OneHandleNormalClosed).1‖ ^ 2 =
      forwardRadius (polarAngularReal (sourceNormalClosedToPunctured v))
          (unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v)) ^ 2 +
        polarAngularReal (sourceNormalClosedToPunctured v) *
          forwardRadius (polarAngularReal (sourceNormalClosedToPunctured v))
            (unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v)) + 1 / 4 := by
  let p := sourceNormalClosedToPunctured v
  let s := forwardRadius (polarAngularReal p) (unlinkNormalPolarRadius 1 p)
  change ‖normalForwardMap p‖ ^ 2 = _
  rw [show normalForwardMap p = standardUnlinkNormalCenter 1 +
      s • (unlinkNormalPolarDirection 1 p).1 by rfl,
    norm_center_one_add_ray_sq]
  rfl

private theorem sourceTangentialScaleClosed_sq_mul_normalDefect
    (v : SourceNormalClosed) :
    sourceTangentialScaleClosed v ^ 2 * (1 - ‖v.1‖ ^ 2) =
      1 - ‖(normalForwardClosed v : OneHandleNormalClosed).1‖ ^ 2 := by
  have hscale := tangentialScale_sq
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).2 v.2
  change sourceTangentialScaleClosed v ^ 2 = _ at hscale
  rw [hscale, norm_sourceNormalClosed_sq, norm_normalForwardClosed_sq]
  exact tangentialScaleSq_mul_source_defect
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).2 v.2

/-- Closed complement of the open right tube, the compact source carrier. -/
private def rightTubeClosedCarrier : Set (Sphere 4) :=
  {q | sourceInnerRadius ≤
    ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖}

private abbrev RightTubeClosed := CollaredCutSide rightTubeClosedCarrier

/-- Closed aligned one-handle carrier. -/
private def alignedOneHandleClosedCarrier : Set (Sphere 4) :=
  {q | sphereHandleRadius ≤ ‖standardUnlinkNormalProjection q‖}

private abbrev AlignedOneHandleClosed := CollaredCutSide alignedOneHandleClosedCarrier

/-- The radial face of the compact right-tube exterior. -/
private def rightTubeClosedBoundary : Set (Sphere 4) :=
  {q | ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ =
    sourceInnerRadius}

/-- The radial face of the aligned compact one-handle carrier. -/
private def alignedOneHandleClosedBoundary : Set (Sphere 4) :=
  {q | ‖standardUnlinkNormalProjection q‖ = sphereHandleRadius}

private theorem rightTubeClosedCarrier_eq_compl_openTube :
    rightTubeClosedCarrier =
      (standardUnlinkOpenTube 1 sourceInnerRadius)ᶜ := by
  ext q
  change sourceInnerRadius ≤
      ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ ↔
    ¬ dist (standardUnlinkNormalProjection q)
      (standardUnlinkNormalCenter 1) < sourceInnerRadius
  rw [dist_eq_norm]
  exact not_lt.symm

private theorem isClosed_rightTubeClosedCarrier : IsClosed rightTubeClosedCarrier := by
  rw [rightTubeClosedCarrier_eq_compl_openTube]
  exact (isOpen_standardUnlinkOpenTube 1 sourceInnerRadius).isClosed_compl

private theorem isClosed_alignedOneHandleClosedCarrier :
    IsClosed alignedOneHandleClosedCarrier :=
  isClosed_le continuous_const
    (continuous_norm.comp continuous_standardUnlinkNormalProjection)

private def rightTubeClosedNormal (q : RightTubeClosed) : SourceNormalClosed :=
  ⟨standardUnlinkNormalProjection q.1, q.2⟩

private def alignedOneHandleClosedNormal
    (q : AlignedOneHandleClosed) : OneHandleNormalClosed :=
  ⟨standardUnlinkNormalProjection q.1, q.2⟩

private theorem continuous_rightTubeClosedNormal :
    Continuous rightTubeClosedNormal := by
  apply Continuous.subtype_mk
  exact continuous_standardUnlinkNormalProjection.comp continuous_subtype_val

private theorem continuous_alignedOneHandleClosedNormal :
    Continuous alignedOneHandleClosedNormal := by
  apply Continuous.subtype_mk
  exact continuous_standardUnlinkNormalProjection.comp continuous_subtype_val

private theorem continuous_rightTubeClosedTangentialProjection :
    Continuous (fun q : RightTubeClosed ↦
      (unlinkAlignedSplitEquiv q.1.1).2) :=
  continuous_snd.comp <| unlinkAlignedSplitEquiv.continuous.comp <|
    continuous_subtype_val.comp continuous_subtype_val

private theorem continuous_alignedOneHandleClosedTangentialProjection :
    Continuous (fun q : AlignedOneHandleClosed ↦
      (unlinkAlignedSplitEquiv q.1.1).2) :=
  continuous_snd.comp <| unlinkAlignedSplitEquiv.continuous.comp <|
    continuous_subtype_val.comp continuous_subtype_val

private def sphereForwardClosedAmbient (q : RightTubeClosed) : SphereHandleAmbient :=
  unlinkAlignedSplitEquiv.symm
    ((normalForwardClosed (rightTubeClosedNormal q)).1,
      sourceTangentialScaleClosed (rightTubeClosedNormal q) •
        (unlinkAlignedSplitEquiv q.1.1).2)

private theorem norm_sphereForwardClosedAmbient (q : RightTubeClosed) :
    ‖sphereForwardClosedAmbient q‖ = 1 := by
  let v := rightTubeClosedNormal q
  let c := sourceTangentialScaleClosed v
  let y := (unlinkAlignedSplitEquiv q.1.1).2
  have hq := unlinkAlignedSplitEquiv_sphere_norm_sq q.1
  have hcompat := sourceTangentialScaleClosed_sq_mul_normalDefect v
  have hc : 0 < c := sourceTangentialScaleClosed_pos v
  rw [unlinkAlignedSplitEquiv_fst] at hq
  change ‖v.1‖ ^ 2 + ‖y‖ ^ 2 = 1 at hq
  change c ^ 2 * (1 - ‖v.1‖ ^ 2) =
    1 - ‖(normalForwardClosed v : OneHandleNormalClosed).1‖ ^ 2 at hcompat
  have hsq : ‖sphereForwardClosedAmbient q‖ ^ 2 = 1 := by
    rw [sphereForwardClosedAmbient, unlinkAlignedSplitEquiv_symm_norm_sq,
      norm_smul, Real.norm_eq_abs, abs_of_pos hc]
    change ‖(normalForwardClosed v : OneHandleNormalClosed).1‖ ^ 2 +
      (c * ‖y‖) ^ 2 = 1
    nlinarith [sq_nonneg c, sq_nonneg ‖y‖]
  nlinarith [norm_nonneg (sphereForwardClosedAmbient q)]

private def sphereForwardClosedSphere (q : RightTubeClosed) : Sphere 4 :=
  ⟨sphereForwardClosedAmbient q,
    mem_sphere_zero_iff_norm.mpr (norm_sphereForwardClosedAmbient q)⟩

@[simp] private theorem unlinkAlignedSplitEquiv_sphereForwardClosedSphere
    (q : RightTubeClosed) :
    unlinkAlignedSplitEquiv (sphereForwardClosedSphere q).1 =
      ((normalForwardClosed (rightTubeClosedNormal q)).1,
        sourceTangentialScaleClosed (rightTubeClosedNormal q) •
          (unlinkAlignedSplitEquiv q.1.1).2) :=
  unlinkAlignedSplitEquiv.apply_symm_apply _

@[simp] private theorem standardUnlinkNormalProjection_sphereForwardClosedSphere
    (q : RightTubeClosed) :
    standardUnlinkNormalProjection (sphereForwardClosedSphere q) =
      (normalForwardClosed (rightTubeClosedNormal q)).1 := by
  rw [← unlinkAlignedSplitEquiv_fst,
    unlinkAlignedSplitEquiv_sphereForwardClosedSphere]

private def sphereForwardClosed (q : RightTubeClosed) : AlignedOneHandleClosed :=
  ⟨sphereForwardClosedSphere q, by
    change sphereHandleRadius ≤
      ‖standardUnlinkNormalProjection (sphereForwardClosedSphere q)‖
    rw [standardUnlinkNormalProjection_sphereForwardClosedSphere]
    exact (normalForwardClosed (rightTubeClosedNormal q)).2⟩

private theorem continuous_sphereForwardClosed : Continuous sphereForwardClosed := by
  have hnormal := continuous_subtype_val.comp
    (continuous_normalForwardClosed.comp continuous_rightTubeClosedNormal)
  have hscale := continuous_sourceTangentialScaleClosed.comp
    continuous_rightTubeClosedNormal
  have hpair := hnormal.prodMk
    (hscale.smul continuous_rightTubeClosedTangentialProjection)
  have hambient := unlinkAlignedSplitEquiv.symm.continuous.comp hpair
  have hsphere : Continuous sphereForwardClosedSphere :=
    hambient.subtype_mk _
  exact hsphere.subtype_mk _

-/

end SplittingSpheres.RightTubeRadialScout

namespace SplittingSpheres.RightTubeRadialScout

/-! ## Closed-pair extension -/

/-- The closed complement of the open right radius-`1/8` normal disk. -/
private def sourceNormalClosedCarrier : Set UnlinkNormalPlane :=
  {v | sourceInnerRadius ≤ ‖v - standardUnlinkNormalCenter 1‖}

private abbrev SourceNormalClosed := CollaredCutSide sourceNormalClosedCarrier

/-- The closed normal carrier of the aligned compact one-handle. -/
private def oneHandleNormalClosedCarrier : Set UnlinkNormalPlane :=
  {v | sphereHandleRadius ≤ ‖v‖}

private abbrev OneHandleNormalClosed := CollaredCutSide oneHandleNormalClosedCarrier

private theorem sourceNormalClosed_ne_center (v : SourceNormalClosed) :
    v.1 ≠ standardUnlinkNormalCenter 1 := by
  intro h
  have hv : sourceInnerRadius ≤
      ‖v.1 - standardUnlinkNormalCenter 1‖ := v.2
  rw [h, sub_self, norm_zero] at hv
  norm_num [sourceInnerRadius] at hv

private def sourceNormalClosedToPunctured
    (v : SourceNormalClosed) : UnlinkPuncturedNormalPlane 1 :=
  ⟨v.1, sourceNormalClosed_ne_center v⟩

private theorem oneHandleNormalClosed_ne_center (v : OneHandleNormalClosed) :
    v.1 ≠ standardUnlinkNormalCenter 1 := by
  intro h
  have hv : sphereHandleRadius ≤ ‖v.1‖ := v.2
  rw [h, norm_standardUnlinkNormalCenter] at hv
  exact (not_le_of_gt half_lt_sphereHandleRadius) hv

private def oneHandleNormalClosedToPunctured
    (v : OneHandleNormalClosed) : UnlinkPuncturedNormalPlane 1 :=
  ⟨v.1, oneHandleNormalClosed_ne_center v⟩

/-- On a nonnegative ray about the right center, the closed aligned one-handle condition is
equivalent to lying beyond the direction-dependent inner ray. -/
private theorem sphereHandleRadius_le_norm_center_one_add_ray_iff
    (u : Sphere 1) {r : ℝ} (hr : 0 ≤ r) :
    sphereHandleRadius ≤
        ‖standardUnlinkNormalCenter 1 + r • (u.1 : UnlinkNormalPlane)‖ ↔
      targetInnerRayRadius (u.1 0) ≤ r := by
  rw [← sq_le_sq₀ sphereHandleRadius_pos.le (norm_nonneg _),
    sphereHandleRadius_sq, norm_center_one_add_ray_sq]
  let a := u.1 0
  let A := targetInnerRayRadius a
  have hucoord := PiLp.norm_apply_le u.1 0
  rw [mem_sphere_zero_iff_norm.mp u.2] at hucoord
  have ha : -1 ≤ a := by
    have : |a| ≤ 1 := by
      simpa only [a, Real.norm_eq_abs] using hucoord
    exact (abs_le.mp this).1
  have hAadd : 0 < A + a := targetInnerRayRadius_add_arg_pos ha
  have hsecond : 0 < r + A + a := by linarith
  have hfactor :
      r ^ 2 + a * r - 1 / 4 = (r - A) * (r + A + a) := by
    have hAeq : A ^ 2 + a * A = 1 / 4 :=
      targetInnerRayRadius_sq_add_mul a
    nlinarith
  change 1 / 2 ≤ r ^ 2 + a * r + 1 / 4 ↔ A ≤ r
  constructor
  · intro h
    have hprod : 0 ≤ (r - A) * (r + A + a) := by
      rw [← hfactor]
      linarith
    exact sub_nonneg.mp (nonneg_of_mul_nonneg_left hprod hsecond)
  · intro h
    have hprod : 0 ≤ (r - A) * (r + A + a) :=
      mul_nonneg (sub_nonneg.mpr h) hsecond.le
    rw [← hfactor] at hprod
    linarith

private theorem normalForwardMap_mem_oneHandleNormalClosed
    (v : SourceNormalClosed) :
    normalForwardMap (sourceNormalClosedToPunctured v) ∈
      oneHandleNormalClosedCarrier := by
  let p := sourceNormalClosedToPunctured v
  let r := unlinkNormalPolarRadius 1 p
  let a := polarAngularReal p
  let s := forwardRadius a r
  have ha := polarAngularReal_bounds p
  have hr : sourceInnerRadius ≤ r := v.2
  have hs : targetInnerRayRadius a ≤ s := by
    apply sub_nonneg.mp
    change 0 ≤ s - targetInnerRayRadius a
    rw [show s - targetInnerRayRadius a =
      (r - sourceInnerRadius) * raySlope a by
        exact forwardRadius_sub_targetInner a r]
    exact mul_nonneg (sub_nonneg.mpr hr) (raySlope_pos ha.1 ha.2).le
  have hs0 : 0 ≤ s := (targetInnerRayRadius_pos ha.2).le.trans hs
  rw [show normalForwardMap p = standardUnlinkNormalCenter 1 +
      s • (unlinkNormalPolarDirection 1 p).1 by rfl]
  exact (sphereHandleRadius_le_norm_center_one_add_ray_iff
    (unlinkNormalPolarDirection 1 p) hs0).mpr hs

private def normalForwardClosed (v : SourceNormalClosed) : OneHandleNormalClosed :=
  ⟨normalForwardMap (sourceNormalClosedToPunctured v),
    normalForwardMap_mem_oneHandleNormalClosed v⟩

private theorem targetRadius_ge_targetInnerClosed (v : OneHandleNormalClosed) :
    targetInnerRayRadius
        (polarAngularReal (oneHandleNormalClosedToPunctured v)) ≤
      unlinkNormalPolarRadius 1 (oneHandleNormalClosedToPunctured v) := by
  let p := oneHandleNormalClosedToPunctured v
  let r := unlinkNormalPolarRadius 1 p
  have hr : 0 ≤ r := (unlinkNormalPolarRadius_pos 1 p).le
  have hp := center_add_polar_reconstruction p
  have this : sphereHandleRadius ≤ ‖v.1‖ := v.2
  have hpval : p.1 = v.1 := rfl
  rw [← hpval, ← hp] at this
  exact (sphereHandleRadius_le_norm_center_one_add_ray_iff
    (unlinkNormalPolarDirection 1 p) hr).mp this

private theorem normalInverseMap_mem_sourceNormalClosed
    (v : OneHandleNormalClosed) :
    normalInverseMap (oneHandleNormalClosedToPunctured v) ∈
      sourceNormalClosedCarrier := by
  let p := oneHandleNormalClosedToPunctured v
  let s := unlinkNormalPolarRadius 1 p
  let a := polarAngularReal p
  have ha := polarAngularReal_bounds p
  have hs : targetInnerRayRadius a ≤ s := targetRadius_ge_targetInnerClosed v
  have hinv : sourceInnerRadius ≤ inverseRadius a s := by
    rw [inverseRadius]
    exact le_add_of_nonneg_right <| div_nonneg (sub_nonneg.mpr hs)
      (raySlope_pos ha.1 ha.2).le
  have hinv0 : 0 < inverseRadius a s :=
    lt_of_lt_of_le (by norm_num : (0 : ℝ) < sourceInnerRadius) hinv
  change sourceInnerRadius ≤
    ‖normalInverseMap (oneHandleNormalClosedToPunctured v) -
      standardUnlinkNormalCenter 1‖
  rw [normalInverseMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos hinv0,
    mem_sphere_zero_iff_norm.mp (unlinkNormalPolarDirection 1 p).2, mul_one]
  exact hinv

private def normalInverseClosed (v : OneHandleNormalClosed) : SourceNormalClosed :=
  ⟨normalInverseMap (oneHandleNormalClosedToPunctured v),
    normalInverseMap_mem_sourceNormalClosed v⟩

private theorem continuous_sourceNormalClosedToPunctured :
    Continuous sourceNormalClosedToPunctured :=
  continuous_subtype_val.subtype_mk _

private theorem continuous_oneHandleNormalClosedToPunctured :
    Continuous oneHandleNormalClosedToPunctured :=
  continuous_subtype_val.subtype_mk _

private theorem continuous_normalForwardClosed : Continuous normalForwardClosed := by
  apply Continuous.subtype_mk
  exact contMDiff_normalForwardMap.continuous.comp
    continuous_sourceNormalClosedToPunctured

private theorem continuous_normalInverseClosed : Continuous normalInverseClosed := by
  apply Continuous.subtype_mk
  exact contMDiff_normalInverseMap.continuous.comp
    continuous_oneHandleNormalClosedToPunctured

private theorem polarRadius_normalForwardClosed (v : SourceNormalClosed) :
    unlinkNormalPolarRadius 1
        (oneHandleNormalClosedToPunctured (normalForwardClosed v)) =
      forwardRadius (polarAngularReal (sourceNormalClosedToPunctured v))
        (unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v)) := by
  change ‖normalForwardMap (sourceNormalClosedToPunctured v) -
      standardUnlinkNormalCenter 1‖ = _
  exact norm_normalForwardMap_sub_center _ v.2

private theorem polarDirection_normalForwardClosed (v : SourceNormalClosed) :
    unlinkNormalPolarDirection 1
        (oneHandleNormalClosedToPunctured (normalForwardClosed v)) =
      unlinkNormalPolarDirection 1 (sourceNormalClosedToPunctured v) := by
  apply Subtype.ext
  change ‖normalForwardMap (sourceNormalClosedToPunctured v) -
          standardUnlinkNormalCenter 1‖⁻¹ •
        (normalForwardMap (sourceNormalClosedToPunctured v) -
          standardUnlinkNormalCenter 1) = _
  have hs := normalForwardRadius_pos (sourceNormalClosedToPunctured v) v.2
  rw [normalForwardMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos hs,
    mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 (sourceNormalClosedToPunctured v)).2,
    mul_one, smul_smul, inv_mul_cancel₀ hs.ne', one_smul]

private theorem polarAngularReal_normalForwardClosed (v : SourceNormalClosed) :
    polarAngularReal
        (oneHandleNormalClosedToPunctured (normalForwardClosed v)) =
      polarAngularReal (sourceNormalClosedToPunctured v) := by
  rw [polarAngularReal, polarDirection_normalForwardClosed]
  rfl

private theorem normalInverseClosedRadius_pos (v : OneHandleNormalClosed) :
    0 < inverseRadius
      (polarAngularReal (oneHandleNormalClosedToPunctured v))
      (unlinkNormalPolarRadius 1 (oneHandleNormalClosedToPunctured v)) := by
  have hs := targetRadius_ge_targetInnerClosed v
  have ha := polarAngularReal_bounds (oneHandleNormalClosedToPunctured v)
  rw [inverseRadius]
  exact add_pos_of_pos_of_nonneg (by norm_num : (0 : ℝ) < sourceInnerRadius)
    (div_nonneg (sub_nonneg.mpr hs) (raySlope_pos ha.1 ha.2).le)

private theorem polarRadius_normalInverseClosed (v : OneHandleNormalClosed) :
    unlinkNormalPolarRadius 1
        (sourceNormalClosedToPunctured (normalInverseClosed v)) =
      inverseRadius
        (polarAngularReal (oneHandleNormalClosedToPunctured v))
        (unlinkNormalPolarRadius 1 (oneHandleNormalClosedToPunctured v)) := by
  change ‖normalInverseMap (oneHandleNormalClosedToPunctured v) -
      standardUnlinkNormalCenter 1‖ = _
  rw [normalInverseMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos (normalInverseClosedRadius_pos v),
    mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 (oneHandleNormalClosedToPunctured v)).2,
    mul_one]

private theorem polarDirection_normalInverseClosed (v : OneHandleNormalClosed) :
    unlinkNormalPolarDirection 1
        (sourceNormalClosedToPunctured (normalInverseClosed v)) =
      unlinkNormalPolarDirection 1 (oneHandleNormalClosedToPunctured v) := by
  apply Subtype.ext
  change ‖normalInverseMap (oneHandleNormalClosedToPunctured v) -
          standardUnlinkNormalCenter 1‖⁻¹ •
        (normalInverseMap (oneHandleNormalClosedToPunctured v) -
          standardUnlinkNormalCenter 1) = _
  rw [normalInverseMap_sub_center, norm_smul, Real.norm_eq_abs,
    abs_of_pos (normalInverseClosedRadius_pos v),
    mem_sphere_zero_iff_norm.mp
      (unlinkNormalPolarDirection 1 (oneHandleNormalClosedToPunctured v)).2,
    mul_one, smul_smul,
    inv_mul_cancel₀ (normalInverseClosedRadius_pos v).ne', one_smul]

private theorem polarAngularReal_normalInverseClosed (v : OneHandleNormalClosed) :
    polarAngularReal
        (sourceNormalClosedToPunctured (normalInverseClosed v)) =
      polarAngularReal (oneHandleNormalClosedToPunctured v) := by
  rw [polarAngularReal, polarDirection_normalInverseClosed]
  rfl

private theorem normalInverseClosed_forward (v : SourceNormalClosed) :
    normalInverseClosed (normalForwardClosed v) = v := by
  apply Subtype.ext
  change normalInverseMap
      (oneHandleNormalClosedToPunctured (normalForwardClosed v)) = v.1
  rw [normalInverseMap, polarAngularReal_normalForwardClosed,
    polarRadius_normalForwardClosed, polarDirection_normalForwardClosed]
  have ha := polarAngularReal_bounds (sourceNormalClosedToPunctured v)
  rw [inverseRadius_forwardRadius ha.1 ha.2]
  exact center_add_polar_reconstruction (sourceNormalClosedToPunctured v)

private theorem normalForwardClosed_inverse (v : OneHandleNormalClosed) :
    normalForwardClosed (normalInverseClosed v) = v := by
  apply Subtype.ext
  change normalForwardMap
      (sourceNormalClosedToPunctured (normalInverseClosed v)) = v.1
  rw [normalForwardMap, polarAngularReal_normalInverseClosed,
    polarRadius_normalInverseClosed, polarDirection_normalInverseClosed]
  have ha := polarAngularReal_bounds (oneHandleNormalClosedToPunctured v)
  rw [forwardRadius_inverseRadius ha.1 ha.2]
  exact center_add_polar_reconstruction (oneHandleNormalClosedToPunctured v)

/-- The affine ray formula extends to a homeomorphism of the closed normal carriers. -/
private def normalClosedHomeomorph : SourceNormalClosed ≃ₜ OneHandleNormalClosed where
  toFun := normalForwardClosed
  invFun := normalInverseClosed
  left_inv := normalInverseClosed_forward
  right_inv := normalForwardClosed_inverse
  continuous_toFun := continuous_normalForwardClosed
  continuous_invFun := continuous_normalInverseClosed

/-! ## Closed lift to the four-sphere -/

private def sourceTangentialScaleClosed (v : SourceNormalClosed) : ℝ :=
  tangentialScale (polarAngularReal (sourceNormalClosedToPunctured v))
    (unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v))

private theorem sourceTangentialScaleClosed_pos (v : SourceNormalClosed) :
    0 < sourceTangentialScaleClosed v :=
  tangentialScale_pos
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).2 v.2

private theorem continuous_sourceTangentialScaleClosed :
    Continuous sourceTangentialScaleClosed := by
  have hsq := contMDiff_tangentialScaleSq_polar.continuous.comp
    continuous_sourceNormalClosedToPunctured
  exact Real.continuous_sqrt.comp hsq

private theorem norm_sourceNormalClosed_sq (v : SourceNormalClosed) :
    ‖v.1‖ ^ 2 =
      unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v) ^ 2 +
        polarAngularReal (sourceNormalClosedToPunctured v) *
          unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v) + 1 / 4 := by
  let p := sourceNormalClosedToPunctured v
  change ‖p.1‖ ^ 2 = unlinkNormalPolarRadius 1 p ^ 2 +
    polarAngularReal p * unlinkNormalPolarRadius 1 p + 1 / 4
  calc
    ‖p.1‖ ^ 2 = ‖standardUnlinkNormalCenter 1 +
        unlinkNormalPolarRadius 1 p • (unlinkNormalPolarDirection 1 p).1‖ ^ 2 := by
      rw [center_add_polar_reconstruction p]
    _ = unlinkNormalPolarRadius 1 p ^ 2 +
        (unlinkNormalPolarDirection 1 p).1 0 *
          unlinkNormalPolarRadius 1 p + 1 / 4 :=
      norm_center_one_add_ray_sq _ _
    _ = _ := by rfl

private theorem norm_normalForwardClosed_sq (v : SourceNormalClosed) :
    ‖(normalForwardClosed v : OneHandleNormalClosed).1‖ ^ 2 =
      forwardRadius (polarAngularReal (sourceNormalClosedToPunctured v))
          (unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v)) ^ 2 +
        polarAngularReal (sourceNormalClosedToPunctured v) *
          forwardRadius (polarAngularReal (sourceNormalClosedToPunctured v))
            (unlinkNormalPolarRadius 1 (sourceNormalClosedToPunctured v)) + 1 / 4 := by
  let p := sourceNormalClosedToPunctured v
  let s := forwardRadius (polarAngularReal p) (unlinkNormalPolarRadius 1 p)
  change ‖normalForwardMap p‖ ^ 2 = _
  rw [show normalForwardMap p = standardUnlinkNormalCenter 1 +
      s • (unlinkNormalPolarDirection 1 p).1 by rfl,
    norm_center_one_add_ray_sq]
  rfl

private theorem sourceTangentialScaleClosed_sq_mul_normalDefect
    (v : SourceNormalClosed) :
    sourceTangentialScaleClosed v ^ 2 * (1 - ‖v.1‖ ^ 2) =
      1 - ‖(normalForwardClosed v : OneHandleNormalClosed).1‖ ^ 2 := by
  have hscale := tangentialScale_sq
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).2 v.2
  change sourceTangentialScaleClosed v ^ 2 = _ at hscale
  rw [hscale, norm_sourceNormalClosed_sq, norm_normalForwardClosed_sq]
  exact tangentialScaleSq_mul_source_defect
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).1
    (polarAngularReal_bounds (sourceNormalClosedToPunctured v)).2 v.2

/-- Closed complement of the open right tube, the compact source carrier. -/
public def rightTubeClosedCarrier : Set (Sphere 4) :=
  {q | sourceInnerRadius ≤
    ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖}

/-- Internal carrier type used to assemble the exported closed right-tube construction. -/
public abbrev RightTubeClosed := CollaredCutSide rightTubeClosedCarrier

/-- Closed aligned one-handle carrier. -/
private def alignedOneHandleClosedCarrier : Set (Sphere 4) :=
  {q | sphereHandleRadius ≤ ‖standardUnlinkNormalProjection q‖}

private abbrev AlignedOneHandleClosed := CollaredCutSide alignedOneHandleClosedCarrier

/-- The radial face of the compact right-tube exterior. -/
public def rightTubeClosedBoundary : Set (Sphere 4) :=
  {q | ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ =
    sourceInnerRadius}

/-- The radial face of the aligned compact one-handle carrier. -/
private def alignedOneHandleClosedBoundary : Set (Sphere 4) :=
  {q | ‖standardUnlinkNormalProjection q‖ = sphereHandleRadius}

private theorem rightTubeClosedCarrier_eq_compl_openTube :
    rightTubeClosedCarrier =
      (standardUnlinkOpenTube 1 sourceInnerRadius)ᶜ := by
  ext q
  change sourceInnerRadius ≤
      ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ ↔
    ¬ dist (standardUnlinkNormalProjection q)
      (standardUnlinkNormalCenter 1) < sourceInnerRadius
  rw [dist_eq_norm]
  exact not_lt.symm

private theorem isClosed_rightTubeClosedCarrier : IsClosed rightTubeClosedCarrier := by
  rw [rightTubeClosedCarrier_eq_compl_openTube]
  exact (isOpen_standardUnlinkOpenTube 1 sourceInnerRadius).isClosed_compl

private theorem isClosed_alignedOneHandleClosedCarrier :
    IsClosed alignedOneHandleClosedCarrier :=
  isClosed_le continuous_const
    (continuous_norm.comp continuous_standardUnlinkNormalProjection)

private def rightTubeClosedNormal (q : RightTubeClosed) : SourceNormalClosed :=
  ⟨standardUnlinkNormalProjection q.1, q.2⟩

private def alignedOneHandleClosedNormal
    (q : AlignedOneHandleClosed) : OneHandleNormalClosed :=
  ⟨standardUnlinkNormalProjection q.1, q.2⟩

private theorem continuous_rightTubeClosedNormal :
    Continuous rightTubeClosedNormal := by
  apply Continuous.subtype_mk
  exact continuous_standardUnlinkNormalProjection.comp continuous_subtype_val

private theorem continuous_alignedOneHandleClosedNormal :
    Continuous alignedOneHandleClosedNormal := by
  apply Continuous.subtype_mk
  exact continuous_standardUnlinkNormalProjection.comp continuous_subtype_val

private theorem continuous_rightTubeClosedTangentialProjection :
    Continuous (fun q : RightTubeClosed ↦
      (unlinkAlignedSplitEquiv q.1.1).2) :=
  continuous_snd.comp <| unlinkAlignedSplitEquiv.continuous.comp <|
    continuous_subtype_val.comp continuous_subtype_val

private theorem continuous_alignedOneHandleClosedTangentialProjection :
    Continuous (fun q : AlignedOneHandleClosed ↦
      (unlinkAlignedSplitEquiv q.1.1).2) :=
  continuous_snd.comp <| unlinkAlignedSplitEquiv.continuous.comp <|
    continuous_subtype_val.comp continuous_subtype_val

private def sphereForwardClosedAmbient (q : RightTubeClosed) : SphereHandleAmbient :=
  unlinkAlignedSplitEquiv.symm
    ((normalForwardClosed (rightTubeClosedNormal q)).1,
      sourceTangentialScaleClosed (rightTubeClosedNormal q) •
        (unlinkAlignedSplitEquiv q.1.1).2)

private theorem norm_sphereForwardClosedAmbient (q : RightTubeClosed) :
    ‖sphereForwardClosedAmbient q‖ = 1 := by
  let v := rightTubeClosedNormal q
  let c := sourceTangentialScaleClosed v
  let y := (unlinkAlignedSplitEquiv q.1.1).2
  have hq := unlinkAlignedSplitEquiv_sphere_norm_sq q.1
  have hcompat := sourceTangentialScaleClosed_sq_mul_normalDefect v
  have hc : 0 < c := sourceTangentialScaleClosed_pos v
  rw [unlinkAlignedSplitEquiv_fst] at hq
  change ‖v.1‖ ^ 2 + ‖y‖ ^ 2 = 1 at hq
  change c ^ 2 * (1 - ‖v.1‖ ^ 2) =
    1 - ‖(normalForwardClosed v : OneHandleNormalClosed).1‖ ^ 2 at hcompat
  have hsq : ‖sphereForwardClosedAmbient q‖ ^ 2 = 1 := by
    rw [sphereForwardClosedAmbient, unlinkAlignedSplitEquiv_symm_norm_sq,
      norm_smul, Real.norm_eq_abs, abs_of_pos hc]
    change ‖(normalForwardClosed v : OneHandleNormalClosed).1‖ ^ 2 +
      (c * ‖y‖) ^ 2 = 1
    nlinarith [sq_nonneg c, sq_nonneg ‖y‖]
  nlinarith [norm_nonneg (sphereForwardClosedAmbient q)]

private def sphereForwardClosedSphere (q : RightTubeClosed) : Sphere 4 :=
  ⟨sphereForwardClosedAmbient q,
    mem_sphere_zero_iff_norm.mpr (norm_sphereForwardClosedAmbient q)⟩

@[simp] private theorem unlinkAlignedSplitEquiv_sphereForwardClosedSphere
    (q : RightTubeClosed) :
    unlinkAlignedSplitEquiv (sphereForwardClosedSphere q).1 =
      ((normalForwardClosed (rightTubeClosedNormal q)).1,
        sourceTangentialScaleClosed (rightTubeClosedNormal q) •
          (unlinkAlignedSplitEquiv q.1.1).2) :=
  unlinkAlignedSplitEquiv.apply_symm_apply _

@[simp] private theorem standardUnlinkNormalProjection_sphereForwardClosedSphere
    (q : RightTubeClosed) :
    standardUnlinkNormalProjection (sphereForwardClosedSphere q) =
      (normalForwardClosed (rightTubeClosedNormal q)).1 := by
  rw [← unlinkAlignedSplitEquiv_fst,
    unlinkAlignedSplitEquiv_sphereForwardClosedSphere]

private def sphereForwardClosed (q : RightTubeClosed) : AlignedOneHandleClosed :=
  ⟨sphereForwardClosedSphere q, by
    change sphereHandleRadius ≤
      ‖standardUnlinkNormalProjection (sphereForwardClosedSphere q)‖
    rw [standardUnlinkNormalProjection_sphereForwardClosedSphere]
    exact (normalForwardClosed (rightTubeClosedNormal q)).2⟩

private theorem continuous_sphereForwardClosed : Continuous sphereForwardClosed := by
  have hnormal := continuous_subtype_val.comp
    (continuous_normalForwardClosed.comp continuous_rightTubeClosedNormal)
  have hscale := continuous_sourceTangentialScaleClosed.comp
    continuous_rightTubeClosedNormal
  have hpair := hnormal.prodMk
    (hscale.smul continuous_rightTubeClosedTangentialProjection)
  have hambient := unlinkAlignedSplitEquiv.symm.continuous.comp hpair
  have hsphere : Continuous sphereForwardClosedSphere :=
    hambient.subtype_mk _
  exact hsphere.subtype_mk _

private def sphereInverseClosedSourceNormal
    (q : AlignedOneHandleClosed) : SourceNormalClosed :=
  normalInverseClosed (alignedOneHandleClosedNormal q)

private def sphereInverseClosedAmbient
    (q : AlignedOneHandleClosed) : SphereHandleAmbient :=
  let v := sphereInverseClosedSourceNormal q
  unlinkAlignedSplitEquiv.symm
    (v.1, (sourceTangentialScaleClosed v)⁻¹ •
      (unlinkAlignedSplitEquiv q.1.1).2)

private theorem norm_sphereInverseClosedAmbient (q : AlignedOneHandleClosed) :
    ‖sphereInverseClosedAmbient q‖ = 1 := by
  let v' := alignedOneHandleClosedNormal q
  let v := sphereInverseClosedSourceNormal q
  let c := sourceTangentialScaleClosed v
  let y := (unlinkAlignedSplitEquiv q.1.1).2
  have hq := unlinkAlignedSplitEquiv_sphere_norm_sq q.1
  rw [unlinkAlignedSplitEquiv_fst] at hq
  change ‖v'.1‖ ^ 2 + ‖y‖ ^ 2 = 1 at hq
  have hcompat := sourceTangentialScaleClosed_sq_mul_normalDefect v
  have hvforward : normalForwardClosed v = v' :=
    normalForwardClosed_inverse v'
  rw [hvforward] at hcompat
  change c ^ 2 * (1 - ‖v.1‖ ^ 2) = 1 - ‖v'.1‖ ^ 2 at hcompat
  have hc : 0 < c := sourceTangentialScaleClosed_pos v
  have hcinv : c⁻¹ * c = 1 := inv_mul_cancel₀ hc.ne'
  have hscaled : (c⁻¹) ^ 2 * (1 - ‖v'.1‖ ^ 2) =
      1 - ‖v.1‖ ^ 2 := by
    calc
      (c⁻¹) ^ 2 * (1 - ‖v'.1‖ ^ 2) =
          (c⁻¹) ^ 2 * (c ^ 2 * (1 - ‖v.1‖ ^ 2)) := by rw [hcompat]
      _ = (c⁻¹ * c) ^ 2 * (1 - ‖v.1‖ ^ 2) := by ring
      _ = 1 - ‖v.1‖ ^ 2 := by rw [hcinv]; ring
  have hsq : ‖sphereInverseClosedAmbient q‖ ^ 2 = 1 := by
    rw [sphereInverseClosedAmbient, unlinkAlignedSplitEquiv_symm_norm_sq,
      norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hc)]
    change ‖v.1‖ ^ 2 + (c⁻¹ * ‖y‖) ^ 2 = 1
    nlinarith [sq_nonneg (c⁻¹), sq_nonneg ‖y‖]
  nlinarith [norm_nonneg (sphereInverseClosedAmbient q)]

private def sphereInverseClosedSphere (q : AlignedOneHandleClosed) : Sphere 4 :=
  ⟨sphereInverseClosedAmbient q,
    mem_sphere_zero_iff_norm.mpr (norm_sphereInverseClosedAmbient q)⟩

@[simp] private theorem unlinkAlignedSplitEquiv_sphereInverseClosedSphere
    (q : AlignedOneHandleClosed) :
    unlinkAlignedSplitEquiv (sphereInverseClosedSphere q).1 =
      ((sphereInverseClosedSourceNormal q).1,
        (sourceTangentialScaleClosed (sphereInverseClosedSourceNormal q))⁻¹ •
          (unlinkAlignedSplitEquiv q.1.1).2) :=
  unlinkAlignedSplitEquiv.apply_symm_apply _

@[simp] private theorem standardUnlinkNormalProjection_sphereInverseClosedSphere
    (q : AlignedOneHandleClosed) :
    standardUnlinkNormalProjection (sphereInverseClosedSphere q) =
      (sphereInverseClosedSourceNormal q).1 := by
  rw [← unlinkAlignedSplitEquiv_fst,
    unlinkAlignedSplitEquiv_sphereInverseClosedSphere]

private def sphereInverseClosed (q : AlignedOneHandleClosed) : RightTubeClosed :=
  ⟨sphereInverseClosedSphere q, by
    change sourceInnerRadius ≤
      ‖standardUnlinkNormalProjection (sphereInverseClosedSphere q) -
        standardUnlinkNormalCenter 1‖
    rw [standardUnlinkNormalProjection_sphereInverseClosedSphere]
    exact (sphereInverseClosedSourceNormal q).2⟩

private theorem continuous_sphereInverseClosed : Continuous sphereInverseClosed := by
  have hsource := continuous_normalInverseClosed.comp
    continuous_alignedOneHandleClosedNormal
  have hnormal := continuous_subtype_val.comp hsource
  have hscale := continuous_sourceTangentialScaleClosed.comp hsource
  have hscaleInv := hscale.inv₀ fun q ↦
    (sourceTangentialScaleClosed_pos (sphereInverseClosedSourceNormal q)).ne'
  have hpair := hnormal.prodMk
    (hscaleInv.smul continuous_alignedOneHandleClosedTangentialProjection)
  have hambient := unlinkAlignedSplitEquiv.symm.continuous.comp hpair
  have hsphere : Continuous sphereInverseClosedSphere :=
    hambient.subtype_mk _
  exact hsphere.subtype_mk _

@[simp] private theorem alignedOneHandleClosedNormal_sphereForwardClosed
    (q : RightTubeClosed) :
    alignedOneHandleClosedNormal (sphereForwardClosed q) =
      normalForwardClosed (rightTubeClosedNormal q) := by
  apply Subtype.ext
  exact standardUnlinkNormalProjection_sphereForwardClosedSphere q

@[simp] private theorem unlinkAlignedSplitEquiv_sphereForwardClosed
    (q : RightTubeClosed) :
    unlinkAlignedSplitEquiv (sphereForwardClosed q).1.1 =
      ((normalForwardClosed (rightTubeClosedNormal q)).1,
        sourceTangentialScaleClosed (rightTubeClosedNormal q) •
          (unlinkAlignedSplitEquiv q.1.1).2) :=
  unlinkAlignedSplitEquiv_sphereForwardClosedSphere q

@[simp] private theorem standardUnlinkNormalProjection_sphereForwardClosed
    (q : RightTubeClosed) :
    standardUnlinkNormalProjection (sphereForwardClosed q).1 =
      (normalForwardClosed (rightTubeClosedNormal q)).1 :=
  standardUnlinkNormalProjection_sphereForwardClosedSphere q

@[simp] private theorem rightTubeClosedNormal_sphereInverseClosed
    (q : AlignedOneHandleClosed) :
    rightTubeClosedNormal (sphereInverseClosed q) =
      sphereInverseClosedSourceNormal q := by
  apply Subtype.ext
  exact standardUnlinkNormalProjection_sphereInverseClosedSphere q

@[simp] private theorem unlinkAlignedSplitEquiv_sphereInverseClosed
    (q : AlignedOneHandleClosed) :
    unlinkAlignedSplitEquiv (sphereInverseClosed q).1.1 =
      ((sphereInverseClosedSourceNormal q).1,
        (sourceTangentialScaleClosed (sphereInverseClosedSourceNormal q))⁻¹ •
          (unlinkAlignedSplitEquiv q.1.1).2) :=
  unlinkAlignedSplitEquiv_sphereInverseClosedSphere q

private theorem sphereInverseClosed_forward (q : RightTubeClosed) :
    sphereInverseClosed (sphereForwardClosed q) = q := by
  apply Subtype.ext
  apply Subtype.ext
  apply unlinkAlignedSplitEquiv.injective
  change unlinkAlignedSplitEquiv
      (sphereInverseClosedSphere (sphereForwardClosed q)).1 =
    unlinkAlignedSplitEquiv q.1.1
  rw [unlinkAlignedSplitEquiv_sphereInverseClosedSphere,
    unlinkAlignedSplitEquiv_sphereForwardClosed,
    sphereInverseClosedSourceNormal,
    alignedOneHandleClosedNormal_sphereForwardClosed,
    normalInverseClosed_forward]
  apply Prod.ext
  · exact (unlinkAlignedSplitEquiv_fst q.1).symm
  · have hc := sourceTangentialScaleClosed_pos (rightTubeClosedNormal q)
    rw [smul_smul, inv_mul_cancel₀ hc.ne', one_smul]

private theorem sphereForwardClosed_inverse (q : AlignedOneHandleClosed) :
    sphereForwardClosed (sphereInverseClosed q) = q := by
  apply Subtype.ext
  apply Subtype.ext
  apply unlinkAlignedSplitEquiv.injective
  change unlinkAlignedSplitEquiv
      (sphereForwardClosedSphere (sphereInverseClosed q)).1 =
    unlinkAlignedSplitEquiv q.1.1
  rw [unlinkAlignedSplitEquiv_sphereForwardClosedSphere,
    unlinkAlignedSplitEquiv_sphereInverseClosed,
    rightTubeClosedNormal_sphereInverseClosed,
    sphereInverseClosedSourceNormal, normalForwardClosed_inverse]
  apply Prod.ext
  · exact (unlinkAlignedSplitEquiv_fst q.1).symm
  · have hc := sourceTangentialScaleClosed_pos
      (normalInverseClosed (alignedOneHandleClosedNormal q))
    rw [smul_smul, mul_inv_cancel₀ hc.ne', one_smul]

/-- The same affine formula extends to a homeomorphism of the closed four-dimensional
carriers.  No smooth structure is transported through this homeomorphism. -/
private def sphereClosedHomeomorph : RightTubeClosed ≃ₜ AlignedOneHandleClosed where
  toFun := sphereForwardClosed
  invFun := sphereInverseClosed
  left_inv := sphereInverseClosed_forward
  right_inv := sphereForwardClosed_inverse
  continuous_toFun := continuous_sphereForwardClosed
  continuous_invFun := continuous_sphereInverseClosed

/-! ## Closed aligned carrier as the compact one-handle -/

private theorem range_unlinkAlignedOneHandleSphereMap_eq_alignedOneHandleClosedCarrier :
    range unlinkAlignedOneHandleSphereMap = alignedOneHandleClosedCarrier := by
  ext q
  constructor
  · rintro ⟨x, rfl⟩
    change sphereHandleRadius ≤
      ‖standardUnlinkNormalProjection (unlinkAlignedOneHandleSphereMap x)‖
    rw [norm_standardUnlinkNormalProjection_unlinkAlignedOneHandleSphereMap]
    exact sphereHandleRadius_le_scale_on_unit (norm_nonneg _)
      (mem_closedBall_zero_iff.mp x.2.2)
  · intro hq
    let q' := unlinkAlignedSphereDiffeomorph.symm q
    have hsum := sphereHandleSplitEquiv_sphere_norm_sq q'
    have hsplit : sphereHandleSplitEquiv q'.1 = unlinkAlignedSplitEquiv q.1 := by
      exact sphereHandleSplitEquiv_alignedDiffeomorph_symm q
    have hnormal : sphereHandleRadius ≤
        ‖(sphereHandleSplitEquiv q'.1).1‖ := by
      rw [hsplit, unlinkAlignedSplitEquiv_fst]
      exact hq
    have htan : ‖(sphereHandleSplitEquiv q'.1).2‖ ≤
        sphereHandleRadius := by
      by_contra hnot
      have htanlt : sphereHandleRadius <
          ‖(sphereHandleSplitEquiv q'.1).2‖ := lt_of_not_ge hnot
      have hnormalSq : sphereHandleRadius ^ 2 ≤
          ‖(sphereHandleSplitEquiv q'.1).1‖ ^ 2 :=
        (sq_le_sq₀ sphereHandleRadius_pos.le
          (norm_nonneg (sphereHandleSplitEquiv q'.1).1)).2 hnormal
      have htanSq : sphereHandleRadius ^ 2 <
          ‖(sphereHandleSplitEquiv q'.1).2‖ ^ 2 :=
        (sq_lt_sq₀ sphereHandleRadius_pos.le
          (norm_nonneg (sphereHandleSplitEquiv q'.1).2)).2 htanlt
      rw [sphereHandleRadius_sq] at hnormalSq htanSq
      nlinarith
    obtain ⟨x, hx⟩ := exists_oneHandleSphereMap_eq_of_second_norm_le q' htan
    refine ⟨x, ?_⟩
    change unlinkAlignedSphereHomeomorph (oneHandleSphereMap x) = q
    rw [hx]
    have heq : unlinkAlignedSphereDiffeomorph q' =
        unlinkAlignedSphereHomeomorph q' :=
      unlinkAlignedSphereDiffeomorph_apply q'
    rw [← heq]
    exact unlinkAlignedSphereDiffeomorph.apply_symm_apply q

private theorem isClosedEmbedding_unlinkAlignedOneHandleSphereMap :
    IsClosedEmbedding unlinkAlignedOneHandleSphereMap :=
  unlinkAlignedOneHandleSphereMap.continuous.isClosedEmbedding
    unlinkAlignedOneHandleSphereMap_injective

/-- The natural compact one-handle is homeomorphic to the exact closed aligned carrier. -/
private noncomputable def oneHandleAlignedClosedHomeomorph :
    OneHandlePiece ≃ₜ AlignedOneHandleClosed :=
  isClosedEmbedding_unlinkAlignedOneHandleSphereMap.isEmbedding.toHomeomorph.trans <|
    Homeomorph.setCongr
      range_unlinkAlignedOneHandleSphereMap_eq_alignedOneHandleClosedCarrier

@[simp] private theorem oneHandleAlignedClosedHomeomorph_apply_coe
    (x : OneHandlePiece) :
    (oneHandleAlignedClosedHomeomorph x : Sphere 4) =
      unlinkAlignedOneHandleSphereMap x :=
  rfl

/-- Closed point-set recognition all the way to the natural compact one-handle. -/
public noncomputable def rightTubeClosedOneHandleHomeomorph :
    RightTubeClosed ≃ₜ OneHandlePiece :=
  sphereClosedHomeomorph.trans oneHandleAlignedClosedHomeomorph.symm

/-! ## Exact radial-face laws -/

private theorem norm_center_one_add_ray_eq_sphereHandleRadius_iff
    (u : Sphere 1) {r : ℝ} (hr : 0 ≤ r) :
    ‖standardUnlinkNormalCenter 1 + r • (u.1 : UnlinkNormalPlane)‖ =
        sphereHandleRadius ↔
      r = targetInnerRayRadius (u.1 0) := by
  constructor
  · intro h
    have hle := (norm_center_one_add_ray_le_sphereHandleRadius_iff u hr).mp h.le
    have hge := (sphereHandleRadius_le_norm_center_one_add_ray_iff u hr).mp h.ge
    exact le_antisymm hle hge
  · intro h
    apply le_antisymm
    · exact (norm_center_one_add_ray_le_sphereHandleRadius_iff u hr).mpr h.le
    · exact (sphereHandleRadius_le_norm_center_one_add_ray_iff u hr).mpr h.ge

private theorem forwardRadius_eq_targetInner_iff
    {a r : ℝ} (ha₀ : -1 ≤ a) (ha₁ : a ≤ 1) :
    forwardRadius a r = targetInnerRayRadius a ↔ r = sourceInnerRadius := by
  rw [← sub_eq_zero, forwardRadius_sub_targetInner,
    mul_eq_zero, sub_eq_zero]
  exact or_iff_left (raySlope_pos ha₀ ha₁).ne'

private theorem sphereForwardClosed_boundary_iff (q : RightTubeClosed) :
    (sphereForwardClosed q).1 ∈ alignedOneHandleClosedBoundary ↔
      q.1 ∈ rightTubeClosedBoundary := by
  let p := sourceNormalClosedToPunctured (rightTubeClosedNormal q)
  let r := unlinkNormalPolarRadius 1 p
  let a := polarAngularReal p
  let s := forwardRadius a r
  have ha := polarAngularReal_bounds p
  have hs0 : 0 ≤ s :=
    (normalForwardRadius_pos p (rightTubeClosedNormal q).2).le
  change ‖standardUnlinkNormalProjection (sphereForwardClosed q).1‖ =
      sphereHandleRadius ↔
    ‖standardUnlinkNormalProjection q.1 - standardUnlinkNormalCenter 1‖ =
      sourceInnerRadius
  rw [show standardUnlinkNormalProjection (sphereForwardClosed q).1 =
      standardUnlinkNormalCenter 1 +
        s • (unlinkNormalPolarDirection 1 p).1 by
    rw [standardUnlinkNormalProjection_sphereForwardClosed]
    rfl]
  rw [norm_center_one_add_ray_eq_sphereHandleRadius_iff
    (unlinkNormalPolarDirection 1 p) hs0]
  change s = targetInnerRayRadius a ↔ r = sourceInnerRadius
  exact forwardRadius_eq_targetInner_iff ha.1 ha.2

private theorem standardUnlinkRightDisplacementComplex_sphereForwardClosed_positiveScalar
    (q : RightTubeClosed) :
    ∃ c : ℝ, 0 < c ∧
      standardUnlinkRightDisplacementComplex (sphereForwardClosed q).1 =
        (c : ℂ) * standardUnlinkRightDisplacementComplex q.1 := by
  rw [standardUnlinkRightDisplacementComplex,
    standardUnlinkNormalProjection_sphereForwardClosed]
  exact normalForwardMap_rightCharacter_positiveScalar
    (sourceNormalClosedToPunctured (rightTubeClosedNormal q)) q.2

/-! ## The exact direct half-collar for the closed source -/

private abbrev RightTubeClosedCollarDomain :=
  CoordinateUnlinkExteriorEighthCollarDomain

private def rightTubeClosedCollarAmbientMap
    (p : RightTubeClosedCollarDomain) : Sphere 4 :=
  (standardUnlinkExteriorEighthCollarHomeomorph 1 p : Sphere 4)

private theorem range_rightTubeClosedCollarAmbientMap :
    range rightTubeClosedCollarAmbientMap =
      standardUnlinkOpenTube 1 (1 / 4 : ℝ) ∩ rightTubeClosedCarrier := by
  rw [show range rightTubeClosedCollarAmbientMap =
      standardUnlinkExteriorCollarSet 1 (1 / 8 : ℝ) (1 / 4 : ℝ) by
    exact range_standardUnlinkExteriorEighthCollarHomeomorph 1]
  ext q
  rw [mem_standardUnlinkExteriorCollarSet_iff 1 (by norm_num) (by norm_num)]
  change ((1 / 8 : ℝ) ≤
        ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ ∧
      ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ < 1 / 4) ↔
    (dist (standardUnlinkNormalProjection q) (standardUnlinkNormalCenter 1) < 1 / 4 ∧
      (1 / 8 : ℝ) ≤
        ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖)
  rw [dist_eq_norm]
  constructor <;> rintro ⟨h₁, h₂⟩
  · exact ⟨h₂, h₁⟩
  · exact ⟨h₂, h₁⟩

private theorem range_rightTubeClosedCollarAmbientMap_subset :
    range rightTubeClosedCollarAmbientMap ⊆ rightTubeClosedCarrier := by
  rw [range_rightTubeClosedCollarAmbientMap]
  exact inter_subset_right

private def rightTubeClosedHalfCollarMap :
    RightTubeClosedCollarDomain → RightTubeClosed :=
  collaredCutSideHalfCollarMap rightTubeClosedCarrier
    rightTubeClosedCollarAmbientMap
    range_rightTubeClosedCollarAmbientMap_subset

private theorem isEmbedding_rightTubeClosedCollarAmbientMap :
    IsEmbedding rightTubeClosedCollarAmbientMap := by
  exact Topology.IsEmbedding.subtypeVal.comp
    (standardUnlinkExteriorEighthCollarHomeomorph 1).isEmbedding

private theorem isOpenEmbedding_rightTubeClosedHalfCollarMap :
    IsOpenEmbedding rightTubeClosedHalfCollarMap := by
  exact isOpenEmbedding_collaredCutSideHalfCollarMap
    rightTubeClosedCarrier rightTubeClosedCollarAmbientMap
    range_rightTubeClosedCollarAmbientMap_subset
    isEmbedding_rightTubeClosedCollarAmbientMap
    (standardUnlinkOpenTube 1 (1 / 4 : ℝ))
    (isOpen_standardUnlinkOpenTube 1 (1 / 4 : ℝ))
    range_rightTubeClosedCollarAmbientMap

private theorem collaredCutSideOffBoundary_rightTubeClosed :
    collaredCutSideOffBoundary rightTubeClosedCarrier rightTubeClosedBoundary =
      (rightTubeExteriorOpens : Set (Sphere 4)) := by
  ext q
  change (sourceInnerRadius ≤
      ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ ∧
      ¬ ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖ =
        sourceInnerRadius) ↔
    sourceInnerRadius <
      ‖standardUnlinkNormalProjection q - standardUnlinkNormalCenter 1‖
  constructor
  · rintro ⟨hle, hne⟩
    exact lt_of_le_of_ne hle (Ne.symm hne)
  · intro hlt
    exact ⟨hlt.le, hlt.ne'⟩

private theorem isOpen_collaredCutSideOffBoundary_rightTubeClosed :
    IsOpen (collaredCutSideOffBoundary
      rightTubeClosedCarrier rightTubeClosedBoundary) := by
  rw [collaredCutSideOffBoundary_rightTubeClosed]
  exact rightTubeExteriorOpens.2

private theorem rightTubeClosed_offBoundary_or_collar
    (q : RightTubeClosed) :
    q.1 ∈ collaredCutSideOffBoundary
        rightTubeClosedCarrier rightTubeClosedBoundary ∨
      q.1 ∈ range rightTubeClosedCollarAmbientMap := by
  by_cases heq :
      ‖standardUnlinkNormalProjection q.1 - standardUnlinkNormalCenter 1‖ =
        sourceInnerRadius
  · right
    rw [range_rightTubeClosedCollarAmbientMap]
    refine ⟨?_, q.2⟩
    change dist (standardUnlinkNormalProjection q.1)
      (standardUnlinkNormalCenter 1) < (1 / 4 : ℝ)
    rw [dist_eq_norm, heq]
    norm_num [sourceInnerRadius]
  · left
    exact ⟨q.2, heq⟩

@[simp] private theorem rightTubeClosedCollarAmbientMap_normal
    (p : RightTubeClosedCollarDomain) :
    standardUnlinkNormalProjection (rightTubeClosedCollarAmbientMap p) =
      standardUnlinkNormalCenter 1 +
        unlinkExteriorCollarRadiusValue p.2.2 • p.2.1.1 :=
  standardUnlinkNormalProjection_exteriorCollarHomeomorph
    1 (by norm_num) (by norm_num) p

private theorem rightTubeClosedCollarAmbientMap_boundary_mem
    (p : Sphere 2 × Sphere 1) :
    standardUnlinkExteriorCollarBoundaryMap 1
        (r := (1 / 8 : ℝ)) (R := (1 / 4 : ℝ))
        (by norm_num) (by norm_num) p ∈ rightTubeClosedBoundary := by
  change ‖standardUnlinkNormalProjection
      (standardUnlinkExteriorCollarBoundaryMap 1
        (r := (1 / 8 : ℝ)) (R := (1 / 4 : ℝ))
        (by norm_num) (by norm_num) p) - standardUnlinkNormalCenter 1‖ =
      sourceInnerRadius
  rw [standardUnlinkExteriorCollarBoundaryMap,
    standardUnlinkNormalProjection_exteriorCollarHomeomorph,
    unlinkExteriorCollarInnerRadius_value, add_sub_cancel_left,
    norm_smul, Real.norm_eq_abs,
    abs_of_pos (by norm_num : (0 : ℝ) < 1 / 8),
    mem_sphere_zero_iff_norm.mp p.2.2, mul_one]

end SplittingSpheres.RightTubeRadialScout

