        oneHandlePieceModel.boundary OneHandlePiece ↔
      q.1 ∈ coordinateExteriorRightTubeBoundary := by
  let _ := coordinateExteriorRightTubeClosedChartedSpace
  exact RightTubeClosedFinalProbe.rightTubeClosedOneHandleDiffeomorph_boundary_iff q

/-- The right meridian character changes only by a positive real scalar. -/
theorem coordinateExteriorRightTubeOneHandleDiffeomorph_character_positiveScalar
    (q : CoordinateExteriorRightTubeClosed) :
    letI := coordinateExteriorRightTubeClosedChartedSpace
    ∃ c : ℝ, 0 < c ∧
      standardUnlinkRightDisplacementComplex
          (unlinkAlignedOneHandleSphereMap
            (coordinateExteriorRightTubeOneHandleDiffeomorph q)) =
        (c : ℂ) * standardUnlinkRightDisplacementComplex q.1 := by
  let _ := coordinateExteriorRightTubeClosedChartedSpace
  exact
    RightTubeClosedFinalProbe.rightTubeClosedOneHandleDiffeomorph_character_positiveScalar q

/-- On the outer normal circle, the aligned sphere realization is fixed pointwise. -/
theorem coordinateExteriorRightTubeOneHandleDiffeomorph_outerCircle
    (q : CoordinateExteriorRightTubeClosed)
    (hq : ‖standardUnlinkNormalProjection q.1‖ = 1) :
    letI := coordinateExteriorRightTubeClosedChartedSpace
    unlinkAlignedOneHandleSphereMap
        (coordinateExteriorRightTubeOneHandleDiffeomorph q) = q.1 := by
  let _ := coordinateExteriorRightTubeClosedChartedSpace
  exact RightTubeClosedFinalProbe.rightTubeClosedOneHandleDiffeomorph_outerCircle q hq

/-- The model boundary of the direct closed atlas is exactly the radial tube face. -/
theorem coordinateExteriorRightTubeClosed_boundary :
    letI := coordinateExteriorRightTubeClosedChartedSpace
    coordinateUnlinkExteriorModel.boundary
        CoordinateExteriorRightTubeClosed =
      (Subtype.val : CoordinateExteriorRightTubeClosed → Sphere 4) ⁻¹'
        coordinateExteriorRightTubeBoundary := by
  let _ := coordinateExteriorRightTubeClosedChartedSpace
  exact RightTubeClosedFinalProbe.rightTubeClosedOneHandle_boundary

end SplittingSpheres
