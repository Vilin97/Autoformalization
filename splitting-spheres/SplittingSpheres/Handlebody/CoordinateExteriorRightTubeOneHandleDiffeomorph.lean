private theorem rightTubeClosedOneHandleHalfCollar_eq_generic
    (p : RightTubeClosedCollarDomain) :
    rightTubeClosedOneHandleHalfCollar p =
      collaredCutSideHalfCollarMap rightTubeClosedCarrier
        rightTubeClosedOneHandleCollarAmbient
        range_rightTubeClosedOneHandleCollarAmbient_subset p := by
