private def rightTubeExteriorToClosed (q : RightTubeExterior) : RightTubeClosed :=
  ⟨q.1, by
    change sourceInnerRadius ≤
      ‖standardUnlinkNormalProjection q.1 - standardUnlinkNormalCenter 1‖
    exact q.2.le⟩

private def alignedInteriorToClosed
    (q : AlignedOneHandleInterior) : AlignedOneHandleClosed :=
  ⟨q.1, by
    change sphereHandleRadius ≤ ‖standardUnlinkNormalProjection q.1‖
    exact q.2.le⟩

private theorem sphereForwardClosed_restrict (q : RightTubeExterior) :
    sphereForwardClosed (rightTubeExteriorToClosed q) =
      alignedInteriorToClosed (sphereForward q) := by
  apply Subtype.ext
  apply Subtype.ext
  apply unlinkAlignedSplitEquiv.injective
  rw [unlinkAlignedSplitEquiv_sphereForwardClosed]
  change _ = unlinkAlignedSplitEquiv (sphereForward q).1.1
  rw [unlinkAlignedSplitEquiv_sphereForward]
  rfl

private theorem rightTubeClosedOneHandleHomeomorph_restrict
    (q : RightTubeExterior) :
    rightTubeClosedOneHandleHomeomorph (rightTubeExteriorToClosed q) =
      (rightTubeExteriorOneHandleInteriorDiffeomorph q :
        oneHandlePieceInterior).1 := by
  apply oneHandleAlignedClosedHomeomorph.injective
  rw [show oneHandleAlignedClosedHomeomorph
        (rightTubeClosedOneHandleHomeomorph (rightTubeExteriorToClosed q)) =
      sphereClosedHomeomorph (rightTubeExteriorToClosed q) by
    exact oneHandleAlignedClosedHomeomorph.apply_symm_apply _]
  change sphereForwardClosed (rightTubeExteriorToClosed q) = _
  apply Subtype.ext
  rw [sphereForwardClosed_restrict]
  let y : SphereHandleOneRegion :=
    alignedToSphereHandleRegion (sphereForward q)
  have hresult :
      (rightTubeExteriorOneHandleInteriorDiffeomorph q :
        oneHandlePieceInterior) =
        oneHandleInteriorToSphereRegionDiffeomorph.symm y := by
    rfl
  have hone : oneHandleSphereMap
      (rightTubeExteriorOneHandleInteriorDiffeomorph q :
        oneHandlePieceInterior).1 = y.1 := by
    rw [hresult, oneHandleInteriorToSphereRegionDiffeomorph_symm_apply_coe,
      sphereHandleInteriorProductInclusion_apply,
      ← sphereHandleInteriorDiffeomorph_apply_coe]
    exact congrArg Subtype.val
      (sphereHandleInteriorDiffeomorph.apply_symm_apply y)
  change (sphereForward q).1 =
    unlinkAlignedOneHandleSphereMap
      (rightTubeExteriorOneHandleInteriorDiffeomorph q :
        oneHandlePieceInterior).1
  rw [unlinkAlignedOneHandleSphereMap_apply, hone,
    ← unlinkAlignedSphereDiffeomorph_apply]
  exact (unlinkAlignedSphereDiffeomorph.apply_symm_apply _).symm

private theorem unlinkAlignedOneHandleSphereMap_mem_boundary_iff
    (x : OneHandlePiece) :
    unlinkAlignedOneHandleSphereMap x ∈ alignedOneHandleClosedBoundary ↔
      x ∈ oneHandlePieceModel.boundary OneHandlePiece := by
  rw [oneHandlePieceModel_boundary_eq]
  change ‖standardUnlinkNormalProjection
      (unlinkAlignedOneHandleSphereMap x)‖ = sphereHandleRadius ↔
    x.1 ∈ (univ : Set (Sphere 1)) ∧
      x.2.1 ∈ sphere (0 : EuclideanSpace ℝ (Fin 3)) 1
  rw [standardUnlinkNormalProjection_unlinkAlignedOneHandleSphereMap,
    norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (sphereHandleScale_nonneg _),
    mem_sphere_zero_iff_norm.mp x.1.2, mul_one]
  simp only [mem_univ, true_and, mem_sphere_zero_iff_norm]
  have ht0 : 0 ≤ ‖x.2.1‖ := norm_nonneg _
  have ht1 : ‖x.2.1‖ ≤ 1 := mem_closedBall_zero_iff.mp x.2.2
  constructor
  · intro h
    have hsq := congrArg (fun z : ℝ ↦ z ^ 2) h
    rw [sphereHandleScale_sq ht0 ht1, sphereHandleRadius_sq] at hsq
    have : ‖x.2.1‖ ^ 2 = 1 := by
      nlinarith
    nlinarith
  · intro h
    rw [h]
    exact sphereHandleScale_one

private theorem rightTubeClosedOneHandleHomeomorph_boundary_iff
    (q : RightTubeClosed) :
    rightTubeClosedOneHandleHomeomorph q ∈
        oneHandlePieceModel.boundary OneHandlePiece ↔
      q.1 ∈ rightTubeClosedBoundary := by
  rw [← unlinkAlignedOneHandleSphereMap_mem_boundary_iff]
  have hmap : unlinkAlignedOneHandleSphereMap
      (rightTubeClosedOneHandleHomeomorph q) =
      (sphereForwardClosed q).1 := by
    have h := congrArg Subtype.val
      (oneHandleAlignedClosedHomeomorph.apply_symm_apply
        (sphereClosedHomeomorph q))
    exact h
  rw [hmap]
  exact sphereForwardClosed_boundary_iff q

private def oneHandleBoundaryCollarPreimage (x : OneHandlePiece)
    (hx : x ∈ oneHandlePieceModel.boundary OneHandlePiece) :
    RightTubeClosedCollarDomain :=
  (⟨x.2.1, by
      rw [mem_sphere_zero_iff_norm]
      rw [oneHandlePieceModel_boundary_eq] at hx
      exact mem_sphere_zero_iff_norm.mp hx.2⟩,
    (x.1, coordinateUnlinkExteriorEighthCollarInnerRadius))

private theorem oneHandleCollarMap_boundaryPreimage
    (x : OneHandlePiece)
    (hx : x ∈ oneHandlePieceModel.boundary OneHandlePiece) :
    oneHandleCollarMap (oneHandleBoundaryCollarPreimage x hx) = x := by
  apply Prod.ext
  · rfl
  · apply Subtype.ext
    rw [oneHandleCollarMap_snd_val]
    change (9 / 8 - (1 / 8 : ℝ)) • x.2.1 = x.2.1
    rw [show (9 / 8 : ℝ) - 1 / 8 = 1 by norm_num, one_smul]

private theorem rightTubeClosedOneHandle_cover (q : RightTubeClosed) :
    q.1 ∈ collaredCutSideOffBoundary rightTubeClosedCarrier
        rightTubeClosedBoundary ∨
      q.1 ∈ range rightTubeClosedOneHandleCollarAmbient := by
  by_cases hq : q.1 ∈ rightTubeClosedBoundary
  · right
    have hx : rightTubeClosedOneHandleHomeomorph q ∈
        oneHandlePieceModel.boundary OneHandlePiece :=
      (rightTubeClosedOneHandleHomeomorph_boundary_iff q).mpr hq
    let p := oneHandleBoundaryCollarPreimage
      (rightTubeClosedOneHandleHomeomorph q) hx
    refine ⟨p, ?_⟩
    have hcollar : rightTubeClosedOneHandleHalfCollar p = q := by
      apply rightTubeClosedOneHandleHomeomorph.injective
      rw [rightTubeClosedOneHandleCollar_law,
        oneHandleCollarMap_boundaryPreimage]
    exact congrArg Subtype.val hcollar
  · left
    exact ⟨q.2, hq⟩

private theorem oneHandleCollarMap_mem_boundary_iff
    (p : RightTubeClosedCollarDomain) :
    oneHandleCollarMap p ∈ oneHandlePieceModel.boundary OneHandlePiece ↔
      unlinkExteriorCollarRadiusValue p.2.2 = (1 / 8 : ℝ) := by
  rw [oneHandlePieceModel_boundary_eq]
  change p.2.1 ∈ (univ : Set (Sphere 1)) ∧
      (oneHandleCollarMap p).2.1 ∈
        sphere (0 : EuclideanSpace ℝ (Fin 3)) 1 ↔ _
  simp only [mem_univ, true_and, mem_sphere_zero_iff_norm,
    norm_oneHandleCollarMap_snd, oneHandleCollarRadialValue]
  constructor <;> intro h <;> linarith

private theorem rightTubeClosedOneHandleCollarAmbient_mem_boundary_iff
    (p : RightTubeClosedCollarDomain) :
    rightTubeClosedOneHandleCollarAmbient p ∈ rightTubeClosedBoundary ↔
      unlinkExteriorCollarRadiusValue p.2.2 = (1 / 8 : ℝ) := by
  change (rightTubeClosedOneHandleHalfCollar p).1 ∈
      rightTubeClosedBoundary ↔ _
  rw [← oneHandleCollarMap_mem_boundary_iff,
    ← rightTubeClosedOneHandleHomeomorph_boundary_iff
      (rightTubeClosedOneHandleHalfCollar p),
    rightTubeClosedOneHandleCollar_law]

private theorem rightTubeClosedOneHandleCollarAmbient_mem_offBoundary_iff
    (p : RightTubeClosedCollarDomain) :
    rightTubeClosedOneHandleCollarAmbient p ∈
        collaredCutSideOffBoundary rightTubeClosedCarrier
          rightTubeClosedBoundary ↔
      (1 / 8 : ℝ) < unlinkExteriorCollarRadiusValue p.2.2 := by
  change (rightTubeClosedOneHandleCollarAmbient p ∈ rightTubeClosedCarrier ∧
      rightTubeClosedOneHandleCollarAmbient p ∉ rightTubeClosedBoundary) ↔ _
  constructor
  · rintro ⟨_, hp⟩
    have hne : unlinkExteriorCollarRadiusValue p.2.2 ≠ (1 / 8 : ℝ) := by
      intro h
      exact hp
        ((rightTubeClosedOneHandleCollarAmbient_mem_boundary_iff p).mpr h)
    exact lt_of_le_of_ne (unlinkExteriorCollarRadiusValue_lower p.2.2)
      hne.symm
  · intro hp
    refine ⟨(rightTubeClosedOneHandleHalfCollar p).2, ?_⟩
    intro hboundary
    have heq :=
      (rightTubeClosedOneHandleCollarAmbient_mem_boundary_iff p).mp hboundary
    exact hp.ne' heq

private def rightTubeClosedCollarPositiveOpens :
    Opens RightTubeClosedCollarDomain :=
  ⟨{p | (1 / 8 : ℝ) < unlinkExteriorCollarRadiusValue p.2.2},
    isOpen_lt continuous_const
