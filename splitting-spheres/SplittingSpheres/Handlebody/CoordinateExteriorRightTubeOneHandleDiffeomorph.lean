    isLocalDiffeomorph_restrictToOpens coordinateUnlinkExteriorModel
      (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin 4)))
      coordinateUnlinkExteriorCommonModelToStandardSphereIdentityDiffeomorph
      (collaredCutSideOffBoundaryOpens rightTubeClosedCarrier
        rightTubeClosedBoundary
        isOpen_collaredCutSideOffBoundary_rightTubeClosed)
      rightTubeExteriorOpens hSourceMem
